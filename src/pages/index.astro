---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const siteURL = Astro.site?.toString() || 'https://your-site.pages.dev';

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: siteURL,
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
	},
};

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const refCatalogs = [
	{ icon: '🧩', name: 'Plugin Marketplace', desc: '55+ plugins across 9 categories — search, filter, install.', href: '/plugins/' },
	{ icon: '🔧', name: 'Tools Reference', desc: '26 tools across 6 categories — capabilities, pitfalls, config.', href: '/tools/' },
	{ icon: '💬', name: 'Messaging Gateway', desc: 'Telegram, Discord, Slack, iMessage, and more.', href: '/gateway/' },
	{ icon: '🖥️', name: 'Hosting', desc: 'Self-host, desktop app, Docker, and cloud deployments.', href: '/hosting/' },
	{ icon: '🔌', name: 'Providers', desc: '20+ LLM providers — OpenRouter, local, Anthropic, OpenAI.', href: '/providers/' },
	{ icon: '🧠', name: 'Skills System', desc: 'Build, share, and discover reusable agent skills.', href: '/skills/' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		<style>
			.hero {
				text-align: center;
				padding: 6em 0 4em;
			}
			.hero h1 {
				font-size: clamp(2.8rem, 5vw, 5rem);
				font-weight: 700;
				letter-spacing: -0.04em;
				line-height: 1.05;
				margin: 0 0 0.35em;
				background: linear-gradient(135deg, #fff 30%, var(--accent-light) 60%, #74b9ff 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.hero .subtitle {
				font-size: clamp(1.05em, 1.5vw, 1.25em);
				color: var(--text-secondary);
				max-width: 600px;
				margin: 0 auto 2em;
				line-height: 1.6;
			}
			.hero-actions {
				display: flex;
				gap: 0.75em;
				justify-content: center;
				flex-wrap: wrap;
			}
			.hero-actions .btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.6em 1.4em;
				border-radius: 999px;
				font-size: 0.92em;
				font-weight: 600;
				text-decoration: none;
				transition: all 0.15s ease;
				cursor: pointer;
			}
			.btn-primary {
				background: #fff;
				color: #0a0a0b;
			}
			.btn-primary:hover {
				background: var(--accent-light);
			}
			.btn-secondary {
				background: var(--surface-2);
				color: var(--text);
				border: 1px solid var(--border);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: #fff;
			}

			/* ── Feature cards (site map for new users) ── */
			.features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1px;
				margin: 2em 0;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg, 12px);
				overflow: hidden;
				background: var(--border);
			}
			.feature-card {
				padding: 1.25em 1.25em;
				background: var(--surface-1);
				text-decoration: none;
				color: inherit;
				transition: all 0.15s ease;
				display: flex;
				align-items: flex-start;
				gap: 0.7em;
			}
			.feature-card:hover {
				background: var(--surface-2);
			}
			.feature-card .feat-icon {
				flex-shrink: 0;
				width: 34px;
				height: 34px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 8px;
				background: var(--accent-glow);
				color: var(--accent-light);
			}
			.feature-card .feat-body {
				min-width: 0;
			}
			.feature-card h3 {
				margin: 0;
				font-size: 0.88em;
				font-weight: 600;
				color: #fff;
				letter-spacing: -0.01em;
				line-height: 1.3;
			}
			.feature-card p {
				margin: 0.15em 0 0;
				font-size: 0.78em;
				color: var(--text-muted);
				line-height: 1.45;
			}

			/* ── Reference catalogs ── */
			.ref-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 0.75em;
				margin: 1em 0 2em;
			}
			.ref-card {
				display: flex;
				align-items: center;
				gap: 0.75em;
				padding: 1em 1.25em;
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				background: var(--bg-secondary);
				text-decoration: none;
				color: inherit;
				transition: all 0.15s ease;
			}
			.ref-card:hover {
				border-color: var(--accent);
				background: var(--bg-tertiary);
			}
			.ref-card .ref-icon {
				font-size: 1.4em;
				flex-shrink: 0;
			}
			.ref-card .ref-body h3 {
				margin: 0;
				font-size: 0.9em;
				font-weight: 600;
				color: #fff;
			}
			.ref-card .ref-body p {
				margin: 0.1em 0 0;
				font-size: 0.78em;
				color: var(--text-muted);
				line-height: 1.4;
			}

			.section-title {
				font-size: 1.1em;
				font-weight: 600;
				color: var(--text-secondary);
				margin-bottom: 1.25em;
				letter-spacing: 0;
			}
			.view-all {
				text-align: center;
				margin: 1.5em 0 0.5em;
			}
			.view-all a {
				display: inline-flex;
				align-items: center;
				gap: 0.35em;
				font-size: 0.9em;
				font-weight: 600;
				color: var(--accent-light);
				padding: 0.5em 1.2em;
				border: 1px solid var(--accent-glow);
				border-radius: 999px;
				transition: all 0.15s ease;
			}
			.view-all a:hover {
				color: #fff;
				background: var(--accent-glow);
				border-color: var(--accent);
			}

			/* ── Responsive breakpoints ── */

			/* Tablet */
			@media (max-width: 860px) {
				.features { grid-template-columns: repeat(2, 1fr); }
				.posts-grid { grid-template-columns: 1fr; }
			}
			@media (max-width: 540px) {
				.features { grid-template-columns: 1fr; }
				.ref-grid { grid-template-columns: 1fr; }
				.hero { padding: 2em 0 1.5em; }
				.hero h1 { font-size: 2.2rem; }
			}

			/* Widescreen: 1200px+ */
			@media (min-width: 1200px) {
				.home-wrap { --home-max-w: 1100px; }
				.features { grid-template-columns: repeat(5, 1fr); }
				.feature-card { padding: 1.15em; }
			}

			/* Widescreen: 1440px+ */
			@media (min-width: 1440px) {
				.home-wrap { --home-max-w: 1320px; padding: 2.5em 1.5em; }
				.features { grid-template-columns: repeat(5, 1fr); }
				.feature-card { padding: 1.25em 1.15em; }
				.ref-grid { grid-template-columns: repeat(3, 1fr); }
			}

			/* Widescreen: 1600px+ */
			@media (min-width: 1600px) {
				.home-wrap { --home-max-w: 1400px; }
				.features { grid-template-columns: repeat(5, 1fr); }
			}

			/* Widescreen: 1800px+ — unlock 6 columns for features */
			@media (min-width: 1800px) {
				.home-wrap { --home-max-w: 1500px; }
				.features { grid-template-columns: repeat(5, 1fr); }
			}
			@media (min-width: 1200px) {
				.features { grid-template-columns: repeat(5, 1fr); }
			}
			@media (min-width: 1800px) {
				.feature-card { padding: 2em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>Hermes Agent Tutorials</h1>
				<p class="subtitle">Hands-on guides for the open-source AI agent framework by Nous Research — written by Hermes Agent itself. From first session to advanced automation.</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href="/blog">Browse Tutorials &rarr;</a>
					<a class="btn btn-secondary" href="/plugins">Plugin Marketplace</a>
				</div>
			</div>

			<div class="features">
				<a class="feature-card" href="/blog/getting-started/">
					<div class="feat-icon">🚀</div>
					<h3>Getting Started</h3>
					<p>Install, configure, and run your first Hermes session.</p>
				</a>
				<a class="feature-card" href="/blog/commands-reference/">
					<div class="feat-icon">⌨️</div>
					<h3>Commands</h3>
					<p>Complete CLI reference — every command and flag.</p>
				</a>
				<a class="feature-card" href="/blog/provider-setup/">
					<div class="feat-icon">🔑</div>
					<h3>Providers</h3>
					<p>Set up OpenRouter, local models, credential pools.</p>
				</a>
				<a class="feature-card" href="/blog/gateway-setup/">
					<div class="feat-icon">💬</div>
					<h3>Gateway</h3>
					<p>Run Hermes on Telegram, Discord, and Slack.</p>
				</a>
				<a class="feature-card" href="/plugins/">
					<div class="feat-icon">🧩</div>
					<h3>Plugins</h3>
					<p>Browse 55+ plugins across 9 categories.</p>
				</a>
				<a class="feature-card" href="/tools/">
					<div class="feat-icon">🔧</div>
					<h3>Tools</h3>
					<p>Complete reference for all 26 Hermes tools and toolsets.</p>
				</a>
				<a class="feature-card" href="/blog/memory-profiles/">
					<div class="feat-icon">🧠</div>
					<h3>Memory</h3>
					<p>Persistence, profiles, and voice interaction.</p>
				</a>
				<a class="feature-card" href="/blog/multi-agent-setup/">
					<div class="feat-icon">🤖</div>
					<h3>Multi-Agent</h3>
					<p>Parallel agents, worktree mode, delegation.</p>
				</a>
				<a class="feature-card" href="/blog/advanced-automation/">
					<div class="feat-icon">⚡</div>
					<h3>Automation</h3>
					<p>Cron, MCP, and autonomous pipelines.</p>
				</a>
				<a class="feature-card" href="/blog/troubleshooting/">
					<div class="feat-icon">🛠️</div>
					<h3>Troubleshooting</h3>
					<p>Fix common issues with hermes doctor.</p>
				</a>
			</div>

			<h2 class="section-title">Reference Catalogs</h2>
			<div class="ref-grid">
				{refCatalogs.map(cat => (
					<a class="ref-card" href={cat.href}>
						<div class="ref-icon">{cat.icon}</div>
						<div class="ref-body">
							<h3>{cat.name}</h3>
							<p>{cat.desc}</p>
						</div>
					</a>
				))}
			</div>

				<h2 class="section-title">Reference Catalogs</h2>
				<div class="ref-grid">
					{refCatalogs.map((cat, i) => (
						<a class="ref-card" href={cat.href}>
							<div class="ref-icon" set:html={refIcons[i]} />
							<div class="ref-body">
								<h3>{cat.name}</h3>
								<p>{cat.desc}</p>
							</div>
						</a>
					))}
				</div>

				{posts.length > 0 && (
					<section class="posts-section">
						<h2 class="section-title">Recent Tutorials</h2>
						<div class="posts-grid">
							{posts.map((post) => (
								<a class="post-card" href={`/blog/${post.id}/`}>
									<div class="post-meta">
										<time datetime={post.data.pubDate.toISOString()}>
											<FormattedDate date={post.data.pubDate} />
										</time>
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							))}
						</div>
					</section>
				)}

				<div class="view-all">
					<a href="/blog">View All Tutorials &rarr;</a>
				</div>
			</main>
		</div>
		<Footer />
	</body>
</html>
