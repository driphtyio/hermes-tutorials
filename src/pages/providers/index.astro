---
import Reference from '../../layouts/Reference.astro';
import { providers, providerCategories } from '../../data/providers';

const isFree = (tier: string) => tier.toLowerCase().includes('yes');

const categories = providerCategories.filter((c) => providers.some((p) => p.category === c.id));

const labelFor = (id: string) => {
  const meta = providerCategories.find((c) => c.id === id);
  return meta ? `${meta.icon} ${meta.label}` : id;
};

const badgeLabel = (id: string) =>
  id === 'api' ? 'API' : id === 'local' ? 'Local' : id === 'oauth' ? 'OAuth' : id;

const stats = [
  { label: 'Total Providers', value: providers.length },
  { label: 'Free Tier Available', value: providers.filter((p) => isFree(p.freeTier)).length },
  { label: 'Top Rated ★4+', value: providers.filter((p) => p.rating >= 4).length },
  { label: 'Local / Free', value: providers.filter((p) => p.category === 'local').length },
];

const description = `${providers.length} LLM providers for Hermes Agent — API services, local inference, and OAuth platforms. Reviews, pricing, models, and setup guides.`;
---

<Reference
  title="Providers"
  description={description}
  categories={categories}
  stats={stats}
  count={providers.length}
  searchPlaceholder="Search providers…"
>
  {providers.map((p) => (
    <article
      class="card"
      data-card
      data-category={p.category}
      data-name={p.name.toLowerCase()}
      data-desc={p.description.toLowerCase()}
    >
      <div class="category-label">{labelFor(p.category)}</div>
      <div class="card-head">
        <h3>{p.name}</h3>
        <span class="badge badge-accent">{badgeLabel(p.category)}</span>
      </div>
      {p.rating > 0 && <div class="rating">{'★'.repeat(p.rating)}{'☆'.repeat(5 - p.rating)}</div>}
      <p>{p.description}</p>
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">Models</span>{p.models}
        </div>
        <div class="info-item">
          <span class="info-label">Pricing</span>{p.pricing}
        </div>
        <div class="info-item full">
          <span class="info-label">Best for</span>{p.bestFor}
        </div>
        <div class="info-item full">
          <span class="info-label">Free tier</span>
          {isFree(p.freeTier) ? <span class="badge badge-free">✅ Free tier</span> : <span>{p.freeTier}</span>}
        </div>
        {p.configVars.length > 0 && (
          <div class="info-item full">
            <span class="info-label">Config vars</span>{p.configVars.join(', ')}
          </div>
        )}
      </div>
      <div class="proscons">
        <div class="proscons-col">
          <span class="proscons-title pros-title">Pros</span>
          <ul>{p.pros.map((pr) => <li>{pr}</li>)}</ul>
        </div>
        <div class="proscons-col">
          <span class="proscons-title cons-title">Cons</span>
          <ul>{p.cons.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
      <div class="build-block">
        <span class="section-label">Setup guide</span>
        {p.setupGuide}
      </div>
    </article>
  ))}
</Reference>
