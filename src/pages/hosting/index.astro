---
import Reference from '../../layouts/Reference.astro';
import { hosting, hostingCategories } from '../../data/hosting';

const categories = hostingCategories.filter((c) => hosting.some((h) => h.category === c.id));

const labelFor = (id: string) => {
  const meta = hostingCategories.find((c) => c.id === id);
  return meta ? `${meta.icon} ${meta.label}` : id;
};

const stats = [
  { label: 'Total Options', value: hosting.length },
  { label: 'VPS', value: hosting.filter((h) => h.category === 'vps').length },
  { label: 'Self-Hosted', value: hosting.filter((h) => h.category === 'selfhosted').length },
  { label: 'Free Options', value: hosting.filter((h) => h.category === 'free').length },
];

const description = `${hosting.length} ways to host Hermes Agent — VPS, self-hosted hardware, free tiers, and serverless. Reviews, specs, prices, and setup guides for every budget.`;
---

<Reference
  title="Hosting"
  description={description}
  categories={categories}
  stats={stats}
  count={hosting.length}
  searchPlaceholder="Search hosting options…"
>
  {hosting.map((h) => (
    <article
      class="card"
      data-card
      data-category={h.category}
      data-name={h.name.toLowerCase()}
      data-desc={h.description.toLowerCase()}
    >
      <div class="category-label">{labelFor(h.category)}</div>
      <div class="card-head">
        <h3>{h.name}</h3>
        <span class="badge badge-neutral">{h.type}</span>
      </div>
      <div class="badge-group">
        {h.rating >= 5 && <span class="badge badge-recommended">★ Recommended</span>}
      </div>
      {h.rating > 0 && <div class="rating">{'★'.repeat(h.rating)}{'☆'.repeat(5 - h.rating)}</div>}
      <div class="price-row">
        <span class="price">{h.price}</span>
        <span class="price-unit">{h.priceUnit}</span>
      </div>
      <p>{h.description}</p>
      <div class="spec-line"><strong>Specs:</strong> {h.specs}</div>
      <div class="best-for">🎯 <strong>Best for:</strong> {h.recommendedFor}</div>
      <div class="proscons">
        <div class="proscons-col">
          <span class="proscons-title pros-title">Pros</span>
          <ul>{h.pros.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="proscons-col">
          <span class="proscons-title cons-title">Cons</span>
          <ul>{h.cons.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
      <div class="build-block">
        <span class="section-label">Setup guide</span>
        {h.setupGuide}
      </div>
      <div class="code-line">{h.hermesInstall}</div>
      {h.affiliateUrl && (
        <div class="affiliate-block">
          <span class="affiliate-disclosure">We earn commissions when you shop through the links below.</span>
          <a class="affiliate-cta" href={h.affiliateUrl} target="_blank" rel="sponsored noopener">
            View plans at {h.name.split(' ')[0]} →
          </a>
        </div>
      )}
    </article>
  ))}
</Reference>
