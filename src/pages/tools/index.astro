---
import Reference from '../../layouts/Reference.astro';
import { tools, toolCategories } from '../../data/tools';

const categories = toolCategories.filter((c) => tools.some((t) => t.category === c.id));

const labelFor = (id: string) => {
  const meta = toolCategories.find((c) => c.id === id);
  return meta ? `${meta.icon} ${meta.label}` : id;
};

const defaultOn = tools.filter((t) => t.defaultEnabled).length;

const stats = [
  { label: 'Total Tools', value: tools.length },
  { label: 'Categories', value: categories.length },
  { label: 'Default On', value: defaultOn },
  { label: 'Top Rated ★4+', value: tools.filter((t) => t.rating >= 4).length },
];

const description = `Every Hermes Agent tool across ${categories.length} categories — ${defaultOn} enabled by default, ${tools.length - defaultOn} opt-in. Ratings, requirements, capabilities, and pitfalls.`;
---

<Reference
  title="Tools Reference"
  description={description}
  categories={categories}
  stats={stats}
  count={tools.length}
  searchPlaceholder="Search tools…"
>
  {tools.map((t) => (
    <article
      class="card"
      data-card
      data-category={t.category}
      data-name={t.name.toLowerCase()}
      data-desc={t.description.toLowerCase()}
    >
      <div class="category-label">{labelFor(t.category)}</div>
      <div class="card-head">
        <h3>{t.name}</h3>
        {t.defaultEnabled
          ? <span class="badge badge-on">Default On</span>
          : <span class="badge badge-off">Opt-in</span>
        }
      </div>
      {t.rating > 0 && <div class="rating">{'★'.repeat(t.rating)}{'☆'.repeat(5 - t.rating)}</div>}
      <p>{t.description}</p>
      {t.capabilities.length > 0 && (
        <div class="chip-row">
          {t.capabilities.map((c) => <span class="chip">{c}</span>)}
        </div>
      )}
      {t.requiresEnv.length > 0 && (
        <div class="details-line"><strong>Requires:</strong> {t.requiresEnv.join(', ')}</div>
      )}
      {t.pitfalls && <div class="pitfall">{t.pitfalls}</div>}
    </article>
  ))}
</Reference>
