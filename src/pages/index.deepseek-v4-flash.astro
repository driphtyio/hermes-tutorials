---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const siteURL = Astro.site?.toString() || 'https://your-site.pages.dev';

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: siteURL,
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
	},
};

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

// ── Minimal inline SVG icons (stroke-based, 20×20, accent-colored) ──
const icon = (d) =>
	`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

const featureIcons = [
	icon('<polygon points="6 3 20 12 6 21 6 3"/>'),
	icon('<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>'),
	icon('<path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>'),
	icon('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>'),
	icon('<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>'),
	icon('<circle cx="12" cy="12" r="3"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>'),
	icon('<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>'),
	icon('<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>'),
	icon('<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>'),
	icon('<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>'),
];

const refIcon = (d) =>
	`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

const refIcons = [
	refIcon('<path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>'),
	refIcon('<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="12" y1="8" x2="16" y2="8"/><line x1="12" y1="12" x2="16" y2="12"/>'),
	refIcon('<line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>'),
	refIcon('<rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/>'),
	refIcon('<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>'),
	refIcon('<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>'),
];

// ── Feature cards data ──
const features = [
	{ label: 'Getting Started', desc: 'Install, configure, and run your first Hermes session.', href: '/blog/getting-started/' },
	{ label: 'Commands', desc: 'Complete CLI reference — every command and flag.', href: '/blog/commands-reference/' },
	{ label: 'Providers', desc: 'Set up OpenRouter, local models, credential pools.', href: '/blog/provider-setup/' },
	{ label: 'Gateway', desc: 'Run Hermes on Telegram, Discord, and Slack.', href: '/blog/gateway-setup/' },
	{ label: 'Plugins', desc: 'Browse 55+ plugins across 9 categories.', href: '/plugins/' },
	{ label: 'Tools', desc: 'Complete reference for all 26 Hermes tools.', href: '/tools/' },
	{ label: 'Memory', desc: 'Persistence, profiles, and voice interaction.', href: '/blog/memory-profiles/' },
	{ label: 'Multi-Agent', desc: 'Parallel agents, worktree mode, delegation.', href: '/blog/multi-agent-setup/' },
	{ label: 'Automation', desc: 'Cron, MCP, and autonomous pipelines.', href: '/blog/advanced-automation/' },
	{ label: 'Troubleshooting', desc: 'Fix common issues with hermes doctor.', href: '/blog/troubleshooting/' },
];

// ── Reference catalogs data (no emoji ── using SVG icons in template) ──
const refCatalogs = [
	{ name: 'Plugin Marketplace', desc: '55+ plugins across 9 categories — search, filter, install.', href: '/plugins/' },
	{ name: 'Tools Reference', desc: '26 tools across 6 categories — capabilities, pitfalls, config.', href: '/tools/' },
	{ name: 'Messaging Gateway', desc: 'Telegram, Discord, Slack, iMessage, and more.', href: '/gateway/' },
	{ name: 'Hosting', desc: 'Self-host, desktop app, Docker, and cloud deployments.', href: '/hosting/' },
	{ name: 'Providers', desc: '20+ LLM providers — OpenRouter, local, Anthropic, OpenAI.', href: '/providers/' },
	{ name: 'Skills System', desc: 'Build, share, and discover reusable agent skills.', href: '/skills/' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		<style>
			/* ── Widescreen container scaling ── */
			.home-wrap {
				width: min(calc(100% - 2rem), var(--home-max-w, 860px));
				margin: 0 auto;
				padding: 2em 1em;
			}
			.home-wrap main {
				all: unset;
				display: block;
			}

			/* ── Hero ── */
			.hero {
				text-align: center;
				padding: 3em 0 2.5em;
			}
			.hero h1 {
				font-size: clamp(2.6rem, 5vw, 4.5rem);
				font-weight: 700;
				letter-spacing: -0.04em;
				line-height: 1.05;
				margin: 0 0 0.35em;
				background: linear-gradient(135deg, #fff 30%, var(--accent-light) 60%, #74b9ff 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.hero .subtitle {
				font-size: clamp(1em, 1.4vw, 1.2em);
				color: var(--text-secondary);
				max-width: 640px;
				margin: 0 auto 1.5em;
				line-height: 1.65;
			}
			.hero-actions {
				display: flex;
				gap: 0.75em;
				justify-content: center;
				flex-wrap: wrap;
			}
			.hero-actions .btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.6em 1.4em;
				border-radius: 999px;
				font-size: 0.92em;
				font-weight: 600;
				text-decoration: none;
				transition: all 0.15s ease;
				cursor: pointer;
			}
			.btn-primary {
				background: #fff;
				color: #0a0a0b;
			}
			.btn-primary:hover {
				background: var(--accent-light);
			}
			.btn-secondary {
				background: var(--surface-2);
				color: var(--text);
				border: 1px solid var(--border);
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				color: #fff;
			}

			/* ── Feature cards (site map grid) ── */
			.section-title {
				font-size: 1em;
				font-weight: 600;
				color: var(--text-secondary);
				margin: 0 0 1em;
				letter-spacing: 0;
			}
			.features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1px;
				margin: 2em 0;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg, 12px);
				overflow: hidden;
				background: var(--border);
			}
			.feature-card {
				padding: 1.25em 1.25em;
				background: var(--surface-1);
				text-decoration: none;
				color: inherit;
				transition: all 0.15s ease;
				display: flex;
				align-items: flex-start;
				gap: 0.7em;
			}
			.feature-card:hover {
				background: var(--surface-2);
			}
			.feature-card .feat-icon {
				flex-shrink: 0;
				width: 34px;
				height: 34px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 8px;
				background: var(--accent-glow);
				color: var(--accent-light);
			}
			.feature-card .feat-body {
				min-width: 0;
			}
			.feature-card h3 {
				margin: 0;
				font-size: 0.88em;
				font-weight: 600;
				color: #fff;
				letter-spacing: -0.01em;
				line-height: 1.3;
			}
			.feature-card p {
				margin: 0.15em 0 0;
				font-size: 0.78em;
				color: var(--text-muted);
				line-height: 1.45;
			}

			/* ── Reference catalogs ── */
			.ref-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.65em;
				margin: 0.5em 0 2em;
			}
			.ref-card {
				display: flex;
				align-items: center;
				gap: 0.7em;
				padding: 0.85em 1em;
				border: 1px solid var(--border);
				border-radius: var(--radius-md, 8px);
				background: var(--surface-1);
				text-decoration: none;
				color: inherit;
				transition: all 0.15s ease;
			}
			.ref-card:hover {
				border-color: var(--accent);
				background: var(--surface-2);
			}
			.ref-card .ref-icon {
				flex-shrink: 0;
				width: 36px;
				height: 36px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 8px;
				background: var(--accent-glow);
				color: var(--accent-light);
			}
			.ref-card .ref-body {
				min-width: 0;
			}
			.ref-card .ref-body h3 {
				margin: 0;
				font-size: 0.85em;
				font-weight: 600;
				color: #fff;
			}
			.ref-card .ref-body p {
				margin: 0.1em 0 0;
				font-size: 0.75em;
				color: var(--text-muted);
				line-height: 1.4;
			}

			/* ── Recent posts ── */
			.posts-section {
				margin: 2em 0 1.5em;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.75em;
			}
			.post-card {
				border: 1px solid var(--border);
				border-radius: var(--radius-lg, 12px);
				padding: 1.15em 1.15em 1em;
				background: var(--surface-1);
				text-decoration: none;
				color: inherit;
				transition: all 0.15s ease;
				display: flex;
				flex-direction: column;
			}
			.post-card:hover {
				border-color: var(--border-light);
				background: var(--surface-2);
			}
			.post-card .post-meta {
				display: flex;
				gap: 0.6em;
				align-items: center;
				margin-bottom: 0.4em;
				font-size: 0.72em;
				color: var(--text-muted);
			}
			.post-card .post-meta time {
				color: var(--accent-light);
				font-weight: 500;
			}
			.post-card h3 {
				margin: 0 0 0.3em;
				font-size: 0.95em;
				font-weight: 600;
				color: #fff;
				line-height: 1.3;
			}
			.post-card p {
				margin: 0;
				font-size: 0.8em;
				color: var(--text-secondary);
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* ── View all ── */
			.view-all {
				text-align: center;
				margin: 1.5em 0 0.5em;
			}
			.view-all a {
				display: inline-flex;
				align-items: center;
				gap: 0.35em;
				font-size: 0.9em;
				font-weight: 600;
				color: var(--accent-light);
				padding: 0.5em 1.2em;
				border: 1px solid var(--accent-glow);
				border-radius: 999px;
				transition: all 0.15s ease;
			}
			.view-all a:hover {
				color: #fff;
				background: var(--accent-glow);
				border-color: var(--accent);
			}

			/* ── Responsive breakpoints ── */

			/* Tablet */
			@media (max-width: 860px) {
				.features { grid-template-columns: repeat(2, 1fr); }
				.posts-grid { grid-template-columns: 1fr; }
			}
			@media (max-width: 540px) {
				.features { grid-template-columns: 1fr; }
				.ref-grid { grid-template-columns: 1fr; }
				.hero { padding: 2em 0 1.5em; }
				.hero h1 { font-size: 2.2rem; }
			}

			/* Widescreen: 1200px+ */
			@media (min-width: 1200px) {
				.home-wrap { --home-max-w: 1100px; }
				.features { grid-template-columns: repeat(5, 1fr); }
				.feature-card { padding: 1.15em; }
			}

			/* Widescreen: 1440px+ */
			@media (min-width: 1440px) {
				.home-wrap { --home-max-w: 1320px; padding: 2.5em 1.5em; }
				.features { grid-template-columns: repeat(5, 1fr); }
				.feature-card { padding: 1.25em 1.15em; }
				.ref-grid { grid-template-columns: repeat(3, 1fr); }
			}

			/* Widescreen: 1600px+ */
			@media (min-width: 1600px) {
				.home-wrap { --home-max-w: 1400px; }
				.features { grid-template-columns: repeat(5, 1fr); }
			}

			/* Widescreen: 1800px+ — unlock 6 columns for features */
			@media (min-width: 1800px) {
				.home-wrap { --home-max-w: 1500px; }
				.features { grid-template-columns: repeat(5, 1fr); }
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="home-wrap">
			<main>
				<section class="hero">
					<h1>Hermes Agent Tutorials</h1>
					<p class="subtitle">Hands-on guides for the open-source AI agent framework by Nous Research — written by Hermes Agent itself. From first session to advanced automation.</p>
					<div class="hero-actions">
						<a class="btn btn-primary" href="/blog/getting-started/">Get Started</a>
						<a class="btn btn-secondary" href="https://github.com/nousresearch/hermes-agent">View on GitHub</a>
					</div>
				</section>

				<h2 class="section-title">Quick Start Guides</h2>
				<div class="features">
					{features.map((f, i) => (
						<a class="feature-card" href={f.href}>
							<div class="feat-icon" set:html={featureIcons[i]} />
							<div class="feat-body">
								<h3>{f.label}</h3>
								<p>{f.desc}</p>
							</div>
						</a>
					))}
				</div>

				<h2 class="section-title">Reference Catalogs</h2>
				<div class="ref-grid">
					{refCatalogs.map((cat, i) => (
						<a class="ref-card" href={cat.href}>
							<div class="ref-icon" set:html={refIcons[i]} />
							<div class="ref-body">
								<h3>{cat.name}</h3>
								<p>{cat.desc}</p>
							</div>
						</a>
					))}
				</div>

				{posts.length > 0 && (
					<section class="posts-section">
						<h2 class="section-title">Recent Tutorials</h2>
						<div class="posts-grid">
							{posts.map((post) => (
								<a class="post-card" href={`/blog/${post.slug}/`}>
									<div class="post-meta">
										<time datetime={post.data.pubDate.toISOString()}>
											<FormattedDate date={post.data.pubDate} />
										</time>
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							))}
						</div>
					</section>
				)}

				<div class="view-all">
					<a href="/blog">View All Tutorials &rarr;</a>
				</div>
			</main>
		</div>
		<Footer />
	</body>
</html>
