---
import Reference from '../../layouts/Reference.astro';
import { plugins, categories as pluginCategories } from '../../data/plugins';

const categories = pluginCategories.filter((c) => plugins.some((p) => p.category === c.id));

const labelFor = (id: string) => {
  const meta = pluginCategories.find((c) => c.id === id);
  return meta ? `${meta.icon} ${meta.label}` : id;
};

const statusLabel = (status: string) =>
  status === 'bundled' ? 'Bundled' : status === 'community' ? 'Community' : 'Request';

const bundled = plugins.filter((p) => p.status === 'bundled').length;

const stats = [
  { label: 'Total Plugins', value: plugins.length },
  { label: 'Bundled', value: bundled },
  { label: 'Categories', value: categories.length },
  { label: 'Top Rated ★4+', value: plugins.filter((p) => p.rating >= 4).length },
];

const description = `${plugins.length} plugins for Hermes Agent — ${bundled} bundled plus community and requested integrations. Ratings, requirements, and install instructions.`;
---

<Reference
  title="Plugin Marketplace"
  description={description}
  categories={categories}
  stats={stats}
  count={plugins.length}
  searchPlaceholder="Search plugins…"
>
  {plugins.map((p) => (
    <article
      class="card"
      data-card
      data-category={p.category}
      data-name={p.name.toLowerCase()}
      data-desc={p.description.toLowerCase()}
    >
      <div class="category-label">{labelFor(p.category)}</div>
      <div class="card-head">
        <h3>{p.name}</h3>
        <span class={`badge badge-${p.status}`}>{statusLabel(p.status)}</span>
      </div>
      {p.rating > 0 && <div class="rating">{'★'.repeat(p.rating)}{'☆'.repeat(5 - p.rating)}</div>}
      <p>{p.description}</p>
      <div class="details-line">
        <div>{p.autoLoad ? '✅ Auto-loaded' : '🔌 Opt-in'} · <strong>Type:</strong> {p.kind}</div>
        <div><strong>Requires:</strong> {p.requirements}</div>
        {p.auth !== 'None' && <div><strong>Auth:</strong> {p.auth}</div>}
      </div>
      {(p.docsUrl || p.githubIssue) && (
        <div class="actions">
          {p.docsUrl && (
            <a class="action-link" href={p.docsUrl} target="_blank" rel="noopener">📖 Docs</a>
          )}
          {p.githubIssue && (
            <a
              class="action-link"
              href={`https://github.com/NousResearch/hermes-agent/issues/${p.githubIssue.replace('#', '')}`}
              target="_blank"
              rel="noopener"
            >🐛 {p.githubIssue}</a>
          )}
        </div>
      )}
      {p.installHint !== 'None' && p.status !== 'request' && (
        <div class="install-row">
          <span class="install-cmd" id={`cmd-${p.id}`}>{p.installHint}</span>
          <button class="copy-btn" type="button" data-copy={p.installHint}>Copy</button>
        </div>
      )}
    </article>
  ))}
</Reference>
