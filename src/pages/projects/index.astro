---
import Reference from '../../layouts/Reference.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';

const categoryMeta: { id: Project['category']; label: string; icon: string }[] = [
  { id: 'web', label: 'Web', icon: '🌐' },
  { id: 'productivity', label: 'Productivity', icon: '⚡' },
  { id: 'automation', label: 'Automation', icon: '🤖' },
  { id: 'research', label: 'Research', icon: '🔬' },
  { id: 'finance', label: 'Finance', icon: '💰' },
  { id: 'ai', label: 'AI / ML', icon: '🧠' },
  { id: 'communication', label: 'Communication', icon: '💬' },
  { id: 'dev', label: 'Developer', icon: '🛠️' },
];

const categories = categoryMeta.filter((c) => projects.some((p) => p.category === c.id));

const labelFor = (id: string) => {
  const meta = categoryMeta.find((c) => c.id === id);
  return meta ? `${meta.icon} ${meta.label}` : id;
};

const stats = [
  { label: 'Total Projects', value: projects.length },
  { label: 'Beginner', value: projects.filter((p) => p.difficulty === 'beginner').length },
  { label: 'Intermediate', value: projects.filter((p) => p.difficulty === 'intermediate').length },
  { label: 'Advanced', value: projects.filter((p) => p.difficulty === 'advanced').length },
];

const description = `${projects.length} projects you can build with Hermes Agent across ${categories.length} categories — difficulty levels, step-by-step guides, and real use cases.`;
---

<Reference
  title="Projects"
  description={description}
  categories={categories}
  stats={stats}
  count={projects.length}
  searchPlaceholder="Search projects…"
>
  {projects.map((p) => (
    <article
      class="card"
      data-card
      data-category={p.category}
      data-name={p.name.toLowerCase()}
      data-desc={p.description.toLowerCase()}
    >
      <div class="category-label">{labelFor(p.category)}</div>
      <div class="card-head">
        <h3>{p.name}</h3>
        <span class={`badge badge-${p.difficulty}`}>{p.difficulty}</span>
      </div>
      {p.rating > 0 && <div class="rating">{'★'.repeat(p.rating)}{'☆'.repeat(5 - p.rating)}</div>}
      <div class="meta-row">
        <span class="meta-tag">⏱ {p.timeEstimate}</span>
      </div>
      <p>{p.description}</p>
      <div class="build-block">
        <span class="section-label">What you'll build</span>
        {p.whatYouBuild}
      </div>
      <div class="guide-block">
        <span class="section-label">Step-by-step guide</span>
        {p.guide}
      </div>
      <div class="tools-line"><strong>Tools:</strong> {p.toolsNeeded.join(', ')}</div>
      <div class="chip-row">
        {p.useCases.map((u) => <span class="chip chip-muted">{u}</span>)}
      </div>
    </article>
  ))}
</Reference>
