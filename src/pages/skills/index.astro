---
import Reference from '../../layouts/Reference.astro';
import { skills, skillCategories } from '../../data/skills';

const categories = skillCategories.filter((c) => skills.some((s) => s.category === c.id));

const labelFor = (id: string) => {
  const meta = skillCategories.find((c) => c.id === id);
  return meta ? `${meta.icon} ${meta.label}` : id;
};

const stats = [
  { label: 'Total Skills', value: skills.length },
  { label: 'Categories', value: categories.length },
  { label: 'Top Rated ★5', value: skills.filter((s) => s.rating >= 5).length },
  { label: '★4+ Skills', value: skills.filter((s) => s.rating >= 4).length },
];

const description = `Browse, search, and load reusable skills for Hermes Agent. ${skills.length} skills across ${categories.length} categories — each with a guide, how-to, and pitfalls.`;
---

<Reference
  title="Skill Library"
  description={description}
  categories={categories}
  stats={stats}
  count={skills.length}
  searchPlaceholder="Search skills…"
  sortable
>
  {skills.map((s) => (
    <article
      class="card"
      data-card
      data-category={s.category}
      data-name={s.name.toLowerCase()}
      data-desc={s.description.toLowerCase()}
      data-rating={s.rating}
    >
      <div class="category-label">{labelFor(s.category)}</div>
      <div class="card-head">
        <h3><a class="skill-name" href={`/skills/${s.id}/`}>{s.name}</a></h3>
      </div>
      {s.rating > 0 && <div class="rating">{'★'.repeat(s.rating)}{'☆'.repeat(5 - s.rating)}</div>}
      <p>{s.description}</p>
      {(s.isFeatured || s.version || s.requires) && (
        <div class="badge-group">
          {s.isFeatured && <span class="badge badge-featured">★ Featured</span>}
          {s.version && <span class="badge badge-version">v{s.version}</span>}
          {s.requires?.bins && <span class="badge badge-requires">🔧 {s.requires.bins.join(', ')}</span>}
          {s.requires?.env && <span class="badge badge-requires">🔑 {s.requires.env.join(', ')}</span>}
          {s.requires?.config && <span class="badge badge-requires">⚙️ {s.requires.config.join(', ')}</span>}
        </div>
      )}
      <div class="load-hint">skill_view("{s.id}")</div>
      <button
        class="toggle-btn"
        type="button"
        data-toggle
        data-target={`details-${s.id}`}
        data-show-label="▼ Show Details"
        data-hide-label="▲ Hide Details"
      >▼ Show Details</button>
      <div class="collapsible" id={`details-${s.id}`}>
        <div class="collapsible-inner">
          <div class="section-title">📖 Guide</div>
          <div class="guide-text">{s.guide}</div>
          <div class="section-title">🔧 How To</div>
          <div class="howto-text">{s.howto}</div>
          <div class="section-title">⚠️ Pitfalls</div>
          <div class="pitfalls-text">{s.pitfalls}</div>
          {s.requires?.config && (
            <div class="details-line"><strong>Config:</strong> {s.requires.config.join(', ')}</div>
          )}
        </div>
      </div>
    </article>
  ))}
</Reference>
