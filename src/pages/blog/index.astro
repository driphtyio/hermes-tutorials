---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))].sort();
const totalPosts = posts.length;
const POSTS_PER_PAGE = 24;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Blog | ${SITE_TITLE}`,
  description: SITE_DESCRIPTION,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: totalPosts,
    itemListElement: posts.slice(0, 20).map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.data.title,
    })),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(collectionSchema)}
    />
  
<style>
  /* ── Layout ── */
  .blog-main {
    padding: 2rem 1rem 4rem;
    min-height: 60vh;
  }

  .blog-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Page Header ── */
  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #f0f0f0;
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .post-count {
    font-size: 1.05rem;
    color: #666;
    margin: 0;
  }

  /* ── Hero Card ── */
  .hero-card {
    display: flex;
    gap: 2rem;
    background: #121214;
    border: 1px solid #1e1e22;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .hero-card:hover {
    border-color: #6c5ce7;
    box-shadow: 0 0 30px rgba(108, 92, 231, 0.08);
  }

  .hero-image {
    flex: 0 0 320px;
    border-radius: 8px;
    overflow: hidden;
    background: #1a1a1e;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .hero-badge {
    display: inline-block;
    background: #6c5ce7;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
    width: fit-content;
  }

  .hero-title {
    font-size: 1.65rem;
    font-weight: 700;
    color: #f0f0f0;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .hero-meta {
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 0.75rem;
  }

  .hero-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .tag {
    display: inline-block;
    background: #1a1a1e;
    color: #999;
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid #1e1e22;
    line-height: 1.4;
  }

  .hero-description {
    color: #999;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Search ── */
  .search-bar {
    margin-bottom: 1rem;
  }

  .search-bar input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: #121214;
    border: 1px solid #1e1e22;
    border-radius: 8px;
    color: #f0f0f0;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  .search-bar input::placeholder {
    color: #555;
  }

  .search-bar input:focus {
    border-color: #6c5ce7;
  }

  /* ── Filter Bar ── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 2rem;
  }

  .filter-tag {
    background: #121214;
    border: 1px solid #1e1e22;
    color: #777;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .filter-tag:hover {
    border-color: #6c5ce7;
    color: #ccc;
  }

  .filter-tag.active {
    background: #6c5ce7;
    border-color: #6c5ce7;
    color: #fff;
  }

  /* ── Card Grid ── */
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 720px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1400px) {
    .card-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ── Card ── */
  .card {
    background: #121214;
    border: 1px solid #1e1e22;
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }

  .card:hover {
    border-color: #6c5ce7;
    transform: translateY(-2px);
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-body {
    padding: 1rem;
    overflow: hidden;
  }

  .card-thumb {
    float: left;
    width: 40px;
    height: 40px;
    border-radius: 6px;
    object-fit: cover;
    margin-right: 0.75rem;
    margin-bottom: 0.25rem;
    background: #1a1a1e;
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #f0f0f0;
    margin: 0 0 0.35rem;
    line-height: 1.4;
  }

  .card-meta {
    font-size: 0.78rem;
    color: #555;
    margin-bottom: 0.4rem;
  }

  .card-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .card-description {
    font-size: 0.82rem;
    color: #777;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Pagination (buttons are dynamic → :global) ── */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.3rem;
    margin: 2rem 0;
  }

  .pagination :global(button) {
    background: #121214;
    border: 1px solid #1e1e22;
    color: #777;
    padding: 0.5rem 0.85rem;
    border-radius: 6px;
    font-size: 0.88rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s;
  }

  .pagination :global(button:hover:not(:disabled)) {
    border-color: #6c5ce7;
    color: #f0f0f0;
  }

  .pagination :global(button.active) {
    background: #6c5ce7;
    border-color: #6c5ce7;
    color: #fff;
  }

  .pagination :global(button:disabled) {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* ── Empty State ── */
  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: #555;
    font-size: 1.05rem;
  }

  /* ── Responsive ── */
  @media (max-width: 719px) {
    .blog-main {
      padding: 1.5rem 1rem 3rem;
    }

    .page-header h1 {
      font-size: 2rem;
    }

    .hero-card {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }

    .hero-image {
      flex: none;
      width: 100%;
      max-height: 200px;
      border-radius: 8px;
    }

    .hero-title {
      font-size: 1.35rem;
    }

    .filter-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 0.25rem;
    }

    .filter-bar::-webkit-scrollbar {
      display: none;
    }
  }

  @media (min-width: 1400px) {
    .hero-image {
      flex: 0 0 400px;
    }

    .hero-title {
      font-size: 1.85rem;
    }

    .blog-main {
      padding: 3rem 2rem 5rem;
    }
  }
</style>
</head>
  <body>
    <Header />
    <main class="blog-main">
      <div class="blog-container">

        {/* ── Page Header ── */}
        <section class="page-header">
          <h1>Blog</h1>
          <p class="post-count">
            {totalPosts} guides covering every aspect of Hermes Agent
          </p>
        </section>

        {/* ── Featured Hero Card ── */}
        {posts[0] && (
          <a href={`/blog/${posts[0].id}`} class="hero-card">
            {posts[0].data.heroImage && (
              <div class="hero-image">
                <img
                  src={posts[0].data.heroImage}
                  alt={posts[0].data.title}
                  width="640"
                  height="360"
                />
              </div>
            )}
            <div class="hero-content">
              <span class="hero-badge">Latest</span>
              <h2 class="hero-title">{posts[0].data.title}</h2>
              <div class="hero-meta">
                <FormattedDate date={posts[0].data.pubDate} />
              </div>
              {posts[0].data.tags && posts[0].data.tags.length > 0 && (
                <div class="hero-tags">
                  {posts[0].data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              <p class="hero-description">{posts[0].data.description}</p>
            </div>
          </a>
        )}

        {/* ── Search ── */}
        <div class="search-bar">
          <label for="blog-search" class="sr-only">Search posts</label>
          <input
            type="text"
            id="blog-search"
            placeholder="Search posts by title or description…"
          />
        </div>

        {/* ── Tag Filter ── */}
        <div class="filter-bar" role="group" aria-label="Filter by tag">
          <button class="filter-tag active" data-tag="all">All</button>
          {allTags.map((tag) => (
            <button class="filter-tag" data-tag={tag}>{tag}</button>
          ))}
        </div>

        {/* ── Card Grid ── */}
        <div class="card-grid" id="card-grid" style="display:none">
          {posts.map((post) => (
            <article
              class="card"
              data-title={(post.data.title || '').toLowerCase()}
              data-description={(post.data.description || '').toLowerCase()}
              data-tags={(post.data.tags || []).join(',').toLowerCase()}
            >
              <a href={`/blog/${post.id}`} class="card-link">
                <div class="card-body">
                  {post.data.heroImage && (
                    <img
                      class="card-thumb"
                      src={post.data.heroImage}
                      alt=""
                      width="40"
                      height="40"
                      loading="lazy"
                    />
                  )}
                  <h3 class="card-title">{post.data.title}</h3>
                  <div class="card-meta">
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="card-tags">
                      {post.data.tags.slice(0, 2).map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}
                  <p class="card-description">{post.data.description}</p>
                </div>
              </a>
            </article>
          ))}
        </div>

        {/* ── Empty State ── */}
        <div class="empty-state" id="empty-state" style="display:none">
          <p>No posts match your search or filter.</p>
        </div>

        {/* ── Pagination ── */}
        <nav class="pagination" id="pagination" aria-label="Page navigation">
        </nav>
      </div>
    </main>
    <Footer />

    <script is:inline>
      (function () {
        const POSTS_PER_PAGE = 24;
        const allCards = Array.from(document.querySelectorAll('.card'));
        const searchInput = document.getElementById('blog-search');
        const tagButtons = document.querySelectorAll('.filter-tag');
        const cardGrid = document.getElementById('card-grid');
        const emptyState = document.getElementById('empty-state');
        const paginationEl = document.getElementById('pagination');

        let currentPage = 0;
        let activeTag = 'all';
        let searchQuery = '';

        function getFilteredCards() {
          return allCards.filter(function (card) {
            var matchesSearch =
              !searchQuery ||
              card.dataset.title.indexOf(searchQuery) !== -1 ||
              card.dataset.description.indexOf(searchQuery) !== -1;
            var tags = card.dataset.tags ? card.dataset.tags.split(',') : [];
            var matchesTag =
              activeTag === 'all' || tags.indexOf(activeTag) !== -1;
            return matchesSearch && matchesTag;
          });
        }

        function render() {
          var filtered = getFilteredCards();
          var totalPages = Math.ceil(filtered.length / POSTS_PER_PAGE);

          if (totalPages === 0) {
            currentPage = 0;
          } else if (currentPage >= totalPages) {
            currentPage = totalPages - 1;
          }

          for (var i = 0; i < allCards.length; i++) {
            allCards[i].style.display = 'none';
          }

          var start = currentPage * POSTS_PER_PAGE;
          var end = start + POSTS_PER_PAGE;
          var pageCards = filtered.slice(start, end);
          for (var j = 0; j < pageCards.length; j++) {
            pageCards[j].style.display = '';
          }

          if (filtered.length === 0) {
            emptyState.style.display = '';
            cardGrid.style.display = 'none';
          } else {
            emptyState.style.display = 'none';
            cardGrid.style.display = '';
          }

          renderPagination(totalPages);
        }

        function renderPagination(totalPages) {
          paginationEl.innerHTML = '';
          if (totalPages <= 1) {
            paginationEl.style.display = 'none';
            return;
          }
          paginationEl.style.display = '';

          var prev = document.createElement('button');
          prev.textContent = '\u2190 Prev';
          prev.disabled = currentPage === 0;
          prev.addEventListener('click', function () {
            currentPage--;
            render();
            scrollToGrid();
          });
          paginationEl.appendChild(prev);

          for (var i = 0; i < totalPages; i++) {
            (function (pageIdx) {
              var btn = document.createElement('button');
              btn.textContent = String(pageIdx + 1);
              if (pageIdx === currentPage) btn.classList.add('active');
              btn.addEventListener('click', function () {
                currentPage = pageIdx;
                render();
                scrollToGrid();
              });
              paginationEl.appendChild(btn);
            })(i);
          }

          var next = document.createElement('button');
          next.textContent = 'Next \u2192';
          next.disabled = currentPage >= totalPages - 1;
          next.addEventListener('click', function () {
            currentPage++;
            render();
            scrollToGrid();
          });
          paginationEl.appendChild(next);
        }

        function scrollToGrid() {
          var rect = cardGrid.getBoundingClientRect();
          if (rect.height === 0) {
            rect = emptyState.getBoundingClientRect();
          }
          var offset = window.scrollY + rect.top - 80;
          window.scrollTo({ top: Math.max(0, offset), behavior: 'smooth' });
        }

        var debounce;
        searchInput.addEventListener('input', function () {
          var self = this;
          clearTimeout(debounce);
          debounce = setTimeout(function () {
            searchQuery = self.value.toLowerCase().trim();
            currentPage = 0;
            render();
          }, 150);
        });

        tagButtons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            tagButtons.forEach(function (b) {
              b.classList.remove('active');
            });
            this.classList.add('active');
            activeTag = this.dataset.tag;
            currentPage = 0;
            render();
          });
        });

        render();
      })();
    </script>
  </body>
</html>
