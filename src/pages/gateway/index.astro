---
import Reference from '../../layouts/Reference.astro';
import { platforms, gatewayCategories } from '../../data/gateway';

const categories = gatewayCategories.filter((c) => platforms.some((p) => p.category === c.id));

const labelFor = (id: string) => {
  const meta = gatewayCategories.find((c) => c.id === id);
  return meta ? `${meta.icon} ${meta.label}` : id;
};

const stats = [
  { label: 'Total Platforms', value: platforms.length },
  { label: 'Categories', value: categories.length },
  { label: 'Built-in', value: platforms.filter((p) => p.type === 'built-in').length },
  { label: 'Top Rated ★4+', value: platforms.filter((p) => p.rating >= 4).length },
];

const description = `${platforms.length} messaging platforms across ${categories.length} categories — built-in and plugin gateways for Telegram, Discord, Slack, email, SMS, and more.`;
---

<Reference
  title="Messaging Gateway"
  description={description}
  categories={categories}
  stats={stats}
  count={platforms.length}
  searchPlaceholder="Search platforms…"
>
  {platforms.map((p) => (
    <article
      class="card"
      data-card
      data-category={p.category}
      data-name={p.name.toLowerCase()}
      data-desc={p.description.toLowerCase()}
    >
      <div class="category-label">{labelFor(p.category)}</div>
      <div class="card-head">
        <h3>{p.name}</h3>
        <span class={`badge badge-${p.type}`}>{p.type === 'built-in' ? 'Built-in' : 'Plugin'}</span>
      </div>
      {p.rating > 0 && <div class="rating">{'★'.repeat(p.rating)}{'☆'.repeat(5 - p.rating)}</div>}
      <p>{p.description}</p>
      {p.features.length > 0 && (
        <div class="chip-row">
          {p.features.map((f) => <span class="chip">{f}</span>)}
        </div>
      )}
      <div class="details-line">
        <div><strong>Auth:</strong> {p.auth}</div>
        {p.configVars.length > 0 && (
          <div><strong>Env vars:</strong> {p.configVars.join(', ')}</div>
        )}
      </div>
      {p.pitfalls && <div class="pitfall">{p.pitfalls}</div>}
      <button
        class="toggle-btn"
        type="button"
        data-toggle
        data-target={`setup-${p.id}`}
        data-show-label="▼ Setup guide"
        data-hide-label="▲ Setup guide"
      >▼ Setup guide</button>
      <div class="collapsible" id={`setup-${p.id}`}>
        <div class="collapsible-inner">
          <div class="guide-text">{p.setupGuide}</div>
        </div>
      </div>
    </article>
  ))}
</Reference>
