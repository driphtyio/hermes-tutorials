---
// Hermes Tutorials — Arena page (v4, hand-built IA overhaul)
// Priority: widescreen-first dashboard. Record above reference; dense readable tables; all matches visible.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import fs from 'fs';
import arenaData from '../data/hermestuts-arena.json';

const { matches, leaderboard, model_pool, stability, retired_models } = arenaData;

/* ── provider lookup from the pool ── */
const poolByModel = new Map();
for (const m of model_pool) poolByModel.set(String(m.model).toLowerCase(), m);
const providerOf = (name) => (poolByModel.get(String(name || '').toLowerCase()) || {}).provider || '';

/* ── uniform per-match rows (handles BOTH match shapes) ── */
function matchRows(m) {
  let rows = [];
  if (Array.isArray(m.results) && m.results.length) {
    rows = m.results.map((r) => ({
      model: r.model || r.model_id || '—',
      provider: r.provider || providerOf(r.model || r.model_id),
      score: typeof r.score === 'number' ? r.score : null,
      status: r.status || null,
    }));
  } else {
    const sc = m.scores && typeof m.scores === 'object' ? m.scores : {};
    rows = Object.entries(sc).map(([model, score]) => ({
      model, provider: providerOf(model),
      score: typeof score === 'number' ? score : null, status: null,
    }));
    for (const dnf of (Array.isArray(m.dnf) ? m.dnf : [])) {
      rows.push({ model: dnf, provider: providerOf(dnf), score: null, status: 'timeout' });
    }
  }
  return rows
    .sort((a, b) => (b.score ?? -1) - (a.score ?? -1))
    .map((r, i) => ({ ...r, rank: r.score == null ? null : i + 1 }));
}

const localMatches = matches.filter((m) => m.type !== 'router-selection');
const sortedMatches = [...localMatches].sort((a, b) => String(b.date).localeCompare(String(a.date)));
const rowsByMatch = new Map(sortedMatches.map((m) => [String(m.match_id ?? m.id), matchRows(m)]));
const rowsOf = (m) => rowsByMatch.get(String(m.match_id ?? m.id)) || [];
const keyOf = (m) => String(m.match_id ?? m.id);
const topScoreOf = (m) => {
  const r = rowsOf(m).find((x) => x.score != null);
  return r ? r.score : null;
};
const scoreOf = (m) => (typeof m.winner_score === 'number' ? m.winner_score : topScoreOf(m));

/* ── KPIs ── */
const totalMatches = localMatches.length;
const rankedModels = leaderboard.length;
const totalModels = model_pool.length;
const retiredCount = model_pool.filter((m) => m.status === 'retired').length;
const providers = new Set(model_pool.map((m) => m.provider).filter(Boolean));
const scored = sortedMatches.filter((m) => typeof scoreOf(m) === 'number');
const avgWinner = scored.length ? (scored.reduce((s, m) => s + scoreOf(m), 0) / scored.length) : null;
const withGate = sortedMatches.filter((m) => typeof m.threshold_met === 'boolean');
const gateRate = withGate.length ? Math.round((withGate.filter((m) => m.threshold_met).length / withGate.length) * 100) : null;
const distinctLanes = new Set();
for (const m of localMatches) for (const r of rowsOf(m)) distinctLanes.add(String(r.model).toLowerCase());

/* ── leaderboard enrichment ── */
const lastSeen = new Map();
for (const m of sortedMatches) {
  for (const r of rowsOf(m)) {
    const k = String(r.model).toLowerCase();
    if (!lastSeen.has(k)) lastSeen.set(k, m.date);
  }
}
const lb = leaderboard.map((e, i) => ({
  ...e,
  rank: e.rank ?? i + 1,
  winRate: e.matches ? Math.round(((e.wins ?? 0) / e.matches) * 100) : 0,
  last: lastSeen.get(String(e.model).toLowerCase()) || '—',
}));

/* ── availability badge ── */
function availBadge(name) {
  const s = stability?.model_stats?.[name];
  if (!s || typeof s.availability !== 'number') return { label: '—', cls: 'a-none' };
  const a = s.availability;
  if (a >= 99) return { label: 'Stable', cls: 'a-ok' };
  if (a >= 80) return { label: 'Degraded', cls: 'a-warn' };
  if (a >= 1) return { label: 'Unstable', cls: 'a-bad' };
  return { label: 'Down', cls: 'a-down' };
}

/* ── process feedback (local matches only) ── */
let feedback = { matches: [], recurring_issues: [], cleanRate: null };
try {
  const raw = JSON.parse(fs.readFileSync('/home/techgeek/.hermes/arena/arena-feedback.json', 'utf-8'));
  const ids = new Set(localMatches.map(keyOf));
  const local = (raw.matches || []).filter((f) => ids.has(String(f.match_id ?? f.id)));
  feedback = {
    matches: local,
    recurring_issues: Array.isArray(raw.recurring_issues) ? raw.recurring_issues : [],
    cleanRate: local.length ? Math.round((local.filter((f) => f.clean).length / local.length) * 100) : null,
  };
} catch (e) { /* optional */ }

/* ── model pool rows ── */
const roleOrder = { builder: 0, judge: 1, qa: 2, research: 3, planner: 4 };
const roleLabel = { builder: 'Builder', judge: 'Judge', qa: 'QA', research: 'Research', planner: 'Planner' };
const poolRows = [...model_pool]
  .map((m) => ({ ...m, played: (leaderboard.find((l) => String(l.model).toLowerCase() === String(m.model).toLowerCase()) || {}).matches ?? m.matches_played ?? null }))
  .sort((a, b) => (roleOrder[String(a.role).toLowerCase()] ?? 9) - (roleOrder[String(b.role).toLowerCase()] ?? 9)
    || (b.played ?? -1) - (a.played ?? -1) || String(a.model).localeCompare(String(b.model)));

const lastUpdated = arenaData.last_updated || 'N/A';
const stabilityUpdated = stability?.last_updated || 'N/A';

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Arena',
  url: 'https://hermes-tutorials.dev/arena/',
  description: 'Model-vs-model arena for Hermes Agent content and design tasks.',
  dateModified: lastUpdated,
  mainEntity: { '@type': 'ItemList', numberOfItems: lb.length, itemListElement: lb.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.model })) },
};
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Arena — ${SITE_TITLE}`} description="Model-vs-model battle arena — LLMs head-to-head on Hermes Agent content, design and engineering tasks." />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        --accent: #6c5ce7;
        --accent-light: #a29bfe;
        --bg: #0a0a0b;
        --surface-1: #121214;
        --surface-2: #1a1a1e;
        --surface-3: #202026;
        --border: #1e1e22;
        --border-light: #2a2a2e;
        --text: #e8e8ed;
        --text-dim: #a1a1aa;
        --text-muted: #6b6b76;
        --green: #22c55e;
        --red: #ef4444;
        --yellow: #eab308;
        --orange: #f97316;
        --nav-h: 0px;
        --subnav-h: 0px;
      }
      main.arena-container { width: 100%; max-width: min(1800px, 95vw); margin: 0 auto; padding: 0 0 2.5rem; color: var(--text); }

      /* hero + KPI strip */
      .hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.2rem; flex-wrap: wrap; padding: 0.9rem 0 0.6rem; border-bottom: 1px solid var(--border); }
      .hero h1 { font-family: 'Atkinson Hyperlegible', sans-serif; font-size: clamp(1.4rem, 2.1vw, 1.9rem); font-weight: 700; letter-spacing: -0.03em; margin: 0; color: #fff; }
      .hero h1 span { color: var(--accent-light); }
      .hero .tagline { margin: 0.15rem 0 0; font-size: 0.82em; color: var(--text-dim); max-width: 68ch; }
      .kpis { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      .kpi { display: inline-flex; align-items: baseline; gap: 0.32em; font-size: 0.72em; color: var(--text-dim); border: 1px solid var(--border); background: var(--surface-1); border-radius: 999px; padding: 0.28em 0.7em; white-space: nowrap; }
      .kpi strong { color: #fff; font-weight: 700; font-variant-numeric: tabular-nums; font-size: 1.22em; }

      /* sticky sub-nav */
      .subnav { position: sticky; top: var(--nav-h); z-index: 40; display: flex; gap: 0.4rem; align-items: center; overflow-x: auto; padding: 0.5rem 0; background: var(--bg); border-bottom: 1px solid var(--border); scrollbar-width: none; }
      .subnav::-webkit-scrollbar { display: none; }
      .subnav a { flex: none; font-size: 0.76em; font-weight: 600; color: var(--text-dim); border: 1px solid var(--border); background: var(--surface-1); border-radius: 999px; padding: 0.34em 0.85em; text-decoration: none; }
      .subnav a:hover, .subnav a.active { color: #fff; border-color: var(--accent); }
      .subnav .sn-count { color: var(--text-muted); font-weight: 400; margin-left: 0.35em; }

      section.block { margin-top: 1.1rem; }
      .sec-head { display: flex; align-items: center; gap: 0.7rem; margin: 0 0 0.45rem; flex-wrap: wrap; }
      .sec-head h2 { font-family: 'Atkinson Hyperlegible', sans-serif; font-size: 1rem; font-weight: 700; color: #fff; letter-spacing: -0.02em; margin: 0; }
      .sec-head .note { font-size: 0.72em; color: var(--text-muted); }
      .sec-head .spacer { margin-left: auto; }

      /* above-the-fold dashboard */
      .fold { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; align-items: start; }
      @media (min-width: 1100px) { .fold { grid-template-columns: minmax(0, 1.75fr) minmax(320px, 1fr); } }

      /* below-the-fold duo: record (archive) | sticky reference rail (pool) */
      .duo { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; align-items: start; margin-top: 1.1rem; }
      .duo-rail { min-width: 0; display: grid; gap: 0; }
      .duo .block { margin-top: 0; }
      @media (min-width: 1440px) {
        .duo { grid-template-columns: minmax(0, 1.9fr) minmax(340px, 1fr); }
        .duo-rail { position: sticky; top: calc(var(--nav-h) + var(--subnav-h) + 0.5rem); max-height: calc(100vh - var(--nav-h) - var(--subnav-h) - 1rem); overflow: auto; }
        .duo-main .topic { max-width: 44ch; }
        .duo-main .tw { overflow-x: auto; }
      }
      .panel { border: 1px solid var(--border); border-radius: 10px; background: var(--surface-2); overflow: hidden; min-width: 0; }
      .panel .p-head { display: flex; align-items: baseline; gap: 0.6rem; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--border); background: var(--surface-1); }
      .panel .p-head h2 { margin: 0; font-size: 0.88rem; font-weight: 700; color: #fff; letter-spacing: -0.01em; }
      .panel .p-head .note { font-size: 0.68em; color: var(--text-muted); }
      .panel .p-head a { margin-left: auto; font-size: 0.68em; color: var(--accent-light); text-decoration: none; }
      .panel .p-head a:hover { text-decoration: underline; }

      /* dense tables */
      .tw { overflow: visible; }
      table.dt { width: 100%; border-collapse: collapse; font-size: 0.78em; }
      table.dt thead th { position: sticky; top: calc(var(--nav-h) + var(--subnav-h)); z-index: 5; background: var(--surface-1); text-align: left; font-size: 0.7em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); padding: 0.42em 0.6em; border-bottom: 1px solid var(--border-light); white-space: nowrap; }
      table.dt tbody td { padding: 0.24em 0.6em; border-bottom: 1px solid var(--border); height: 28px; vertical-align: middle; white-space: nowrap; color: var(--text); }
      table.dt.tight tbody td { height: 25px; padding: 0.14em 0.6em; }
      table.dt tbody tr:last-child td { border-bottom: none; }
      table.dt tbody tr:nth-child(even) td { background: rgba(255, 255, 255, 0.014); }
      table.dt tbody tr:hover td { background: var(--surface-3); }
      .num { text-align: right; font-variant-numeric: tabular-nums; }
      th.num { text-align: right; }
      .rk { color: var(--text-muted); font-variant-numeric: tabular-nums; }
      .mdl { color: #fff; font-weight: 600; }
      .prov { color: var(--text-muted); font-size: 0.88em; margin-left: 0.45em; font-weight: 400; }
      .avg { color: var(--accent-light); font-weight: 700; font-variant-numeric: tabular-nums; }
      .best { color: var(--text-dim); font-variant-numeric: tabular-nums; }
      .w { color: var(--green); } .l { color: var(--red); }
      .bar { display: inline-block; width: 54px; height: 4px; border-radius: 2px; background: var(--surface-3); overflow: hidden; vertical-align: middle; margin-left: 0.45em; }
      .bar > i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-light)); }
      .tag { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em; border: 1px solid var(--border); border-radius: 999px; padding: 0.05rem 0.42rem; color: var(--text-dim); }
      .tag.builder { color: #8ec9c0; border-color: rgba(45,212,191,.28); }
      .tag.judge { color: #b7a8e8; border-color: rgba(167,139,250,.28); }
      .tag.retired { color: var(--text-muted); text-decoration: line-through; }
      .a-ok { color: var(--green); } .a-warn { color: var(--yellow); } .a-bad { color: var(--orange); } .a-down { color: var(--red); } .a-none { color: var(--text-muted); }
      .win { color: var(--green); font-weight: 600; }
      .date { color: var(--text-muted); font-variant-numeric: tabular-nums; }
      .topic { color: var(--text); display: block; max-width: 62ch; overflow: hidden; text-overflow: ellipsis; }
      .wide-only { display: none; }
      @media (min-width: 1800px) { .wide-only { display: table-cell; } }

      /* archive expander */
      details.mx > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; }
      details.mx > summary::-webkit-details-marker { display: none; }
      details.mx > summary::before { content: '\25B8'; color: var(--text-muted); font-size: 0.9em; flex: none; }
      details.mx[open] > summary::before { content: '\25BE'; color: var(--accent-light); }
      details.mx[open] > summary .topic { color: #fff; }
      details.mx .mx-body { padding: 0.5rem 0.6rem 0.6rem 1.5rem; background: var(--surface-1); }
      details.mx .mx-body table { width: 100%; border-collapse: collapse; font-size: 0.72em; }
      details.mx .mx-body td { padding: 0.16em 0.5em; border-bottom: 1px solid var(--border); white-space: nowrap; }
      details.mx .mx-body tr:last-child td { border-bottom: none; }

      /* collapsed strips */
      details.strip { border: 1px solid var(--border); border-radius: 10px; background: var(--surface-1); margin-top: 0.7rem; }
      details.strip > summary { cursor: pointer; list-style: none; display: flex; align-items: baseline; gap: 0.6rem; padding: 0.55rem 0.8rem; font-size: 0.82em; color: var(--text-dim); }
      details.strip > summary::-webkit-details-marker { display: none; }
      details.strip > summary strong { color: #fff; }
      details.strip > summary .sn { margin-left: auto; font-size: 0.92em; color: var(--text-muted); }
      details.strip .strip-body { padding: 0.2rem 0.8rem 0.8rem; font-size: 0.76em; }
      .issue { display: inline-block; background: var(--surface-2); border: 1px solid var(--border); border-radius: 4px; padding: 0.12em 0.45em; margin: 0 0.3em 0.3em 0; }
      .issue em { color: var(--orange); font-style: normal; }
      .fb-row { border-top: 1px solid var(--border); padding: 0.4rem 0; }
      .fb-row .fb-top { display: flex; justify-content: space-between; gap: 0.8rem; }
      .fb-row .ok { color: var(--green); } .fb-row .bad { color: var(--orange); }
      .fb-row p { margin: 0.25rem 0 0; color: var(--text-dim); }

      #poolSearch { width: min(320px, 100%); background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; color: var(--text); padding: 0.36em 0.65em; font-size: 0.76em; outline: none; }
      #poolSearch:focus { border-color: var(--accent); }
      .more-btn { background: var(--surface-2); color: var(--accent-light); border: 1px solid var(--border); border-radius: 999px; padding: 0.34em 0.9em; font-size: 0.76em; cursor: pointer; }
      .more-btn:hover { border-color: var(--accent); }
      .footline { margin-top: 1rem; font-size: 0.7em; color: var(--text-muted); display: flex; gap: 1rem; flex-wrap: wrap; }
      .empty { color: var(--text-muted); font-size: 0.8em; padding: 1rem 0; }
      @media (max-width: 900px) { .topic { max-width: 30ch; } .tw { overflow-x: auto; } table.dt { min-width: 620px; } }
    </style>
  </head>
  <body>
    <Header />
    <main class="arena-container">

      <div class="hero">
        <div>
          <h1><span>Arena</span></h1>
          <p class="tagline">LLMs head-to-head on Hermes Agent content, design and engineering tasks — every match scored by a multipass model jury.</p>
        </div>
        <div class="kpis">
          <span class="kpi"><strong>{totalMatches}</strong> matches</span>
          <span class="kpi"><strong>{rankedModels}</strong> ranked</span>
          <span class="kpi"><strong>{totalModels}</strong> in pool</span>
          <span class="kpi"><strong>{distinctLanes.size}</strong> models competed</span>
          <span class="kpi"><strong>{providers.size}</strong> providers</span>
          {avgWinner != null && <span class="kpi"><strong>{avgWinner.toFixed(1)}</strong> avg winning score</span>}
          {gateRate != null && <span class="kpi"><strong>{gateRate}%</strong> cleared 8.0</span>}
        </div>
      </div>

      <nav class="subnav" aria-label="Arena sections">
        <a href="#leaderboard">Leaderboard<span class="sn-count">{lb.length}</span></a>
        <a href="#latest-results">Latest results</a>
        <a href="#match-history">Match archive<span class="sn-count">{totalMatches}</span></a>
        <a href="#model-pool">Model pool<span class="sn-count">{totalModels}</span></a>
        <a href="#process-feedback">Feedback<span class="sn-count">{feedback.matches.length}</span></a>
      </nav>

      <div class="fold" style="margin-top:1rem">
        <section class="panel" id="leaderboard" aria-label="Leaderboard">
          <div class="p-head">
            <h2>Leaderboard</h2>
            <span class="note">avg score / 10 · ranked by wins</span>
          </div>
          {lb.length > 0 ? (
            <div class="tw">
              <table class="dt">
                <thead>
                  <tr>
                    <th>#</th><th>Model</th><th class="num">Avg</th><th class="num">Best</th>
                    <th class="num">M</th><th class="num">W / L</th><th class="num">Win%</th>
                    <th class="num wide-only">Uptime</th>
                  </tr>
                </thead>
                <tbody>
                  {lb.map((e) => {
                    const b = availBadge(e.model);
                    return (
                      <tr>
                        <td class="rk">{e.rank <= 3 ? ['🥇', '🥈', '🥉'][e.rank - 1] : `#${e.rank}`}</td>
                        <td>
                          <span class="mdl">{e.model}</span>
                          <span class="prov">{e.provider}</span>
                          {e.retired ? <span class="tag retired">retired</span> : null}
                        </td>
                        <td class="num">
                          <span class="avg">{(e.avgScore ?? 0).toFixed(1)}</span>
                          <span class="bar"><i style={`width:${Math.max(0, Math.min(100, ((e.avgScore ?? 0) / 10) * 100))}%`}></i></span>
                        </td>
                        <td class="num best">{(e.bestScore ?? 0).toFixed(1)}</td>
                        <td class="num">{e.matches ?? 0}</td>
                        <td class="num"><span class="w">{e.wins ?? 0}</span> / <span class="l">{e.losses ?? 0}</span></td>
                        <td class="num best">{e.winRate}%</td>
                        <td class="num wide-only"><span class={b.cls}>{b.label}</span></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : <div class="empty">No ranked models yet.</div>}
        </section>

        <section class="panel" id="latest-results" aria-label="Latest results">
          <div class="p-head">
            <h2>Latest results</h2>
            <span class="note">newest first</span>
            <a href="#match-history">full archive ↓</a>
          </div>
          <div class="tw">
            <table class="dt">
              <thead>
                <tr><th>Date</th><th>Match</th><th class="num">Winner</th></tr>
              </thead>
              <tbody>
                {sortedMatches.slice(0, 8).map((m) => (
                  <tr>
                    <td class="date">{m.date}</td>
                    <td><a href={`#match-${keyOf(m)}`} class="topic" style="text-decoration:none;color:inherit">{m.topic}</a></td>
                    <td class="num"><span class="win">{m.winner}</span> <span class="best">{scoreOf(m) != null ? scoreOf(m).toFixed(1) : '—'}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div style="padding:0.55rem 0.7rem;border-top:1px solid var(--border);font-size:0.72em;color:var(--text-dim);display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center">
            <span style="color:#fff;font-weight:600">How a match runs</span>
            <span style="color:var(--text-muted)">Brief → Plan → Build (all lanes) → Judge → QA → Publish</span>
          </div>
        </section>
      </div>

      <!-- record + reference: two-column at ≥1440 -->
      <div class="duo">
        <section class="block duo-main" id="match-history">
        <div class="sec-head">
          <h2>Match archive</h2>
          <span class="note">{totalMatches} matches · newest first · click a row for per-model scores</span>
        </div>
        {sortedMatches.length > 0 ? (
          <div class="panel">
            <div class="tw">
              <table class="dt">
                <thead>
                  <tr>
                    <th>Date</th><th>Match</th><th>Type</th><th class="num">Lanes</th>
                    <th>Winner</th><th class="num">Score</th>
                    <th class="wide-only">Threshold</th>
                  </tr>
                </thead>
                <tbody>
                  {sortedMatches.map((m, mi) => (
                      <tr data-extra={mi >= 12 ? '1' : null} hidden={mi >= 12}>
                        <td class="date">{m.date}</td>
                      <td>
                        <details class="mx" id={`match-${keyOf(m)}`}>
                          <summary>
                            <span class="topic">{m.topic}</span>
                          </summary>
                          <div class="mx-body">
                            <table>
                              <tbody>
                                {rowsOf(m).map((r) => (
                                  <tr>
                                    <td class="rk">{r.rank === 1 ? '🥇 1st' : r.rank === 2 ? '🥈 2nd' : r.rank === 3 ? '🥉 3rd' : r.rank ? `#${r.rank}` : 'DNF'}</td>
                                    <td class="mdl">{r.model}</td>
                                    <td class="num avg">{r.score != null ? `${r.score.toFixed(1)}/10` : '—'}</td>
                                    <td class="prov" style="margin-left:0">{r.provider}{r.status ? ` · ${r.status}` : ''}</td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                            {(m.judge || m.judge_model) && <div style="margin-top:0.4rem;color:var(--text-muted)">Judged by {m.judge_model || (m.judge && m.judge.model) || m.judge}{m.qa_model ? ` · QA: ${m.qa_model}` : ''}</div>}
                            {m.slug && <div style="margin-top:0.25rem"><a href={`/blog/${m.slug}/`} style="color:var(--accent-light)">Read the published post →</a></div>}
                          </div>
                        </details>
                      </td>
                      <td><span class="tag">{m.type || '—'}</span></td>
                      <td class="num">{m.lanes_declared ?? rowsOf(m).length}</td>
                      <td class="win">{m.winner || '—'}</td>
                      <td class="num avg">{scoreOf(m) != null ? scoreOf(m).toFixed(1) : '—'}</td>
                      <td class="wide-only" style="color:var(--text-dim)">{m.threshold_met === true ? 'met' : m.threshold_met === false ? 'missed' : '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ) : <div class="empty">No matches recorded yet.</div>}
        {sortedMatches.length > 12 && (
          <div style="margin-top:0.5rem">
            <button type="button" id="archiveToggle" class="more-btn" data-state="less">Show more matches ({sortedMatches.length - 12} more)</button>
          </div>
        )}
        </section>

        <aside class="duo-rail">
          <section class="block" id="model-pool">
        <div class="sec-head">
          <h2>Model pool</h2>
          <span class="note">{totalModels} models · {retiredCount} retired · {providers.size} providers</span>
          <span class="spacer"></span>
          <input type="search" id="poolSearch" placeholder="Search model, provider, role…" aria-label="Search model pool" />
        </div>
        <div class="panel">
          <div class="tw">
            <table class="dt tight" id="poolTable">
              <thead>
                <tr><th>Model</th><th>Role</th><th>Provider</th><th class="num">Played</th><th class="num">Avg</th><th class="wide-only">Status</th></tr>
              </thead>
              <tbody>
                {poolRows.map((m) => {
                  const role = String(m.role || '').toLowerCase();
                  const played = m.played;
                  return (
                    <tr data-search={`${m.model} ${m.provider || ''} ${role} ${m.status || ''}`.toLowerCase()}>
                      <td class="mdl">{m.model}</td>
                      <td><span class={`tag ${role === 'builder' ? 'builder' : role === 'judge' ? 'judge' : ''}`}>{roleLabel[role] || m.role || '—'}</span></td>
                      <td class="prov" style="margin-left:0">{m.provider || '—'}</td>
                      <td class="num">{played != null ? played : '—'}</td>
                      <td class="num avg">{typeof m.benchmark_score === 'number' ? m.benchmark_score.toFixed(1) : '—'}</td>
                      <td class="wide-only" style="color:var(--text-dim)">{m.status || '—'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        {Array.isArray(retired_models) && retired_models.length > 0 && (
          <details class="strip">
            <summary><strong>Retired models</strong><span class="sn">{retired_models.length} entries</span></summary>
            <div class="strip-body">
              <table class="dt" style="font-size:0.72em">
                <tbody>
                  {retired_models.map((r) => (
                    <tr><td class="mdl">{r.model}</td><td class="prov" style="margin-left:0">{r.provider || ''}</td><td style="color:var(--text-dim)">{r.reason || ''}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}

        {stability?.model_stats && (
          <details class="strip">
            <summary><strong>Availability</strong><span class="sn">updated {stabilityUpdated}</span></summary>
            <div class="strip-body">
              <table class="dt" style="font-size:0.72em">
                <tbody>
                  {Object.entries(stability.model_stats).map(([name, s]) => {
                    const b = availBadge(name);
                    return (
                      <tr>
                        <td class="mdl">{name}</td>
                        <td class={`num ${b.cls}`}>{typeof s.availability === 'number' ? `${s.availability}%` : '—'}</td>
                        <td class="prov" style="margin-left:0">{b.label}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        )}
        </section>
        </aside>
      </div>

      <details class="strip" id="process-feedback">
        <summary>
          <strong>Process feedback</strong>
          <span class="sn">{feedback.matches.length} analyzed{feedback.cleanRate != null ? ` · ${feedback.cleanRate}% clean` : ''} · {feedback.matches.filter((f) => !f.clean).length} flagged</span>
        </summary>
        <div class="strip-body">
          {feedback.recurring_issues.length > 0 && (
            <div style="margin-bottom:0.5rem">
              {feedback.recurring_issues.map((i) => <span class="issue">{i.issue} <em>×{i.count}</em></span>)}
            </div>
          )}
          {feedback.matches.map((f) => (
            <div class="fb-row">
              <div class="fb-top">
                <span style="color:var(--text)">{f.topic}</span>
                <span class={f.clean ? 'ok' : 'bad'}>{f.clean ? 'Clean' : `${(f.suggestions || []).length} suggestion(s)`}</span>
              </div>
              {!f.clean && (f.suggestions || []).map((s) => <p>[{String(s.severity || '').toUpperCase()}] {s.text}</p>)}
            </div>
          ))}
        </div>
      </details>

      <div class="footline">
        <span>Arena data: <strong style="color:var(--text-dim)">{lastUpdated}</strong></span>
        <span>Stability: <strong style="color:var(--text-dim)">{stabilityUpdated}</strong></span>
        <span>Router-selection matches excluded</span>
      </div>

    </main>
    <Footer />

    <script is:inline>
      (function () {
        function setOffsets() {
          var header = document.querySelector('header');
          var nav = document.querySelector('.subnav');
          var hb = header ? header.getBoundingClientRect().bottom : 0;
          document.documentElement.style.setProperty('--nav-h', Math.max(0, hb) + 'px');
          var nh = nav ? nav.getBoundingClientRect().height : 0;
          document.documentElement.style.setProperty('--subnav-h', nh + 'px');
        }
        setOffsets();
        if ('ResizeObserver' in window) new ResizeObserver(setOffsets).observe(document.body);
        window.addEventListener('resize', setOffsets);
        window.addEventListener('load', setOffsets);
      })();

      (function () {
        var links = Array.prototype.slice.call(document.querySelectorAll('.subnav a'));
        if (!links.length) return;
        var ids = links.map(function (a) { return a.getAttribute('href').slice(1); });
        function onScroll() {
          var cur = ids[0];
          for (var i = 0; i < ids.length; i++) {
            var el = document.getElementById(ids[i]);
            if (el && el.getBoundingClientRect().top <= 200) cur = ids[i];
          }
          links.forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === '#' + cur); });
        }
        document.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();

      (function () {
        var input = document.getElementById('poolSearch');
        var table = document.getElementById('poolTable');
        if (!input || !table) return;
        input.addEventListener('input', function () {
          var q = input.value.trim().toLowerCase();
          Array.prototype.forEach.call(table.querySelectorAll('tbody tr'), function (tr) {
            var hay = tr.getAttribute('data-search') || '';
            tr.hidden = q !== '' && hay.indexOf(q) === -1;
          });
        });
      })();

      if (location.hash && location.hash.indexOf('#match-') === 0) {
        var d = document.querySelector(location.hash);
        if (d && d.tagName === 'DETAILS') {
          var row = d.closest('tr');
          if (row && row.hidden) {
            row.hidden = false;
            var b = document.getElementById('archiveToggle');
            if (b && b.getAttribute('data-state') === 'less') {
              b.setAttribute('data-state', 'more');
              b.textContent = 'Show fewer matches';
            }
          }
          d.open = true;
        }
      }

      // archive window: reveal older matches on demand
      (function () {
        var btn = document.getElementById('archiveToggle');
        if (!btn) return;
        var total = document.querySelectorAll('#match-history table.dt > tbody > tr').length;
        var SHOWN = 12;
        btn.addEventListener('click', function () {
          var showingAll = btn.getAttribute('data-state') === 'all';
          var extras = document.querySelectorAll('#match-history table.dt > tbody > tr[data-extra="1"]');
          Array.prototype.forEach.call(extras, function (r) { r.hidden = !showingAll ? false : true; });
          if (showingAll) { Array.prototype.forEach.call(extras, function (r) { var d = r.querySelector('details'); if (d) d.open = false; }); }
          btn.setAttribute('data-state', showingAll ? 'less' : 'all');
          btn.setAttribute('aria-expanded', showingAll ? 'false' : 'true');
          btn.textContent = showingAll ? ('Show more matches (' + (total - SHOWN) + ' more)') : 'Show fewer matches';
        });
      })();
    </script>
  </body>
</html>
