---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import fs from 'fs';
import arenaData from '../data/hermestuts-arena.json';

const { matches, leaderboard, model_pool, stability } = arenaData;

// ── Stats ──
const totalModels = model_pool.length;
const totalProviders = [...new Set(model_pool.map(m => m.provider))].length;
const rankedModels = leaderboard.length;
const totalMatches = matches.length;

// ── Impact ──
let leaderAvg = 0;
let fieldAvg = 0;
if (leaderboard.length > 0) {
  const topQuarter = Math.max(1, Math.ceil(leaderboard.length * 0.25));
  const topModels = leaderboard.slice(0, topQuarter);
  leaderAvg = topModels.reduce((s, m) => s + m.avgScore, 0) / topModels.length;
  fieldAvg = leaderboard.reduce((s, m) => s + m.avgScore, 0) / leaderboard.length;
} else {
  const withScore = model_pool.filter(m => typeof m.benchmark_score === 'number').sort((a, b) => b.benchmark_score - a.benchmark_score);
  if (withScore.length > 0) {
    const topQuarter = Math.max(1, Math.ceil(withScore.length * 0.25));
    leaderAvg = withScore.slice(0, topQuarter).reduce((s, m) => s + m.benchmark_score, 0) / topQuarter;
    fieldAvg = withScore.reduce((s, m) => s + m.benchmark_score, 0) / withScore.length;
  }
}
const gapDelta = leaderAvg - fieldAvg;

// ── Local matches only ──
const localMatches = matches.filter(m => m.type !== 'router-selection');

// ── Provider grouping (for model pool) ──
const providerGroups = model_pool.reduce((acc, m) => {
  if (!acc[m.provider]) acc[m.provider] = [];
  acc[m.provider].push(m);
  return acc;
}, {});

// ── Availability badge helper ──
function getAvailabilityBadge(modelName) {
  const stats = stability?.model_stats?.[modelName];
  if (!stats) return { label: 'Unknown', cls: 'avail-unknown' };
  const avail = stats.availability;
  if (avail >= 99) return { label: 'Stable', cls: 'avail-stable' };
  if (avail >= 80) return { label: 'Degraded', cls: 'avail-degraded' };
  if (avail >= 1) return { label: 'Unstable', cls: 'avail-unstable' };
  return { label: 'Down', cls: 'avail-down' };
}

const lastUpdated = stability?.last_updated ?? 'N/A';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Arena — ${SITE_TITLE}`} description="Model-vs-model battle arena — comparing LLMs on Hermes Agent content and design tasks." />
    <style>
      /* ── Arena Design System (deepseek-v4-flash widescreen redesign) ── */
      :root {
        --accent: #6c5ce7;
        --accent-light: #a29bfe;
        --accent-glow: rgba(108, 92, 231, 0.15);
        --bg: #0a0a0b;
        --surface-1: #121214;
        --surface-2: #1a1a1e;
        --surface-3: #202026;
        --border: #1e1e22;
        --border-light: #2a2a30;
        --text: #e8e8ed;
        --text-dim: #a1a1aa;
        --text-muted: #6b6b76;
        --green: #22c55e;
        --red: #ef4444;
        --yellow: #eab308;
        --orange: #f97316;
      }

      /* ── OVERRIDE global.css main constraint — fill 95%+ of viewport ── */
      .arena-container {
        width: 100%;
        max-width: min(1900px, 95vw);
        margin: 0 auto;
        padding: 1.5em 1.5em 1.5em;
      }

      @media (min-width: 1400px) {
        .arena-container {
          max-width: min(1800px, 93vw);
          padding: 1.5em 2em 1.5em;
        }
      }
      @media (min-width: 1800px) {
        .arena-container {
          max-width: min(1900px, 94vw);
          padding: 2em 2.5em 2em;
        }
      }
      @media (min-width: 2000px) {
        .arena-container {
          max-width: min(2000px, 95vw);
          padding: 2em 3em 2em;
        }
      }

      /* ── Hero ── */
      .arena-hero {
        margin-bottom: 1em;
      }
      .arena-hero h1 {
        font-family: 'Atkinson Hyperlegible', sans-serif;
        font-size: clamp(2rem, 3.5vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.1;
        margin: 0 0 0.2em;
        color: #fff;
      }
      .arena-hero h1 span {
        color: var(--accent);
      }
      .arena-hero .subtitle {
        font-size: clamp(0.9em, 1.1vw, 1.05em);
        color: var(--text-dim);
        margin: 0 0 0.6em;
        line-height: 1.5;
        max-width: 70ch;
      }

      /* ── Stats bar: single-row compact with pipe separators ── */
      .stats-bar {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 0;
        padding: 0.5em 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin-bottom: 1em;
      }
      .stat-item {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        font-size: 0.8em;
        color: var(--text-dim);
        white-space: nowrap;
      }
      .stat-item + .stat-item::before {
        content: '|';
        color: var(--border);
        margin: 0 0.85em;
        font-size: 0.85em;
      }
      .stat-item strong {
        color: #fff;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      /* ── Section headers (tighter gaps: 1em) ── */
      .section {
        margin-top: 1em;
      }
      .section-title {
        font-family: 'Atkinson Hyperlegible', sans-serif;
        font-size: 1.2em;
        font-weight: 600;
        color: #fff;
        margin: 0 0 0.5em;
        letter-spacing: -0.02em;
      }

      /* ── Impact row: single horizontal row using full width ── */
      .impact-row {
        display: flex;
        gap: 0.6em;
        margin-bottom: 1em;
      }
      .impact-card {
        flex: 1;
        background: var(--surface-1);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.7em 1em;
        display: flex;
        align-items: center;
        gap: 0.75em;
      }
      .impact-card .impact-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--accent-glow);
        color: var(--accent-light);
      }
      .impact-card .impact-body {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .impact-card .impact-label {
        font-size: 0.65em;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.05em;
      }
      .impact-card .impact-value {
        font-size: 1.2em;
        font-weight: 700;
        color: #fff;
        font-variant-numeric: tabular-nums;
        line-height: 1.3;
      }
      .impact-card .impact-value.accent {
        color: var(--accent);
      }
      .impact-card .impact-value.green {
        color: var(--green);
      }
      .impact-card .impact-delta {
        font-size: 0.7em;
        color: var(--text-dim);
        margin-top: 0.05em;
      }

      /* ── Leaderboard table ── */
      .arena-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
      }
      .arena-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85em;
      }
      .arena-table thead {
        background: var(--surface-1);
      }
      .arena-table th {
        text-align: left;
        padding: 0.45em 0.75em;
        font-weight: 600;
        color: var(--text-dim);
        font-size: 0.78em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
      }
      .arena-table td {
        padding: 0.35em 0.75em;
        border-bottom: 1px solid var(--border);
        color: var(--text);
        white-space: nowrap;
      }
      .arena-table tr:last-child td {
        border-bottom: none;
      }
      .arena-table tr:hover td {
        background: var(--surface-2);
        filter: brightness(1.1);
      }
      .arena-table .rank-cell {
        font-weight: 600;
        text-align: center;
        width: 2em;
        font-size: 0.95em;
      }
      .arena-table .model-cell {
        font-weight: 600;
        color: #fff;
        min-width: 12ch;
      }
      .arena-table .provider-cell {
        color: var(--text-dim);
        min-width: 8ch;
      }
      .arena-table .model-provider-wrap {
        display: flex;
        align-items: baseline;
        gap: 0.5em;
      }
      .arena-table .model-provider-wrap .model-name {
        font-weight: 600;
        color: #fff;
      }
      .arena-table .model-provider-wrap .provider-tag {
        font-size: 0.75em;
        color: var(--text-muted);
      }
      .arena-table .score-cell {
        text-align: right;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        min-width: 2.6em;
      }
      .arena-table .score-bar-wrap {
        display: flex;
        align-items: center;
        gap: 0.5em;
        min-width: 100px;
      }
      .arena-table .score-bar-bg {
        flex: 1;
        height: 6px;
        background: var(--border);
        border-radius: 3px;
        overflow: hidden;
      }
      .arena-table .score-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--accent), var(--accent-light));
        border-radius: 3px;
        transition: width 0.3s ease;
      }
      .arena-table .matches-cell,
      .arena-table .wl-cell,
      .arena-table .best-cell {
        text-align: center;
        color: var(--text-dim);
      }
      .arena-table .wl-cell .wins {
        color: var(--green);
      }
      .arena-table .wl-cell .losses {
        color: var(--text-muted);
      }

      /* ── Empty state ── */
      .empty-state {
        text-align: center;
        padding: 1.5em 1em;
        color: var(--text-muted);
        font-size: 0.9em;
        border: 1px dashed var(--border);
        border-radius: 8px;
      }
      .empty-state p {
        margin: 0.2em 0;
      }

      /* ── Match History (compact summaries) ── */
      .match-list {
        display: flex;
        flex-direction: column;
        gap: 0.35em;
      }
      .match-item {
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface-1);
        overflow: hidden;
      }
      .match-item summary {
        padding: 0.5em 0.75em;
        cursor: pointer;
        font-weight: 500;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 0.6em;
        list-style: none;
      }
      .match-item summary::-webkit-details-marker {
        display: none;
      }
      .match-item summary .match-arrow {
        font-size: 0.6em;
        color: var(--accent);
        transition: transform 0.15s ease;
        flex-shrink: 0;
      }
      .match-item[open] summary .match-arrow {
        transform: rotate(90deg);
      }
      .match-item summary .match-topic {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .match-item summary .match-type {
        font-size: 0.6em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--accent-light);
        background: var(--accent-glow);
        padding: 0.1em 0.4em;
        border-radius: 4px;
        flex-shrink: 0;
      }
      .match-item summary .match-compact-info {
        display: flex;
        align-items: center;
        gap: 0.6em;
        font-size: 0.78em;
        color: var(--text-dim);
        flex-shrink: 0;
      }
      .match-item summary .match-compact-info .match-winner {
        color: var(--green);
        font-weight: 600;
      }
      .match-item summary .match-compact-info .match-date {
        color: var(--text-muted);
      }
      .match-item summary .match-compact-info .match-top-score {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: var(--accent-light);
      }
      .match-item .match-detail {
        padding: 0 0.75em 0.55em;
        font-size: 0.82em;
        color: var(--text-dim);
        line-height: 1.5;
      }
      .match-item .match-detail .match-results-list {
        display: flex;
        flex-direction: column;
        gap: 0.2em;
        margin-top: 0.25em;
      }
      .match-item .match-detail .result-entry {
        display: flex;
        align-items: center;
        gap: 0.5em;
        padding: 0.15em 0.4em;
        border-radius: 4px;
      }
      .match-item .match-detail .result-entry.result-winner {
        background: rgba(34, 197, 94, 0.06);
      }
      .match-item .match-detail .result-entry .result-rank {
        width: 1.6em;
        text-align: center;
        flex-shrink: 0;
      }
      .match-item .match-detail .result-entry .result-model {
        font-weight: 500;
        color: #fff;
        min-width: 12ch;
      }
      .match-item .match-detail .result-entry .result-provider {
        font-size: 0.85em;
        color: var(--text-muted);
      }
      .match-item .match-detail .result-entry .result-score {
        margin-left: auto;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        color: var(--accent-light);
      }
      .match-item .match-detail .match-strengths {
        margin-top: 0.3em;
      }
      .match-item .match-detail .match-strengths .ms-label {
        font-size: 0.7em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
        margin-bottom: 0.1em;
      }
      .match-item .match-detail .match-strengths ul {
        list-style: none;
        padding: 0;
        margin: 0.1em 0;
      }
      .match-item .match-detail .match-strengths ul li {
        padding: 0.08em 0;
        font-size: 0.9em;
      }
      .match-item .match-detail .match-strengths ul li::before {
        content: '\\2713 ';
        color: var(--green);
        font-size: 0.8em;
      }

      /* ── Model Pool table ── */
      .pool-search {
        width: 100%;
        padding: 0.5em 0.75em;
        background: var(--surface-1);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: #fff;
        font-size: 0.85em;
        margin-bottom: 0.5em;
        outline: none;
        transition: border-color 0.15s ease;
        font-family: 'Atkinson Hyperlegible', sans-serif;
      }
      .pool-search:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 2px var(--accent-glow);
      }
      .pool-search::placeholder {
        color: var(--text-muted);
      }

      .pool-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
      }
      .pool-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82em;
      }
      .pool-table thead {
        background: var(--surface-1);
      }
      .pool-table th {
        text-align: left;
        padding: 0.45em 0.65em;
        font-weight: 600;
        color: var(--text-dim);
        font-size: 0.78em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--border);
      }
      .pool-table td {
        padding: 0.35em 0.65em;
        border-bottom: 1px solid var(--border);
        color: var(--text);
      }
      .pool-table tr:last-child td {
        border-bottom: none;
      }
      .pool-table tr:hover td {
        background: var(--surface-2);
        filter: brightness(1.1);
      }
      .pool-table .provider-cell-group {
        font-weight: 600;
        color: var(--accent-light);
        vertical-align: middle;
      }
      .pool-table .model-name-cell {
        font-weight: 500;
        color: #fff;
      }
      .pool-table .family-cell {
        color: var(--text-dim);
      }
      .pool-table .score-cell {
        font-variant-numeric: tabular-nums;
        color: var(--text);
      }
      .pool-table .no-score {
        color: var(--text-muted);
        font-style: italic;
      }

      /* ── Availability badges ── */
      .avail-badge {
        display: inline-block;
        font-size: 0.68em;
        font-weight: 600;
        padding: 0.1em 0.42em;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .avail-stable {
        color: var(--green);
        background: rgba(34, 197, 94, 0.12);
      }
      .avail-degraded {
        color: var(--yellow);
        background: rgba(234, 179, 8, 0.12);
      }
      .avail-unstable {
        color: var(--orange);
        background: rgba(249, 115, 22, 0.12);
      }
      .avail-down {
        color: var(--red);
        background: rgba(239, 68, 68, 0.12);
      }
      .avail-unknown {
        color: var(--text-muted);
        background: rgba(107, 107, 118, 0.1);
      }

      /* ── Last Updated ── */
      .last-updated {
        margin-top: 1.5em;
        text-align: center;
        font-size: 0.72em;
        color: var(--text-muted);
        border-top: 1px solid var(--border);
        padding-top: 1em;
      }
      .last-updated strong {
        color: var(--text-dim);
        font-weight: 500;
      }

      /* ── Responsive: Mobile ── */
      @media (max-width: 720px) {
        .arena-container {
          padding: 1em 0.75em 1em;
          max-width: 100%;
        }
        .stats-bar {
          flex-wrap: wrap;
          gap: 0.2em;
        }
        .stat-item + .stat-item::before {
          margin: 0 0.5em;
        }
        .impact-row {
          flex-direction: column;
        }
        .arena-table th,
        .arena-table td {
          padding: 0.3em 0.5em;
        }
        .arena-table .model-provider-wrap {
          flex-direction: column;
          gap: 0.1em;
        }
        .match-item summary {
          flex-wrap: wrap;
        }
        .match-item summary .match-compact-info {
          width: 100%;
          justify-content: flex-start;
          padding-left: 1.4em;
        }
        .pool-table th,
        .pool-table td {
          padding: 0.3em 0.5em;
        }
      }

      /* ── Tablet ── */
      @media (min-width: 720px) and (max-width: 1400px) {
        .arena-container {
          padding: 1.5em 1.25em 1.5em;
        }
        .impact-card {
          padding: 0.65em 0.85em;
        }
      }

      /* ── Widescreen: 1400px+ proportional scaling ── */
      @media (min-width: 1400px) {
        .arena-table td,
        .arena-table th {
          padding: 0.4em 0.9em;
        }
        .arena-table {
          font-size: 0.88em;
        }
        .arena-table .score-bar-wrap {
          min-width: 150px;
        }
        .pool-table td,
        .pool-table th {
          padding: 0.4em 0.9em;
        }
        .impact-card {
          padding: 0.8em 1.1em;
        }
        .impact-card .impact-value {
          font-size: 1.3em;
        }
        .match-item summary {
          padding: 0.55em 0.9em;
        }
        .stat-item {
          font-size: 0.85em;
        }
        .section-title {
          font-size: 1.3em;
        }
      }

      /* ── Ultra-wide: 1800px+ amplify everything ── */
      @media (min-width: 1800px) {
        .arena-table .score-bar-wrap {
          min-width: 200px;
        }
        .arena-table {
          font-size: 0.92em;
        }
        .arena-table td,
        .arena-table th {
          padding: 0.45em 1em;
        }
        .arena-table .score-bar-bg {
          height: 7px;
        }
        .pool-table {
          font-size: 0.86em;
        }
        .pool-table td,
        .pool-table th {
          padding: 0.45em 1em;
        }
        .impact-card {
          padding: 0.9em 1.3em;
        }
        .impact-card .impact-value {
          font-size: 1.45em;
        }
        .impact-card .impact-icon {
          width: 42px;
          height: 42px;
        }
        .section-title {
          font-size: 1.4em;
        }
        .section {
          margin-top: 1.2em;
        }
        .stat-item {
          font-size: 0.9em;
        }
        .match-item summary {
          padding: 0.6em 1em;
        }
      }

      /* ── Maximum: 2000px+ maximum scaling ── */
      @media (min-width: 2000px) {
        .arena-table .score-bar-wrap {
          min-width: 280px;
        }
        .arena-table {
          font-size: 0.96em;
        }
        .arena-table td,
        .arena-table th {
          padding: 0.5em 1.1em;
        }
        .arena-table .score-bar-bg {
          height: 8px;
        }
        .pool-table {
          font-size: 0.9em;
        }
        .impact-card .impact-value {
          font-size: 1.6em;
        }
        .impact-card .impact-icon {
          width: 48px;
          height: 48px;
        }
        .section-title {
          font-size: 1.5em;
        }
        .stat-item {
          font-size: 0.95em;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="arena-container">

      <!-- ── Hero ── -->
      <section class="arena-hero">
        <h1><span>Arena</span> — Model Battleground</h1>
        <p class="subtitle">Comparing LLMs head-to-head on Hermes Agent content generation, design, and engineering tasks. Track scores, reliability, and match outcomes.</p>
        <div class="stats-bar">
          <span class="stat-item"><strong>{totalMatches}</strong> matches</span>
          <span class="stat-item"><strong>{totalModels}</strong> models</span>
          <span class="stat-item"><strong>{totalProviders}</strong> providers</span>
          <span class="stat-item"><strong>{rankedModels}</strong> ranked</span>
        </div>
      </section>

      <!-- ── Arena Impact (full-width inline stats, single horizontal row) ── -->
      <section class="section">
        <h2 class="section-title">Arena Impact</h2>
        <div class="impact-row">
          <div class="impact-card">
            <div class="impact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 7 7 7 7"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5C17 4 17 7 17 7"/><path d="M4 22h16"/><path d="M10 22V2h4v20"/></svg>
            </div>
            <div class="impact-body">
              <div class="impact-label">Leader Avg</div>
              <div class="impact-value accent">{leaderAvg > 0 ? leaderAvg.toFixed(2) : 'N/A'}</div>
              <div class="impact-delta">Top 25% of ranked models</div>
            </div>
          </div>
          <div class="impact-card">
            <div class="impact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </div>
            <div class="impact-body">
              <div class="impact-label">Field Avg</div>
              <div class="impact-value">{fieldAvg > 0 ? fieldAvg.toFixed(2) : 'N/A'}</div>
              <div class="impact-delta">All ranked models</div>
            </div>
          </div>
          <div class="impact-card">
            <div class="impact-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div class="impact-body">
              <div class="impact-label">Gap Delta</div>
              <div class="impact-value green">{gapDelta > 0 ? `+${gapDelta.toFixed(2)}` : (gapDelta === 0 ? '0.00' : gapDelta.toFixed(2))}</div>
              <div class="impact-delta">Leader advantage over field</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Leaderboard ── -->
      <section class="section">
        <h2 class="section-title">Leaderboard</h2>
        {leaderboard.length > 0 ? (
          <div class="arena-table-wrap">
            <table class="arena-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Model</th>
                  <th>Score</th>
                  <th>Matches</th>
                  <th>W/L</th>
                  <th>Best</th>
                </tr>
              </thead>
              <tbody>
                {leaderboard.map((entry, i) => (
                  <tr>
                    <td class="rank-cell">{i < 3 ? ['🥇', '🥈', '🥉'][i] : `#${i + 1}`}</td>
                    <td class="model-provider-wrap">
                      <span class="model-name">{entry.model}</span>
                      <span class="provider-tag">{entry.provider}</span>
                    </td>
                    <td>
                      <div class="score-bar-wrap">
                        <span class="score-cell">{entry.avgScore.toFixed(1)}</span>
                        <div class="score-bar-bg">
                          <div class="score-bar-fill" style={`width: ${(entry.avgScore / 10) * 100}%`}></div>
                        </div>
                      </div>
                    </td>
                    <td class="matches-cell">{entry.matches}</td>
                    <td class="wl-cell"><span class="wins">{entry.wins}</span>/<span class="losses">{entry.losses}</span></td>
                    <td class="best-cell">{entry.bestScore.toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">
            <p>No ranked models yet.</p>
            <p>Leaderboard will populate once arena matches begin.</p>
          </div>
        )}
      </section>

      <!-- ── Match History (collapsible details, compact summaries) ── -->
      <section class="section">
        <h2 class="section-title">Match History</h2>
        {localMatches.length > 0 ? (
          <div class="match-list">
            {localMatches.map(m => (
              <details class="match-item">
                <summary>
                  <span class="match-arrow">▶</span>
                  <span class="match-topic">{m.topic}</span>
                  <span class="match-type">{m.type}</span>
                  <span class="match-compact-info">
                    {m.winner && <span class="match-winner">&#9878; {m.winner}</span>}
                    {m.date && <span class="match-date">{m.date}</span>}
                    {m.results?.[0]?.score && <span class="match-top-score">{m.results[0].score.toFixed(1)}/10</span>}
                  </span>
                </summary>
                <div class="match-detail">
                  <div><strong>Date:</strong> {m.date}</div>
                  <div><strong>Winner:</strong> {m.winner}</div>
                  {m.results && m.results.length > 0 && (
                    <div class="match-results-list">
                      <strong>Results:</strong>
                      {m.results.sort((a, b) => a.rank - b.rank).map(r => (
                        <div class={`result-entry ${r.rank === 1 ? 'result-winner' : ''}`}>
                          <span class="result-rank">{r.rank === 1 ? '🥇' : r.rank === 2 ? '🥈' : r.rank === 3 ? '🥉' : `#${r.rank}`}</span>
                          <span class="result-model">{r.model}</span>
                          <span class="result-provider">{r.provider}</span>
                          <span class="result-score">{r.score.toFixed(1)}/10</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {m.results?.filter(r => r.strengths?.length > 0).length > 0 && (
                    <div class="match-strengths">
                      <div class="ms-label">Strengths</div>
                      <ul>
                        {m.results.filter(r => r.strengths?.length > 0).slice(0, 2).flatMap(r => r.strengths.slice(0, 3)).map(s => (
                          <li>{s}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </details>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No matches recorded yet.</p>
            <p>Match history will appear as arena battles are judged.</p>
          </div>
        )}
      </section>

      <!-- ── Model Pool (searchable table) ── -->
      <section class="section">
        <h2 class="section-title">Model Pool</h2>
        <input type="text" class="pool-search" id="poolSearch" placeholder="Search models by name, provider, or family\u2026" oninput="filterPool()" />
        {model_pool.length > 0 ? (
          <div class="pool-table-wrap">
            <table class="pool-table" id="poolTable">
              <thead>
                <tr>
                  <th>Provider</th>
                  <th>Model</th>
                  <th>Family</th>
                  <th>Score</th>
                  <th>Availability</th>
                </tr>
              </thead>
              <tbody>
                {Object.entries(providerGroups).map(([provider, models]) => (
                  models.map((m, idx) => {
                    const badge = getAvailabilityBadge(m.model);
                    return (
                      <tr data-provider={provider} data-model={m.model} data-family={m.family ?? ''}>
                        {idx === 0 && (
                          <td class="provider-cell-group" rowspan={models.length}>{provider}</td>
                        )}
                        <td class="model-name-cell">{m.model}</td>
                        <td class="family-cell">{m.family ?? '-'}</td>
                        <td class="score-cell">
                          {typeof m.benchmark_score === 'number' ? m.benchmark_score.toFixed(1) : <span class="no-score">--</span>}
                        </td>
                        <td><span class={`avail-badge ${badge.cls}`}>{badge.label}</span></td>
                      </tr>
                    );
                  })
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">
            <p>No models in pool.</p>
          </div>
        )}
      </section>

      <!-- ── Last Updated ── -->
      <div class="last-updated">
        Arena data last updated: <strong>{lastUpdated}</strong>
      </div>

    </main>
    <Footer />

    <script is:inline>
      function filterPool() {
        const input = document.getElementById('poolSearch');
        if (!input) return;
        const q = input.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#poolTable tbody tr');
        rows.forEach(row => {
          const provider = row.getAttribute('data-provider') || '';
          const model = row.getAttribute('data-model') || '';
          const family = row.getAttribute('data-family') || '';
          const match = q === '' ||
            provider.toLowerCase().includes(q) ||
            model.toLowerCase().includes(q) ||
            family.toLowerCase().includes(q);
          row.style.display = match ? '' : 'none';
        });
      }
    </script>
  </body>
</html>
