---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import fs from 'fs';
import arenaData from '../data/hermestuts-arena.json';

const { matches, leaderboard, model_pool, stability, retired_models } = arenaData;

const poolByModel = new Map();
for (const m of model_pool) poolByModel.set(String(m.model).toLowerCase(), m);
const providerOf = (name) => (poolByModel.get(String(name || '').toLowerCase()) || {}).provider || '';

function matchRows(m) {
  let rows = [];
  if (Array.isArray(m.results) && m.results.length) {
    rows = m.results.map((r) => ({
      model: r.model || r.model_id || '—',
      provider: r.provider || providerOf(r.model || r.model_id),
      score: typeof r.score === 'number' ? r.score : null,
      status: r.status || null,
    }));
  } else {
    const sc = m.scores && typeof m.scores === 'object' ? m.scores : {};
    rows = Object.entries(sc).map(([model, score]) => ({
      model,
      provider: providerOf(model),
      score: typeof score === 'number' ? score : null,
      status: null,
    }));
    for (const dnf of (Array.isArray(m.dnf) ? m.dnf : [])) {
      rows.push({ model: dnf, provider: providerOf(dnf), score: null, status: 'timeout' });
    }
  }
  return rows
    .sort((a, b) => (b.score ?? -1) - (a.score ?? -1))
    .map((r, i) => ({ ...r, rank: r.score == null ? null : i + 1 }));
}

const localMatches = matches.filter((m) => m.type !== 'router-selection');
const sortedMatches = [...localMatches].sort((a, b) => String(b.date).localeCompare(String(a.date)));
const rowsByMatch = new Map(sortedMatches.map((m) => [String(m.match_id ?? m.id), matchRows(m)]));
const rowsOf = (m) => rowsByMatch.get(String(m.match_id ?? m.id)) || [];
const keyOf = (m) => String(m.match_id ?? m.id);
const topScoreOf = (m) => {
  const r = rowsOf(m).find((x) => x.score != null);
  return r ? r.score : null;
};
const scoreOf = (m) => (typeof m.winner_score === 'number' ? m.winner_score : topScoreOf(m));
const winnerOf = (m) => {
  if (m.winner) return m.winner;
  if (m.scores && typeof m.scores === 'object') {
    const entries = Object.entries(m.scores).filter(([, v]) => typeof v === 'number');
    if (entries.length) {
      entries.sort((a, b) => b[1] - a[1]);
      return entries[0][0];
    }
  }
  return '—';
};
const judgeOf = (m) => m.judge_model || (m.judge && typeof m.judge === 'object' ? m.judge.model : m.judge) || '—';
const qaLabel = (m) => m.qa_model || (m.qa && typeof m.qa === 'object' ? m.qa.model : m.qa) || '';

const totalMatches = localMatches.length;
const rankedModels = leaderboard.length;
const totalModels = model_pool.length;
const retiredCount = model_pool.filter((m) => m.status === 'retired').length;
const providers = new Set(model_pool.map((m) => m.provider).filter(Boolean));
const scored = sortedMatches.filter((m) => typeof scoreOf(m) === 'number');
const avgWinner = scored.length ? (scored.reduce((s, m) => s + scoreOf(m), 0) / scored.length) : null;
const withGate = sortedMatches.filter((m) => typeof m.threshold_met === 'boolean');
const gateRate = withGate.length ? Math.round((withGate.filter((m) => m.threshold_met).length / withGate.length) * 100) : null;
const distinctLanes = new Set();
for (const m of localMatches) for (const r of rowsOf(m)) distinctLanes.add(String(r.model).toLowerCase());

const lb = leaderboard.map((e, i) => ({
  ...e,
  rank: e.rank ?? i + 1,
  winRate: e.matches ? Math.round(((e.wins ?? 0) / e.matches) * 100) : 0,
}));
const maxScore = Math.max(...lb.map((e) => e.avgScore ?? 0), 0.0001);

function availBadge(name) {
  const s = stability?.model_stats?.[name];
  if (!s || typeof s.availability !== 'number') return { label: 'unknown', cls: 'st-none' };
  const a = s.availability;
  if (a >= 99) return { label: 'Stable', cls: 'st-ok' };
  if (a >= 80) return { label: 'Degraded', cls: 'st-warn' };
  if (a >= 1) return { label: 'Unstable', cls: 'st-bad' };
  return { label: 'Down', cls: 'st-bad' };
}

let feedback = { matches: [], recurring_issues: [], cleanRate: null };
try {
  const raw = JSON.parse(fs.readFileSync('/home/techgeek/.hermes/arena/arena-feedback.json', 'utf-8'));
  const ids = new Set(localMatches.map(keyOf));
  const local = (raw.matches || []).filter((f) => ids.has(String(f.match_id ?? f.id)));
  feedback = {
    matches: local,
    recurring_issues: Array.isArray(raw.recurring_issues) ? raw.recurring_issues : [],
    cleanRate: local.length ? Math.round((local.filter((f) => f.clean).length / local.length) * 100) : null,
  };
} catch { /* optional */ }

const roleOrder = { builder: 0, judge: 1, qa: 2, research: 3, planner: 4 };
const roleLabel = { builder: 'Builder', judge: 'Judge', qa: 'QA', research: 'Research', planner: 'Planner' };
const poolRows = [...model_pool]
  .map((m) => ({ ...m, played: (leaderboard.find((l) => String(l.model).toLowerCase() === String(m.model).toLowerCase()) || {}).matches ?? m.matches_played ?? null }))
  .sort((a, b) => (roleOrder[String(a.role).toLowerCase()] ?? 9) - (roleOrder[String(b.role).toLowerCase()] ?? 9)
    || (b.played ?? -1) - (a.played ?? -1) || String(a.model).localeCompare(String(b.model)));

const lastUpdated = arenaData.last_updated || '—';
const stabilityUpdated = stability?.last_updated || '—';

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Arena',
  url: 'https://hermes-tutorials.dev/arena/',
  description: 'Model-vs-model arena for Hermes Agent content and design tasks.',
  dateModified: lastUpdated,
  mainEntity: { '@type': 'ItemList', numberOfItems: lb.length, itemListElement: lb.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.model })) },
};
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Arena — ${SITE_TITLE}`} description="Model-vs-model battle arena — LLMs head-to-head on Hermes Agent content, design and engineering tasks." />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      main.arena-shell {
        --canvas: #0a0a0b;
        --accent: #6c5ce7;
        --accent-light: #a29bfe;
        --accent-glow: rgba(108, 92, 231, 0.15);
        --surface-1: #121214;
        --surface-2: #1a1a1e;
        --surface-3: #202026;
        --border: #1e1e22;
        --border-light: #2a2a2e;
        --ink: #e8e8ed;
        --ink-2: #a1a1aa;
        --ink-3: #6b6b76;
        --st-ok: #22c55e;
        --st-bad: #ef4444;
        --st-none: #6b6b76;
        --gap: 1.25rem;
        --card-padding: 1.5rem;
        --radius-pill: 999px;
        background: var(--canvas);
        color: var(--ink);
        font-family: 'Atkinson Hyperlegible', -apple-system, sans-serif;
      }
    </style>
    <style>
      main.arena-shell {
        width: min(1800px, 100% - 3rem);
        margin: 0 auto;
        padding: 0 0 3rem;
        box-sizing: border-box;
      }
      main.arena-shell a { color: var(--accent-light); }
      main.arena-shell a:hover { color: var(--ink); }
      .mono { font-family: 'JetBrains Mono', SF Mono, ui-monospace, monospace; font-variant-numeric: tabular-nums; }

      /* ── Hero ─────────────────────────────── */
      .hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 24px 0 16px; border-bottom: 1px solid var(--border); }
      .hero h1 { font-size: 36px; font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; margin: 0; }
      .hero h1 span { color: var(--accent); }
      .hero .tagline { margin: 4px 0 0; font-size: 15px; line-height: 1.75; color: var(--ink-2); max-width: 68ch; }
      .kpis { display: flex; flex-wrap: wrap; gap: 8px; }
      .kpi { display: inline-flex; align-items: baseline; gap: 6px; font-size: 13px; color: var(--ink-2); border: 1px solid var(--border-light); background: var(--surface-1); border-radius: var(--radius-pill); padding: 4px 12px; white-space: nowrap; }
      .kpi strong { color: var(--ink); font-weight: 700; font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }

      /* ── Sticky subnav ────────────────────── */
      nav.subnav {
        position: sticky; top: var(--nav-h, 0px); z-index: 100;
        display: flex; gap: 8px; align-items: center;
        padding: 8px 0; background: var(--canvas); border-bottom: 1px solid var(--border-light);
      }
      nav.subnav a { font-size: 13px; font-weight: 600; color: var(--ink-2); border: 1px solid var(--border-light); background: var(--surface-1); border-radius: var(--radius-pill); padding: 5px 14px; text-decoration: none; }
      nav.subnav a:hover, nav.subnav a.active { color: var(--ink); border-color: var(--accent); background: var(--accent-glow); }
      nav.subnav .sn-count { color: var(--ink-3); font-weight: 400; margin-left: 6px; font-family: 'JetBrains Mono', ui-monospace, monospace; }
      .prompt-label { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; color: var(--ink-3); margin-left: auto; }
      .prompt-label::before { content: '$ '; color: var(--accent); }

      /* ── Page-level named grid ────────────── */
      
      .kpis-bar { grid-area: kpis; padding: 12px 0; }
      .kpis-inner { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; }
      .kpi { display: flex; align-items: baseline; gap: 6px; font-size: 13px; color: var(--ink-2); }
      .kpi .k { color: var(--ink-3); }
      .kpi strong { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
      .kpi strong.accent { color: var(--accent); }

      
      /* Auto-collapse: show first 10 matches, hide the rest */
      .result-list .result-card:nth-child(n+11) {
        display: none;
      }
      .result-list.expanded .result-card:nth-child(n+11) {
        display: block;
      }

      .page-grid {
        display: grid; gap: var(--gap);
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas: "subnav" "kpis" "main" "sidebar";
      }
      .page-grid > .subnav-slot { grid-area: subnav; }
      .page-grid > .main-slot { grid-area: main; min-width: 0; }
      .page-grid > .sidebar-slot { grid-area: sidebar; min-width: 0; }
      .page-grid > .pool-slot { grid-area: pool; min-width: 0; }
      @media (min-width: 1024px) {
        
      .kpis-bar { grid-area: kpis; padding: 12px 0; }
      .kpis-inner { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; }
      .kpi { display: flex; align-items: baseline; gap: 6px; font-size: 13px; color: var(--ink-2); }
      .kpi .k { color: var(--ink-3); }
      .kpi strong { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
      .kpi strong.accent { color: var(--accent); }

      
      /* Auto-collapse: show first 10 matches, hide the rest */
      .result-list .result-card:nth-child(n+11) {
        display: none;
      }
      .result-list.expanded .result-card:nth-child(n+11) {
        display: block;
      }

      .page-grid {
          grid-template-columns: minmax(0, 1fr) 340px;
          grid-template-areas:
            "subnav subnav"
            "kpis kpis"
            "main sidebar";
        }
      }

      /* ── Main two-column: leaderboard + history ── */
      .main-grid {
        display: grid; gap: var(--gap);
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas: "leaderboard" "history";
      }
      @media (min-width: 1024px) {
        .main-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "leaderboard" "history"; }
      }
      #leaderboard { grid-area: leaderboard; }
      #match-history { grid-area: history; }

      /* ── Panels ───────────────────────────── */
      .panel { border: 1px solid var(--border); border-radius: 12px; background: var(--surface-1); min-width: 0; overflow: hidden; display: flex; flex-direction: column; }
      .p-head { display: flex; align-items: baseline; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--border); background: var(--surface-2); flex-wrap: wrap; }
      .p-head h2 { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: -0.015em; }
      .p-head h2::before { content: '» '; color: var(--accent); font-family: 'JetBrains Mono', ui-monospace, monospace; }
      .p-head .note { font-size: 13px; color: var(--ink-3); }
      .p-head .spacer { margin-left: auto; }
      .p-body { overflow-y: auto; min-height: 0; }
      @media (min-width: 1024px) {
        .p-body.tall { /* no max-height — content flows naturally */ }
      }
      .p-body::-webkit-scrollbar { width: 8px; }
      .p-body::-webkit-scrollbar-thumb { background: var(--surface-3); border-radius: var(--radius-pill); }
      .empty { color: var(--ink-3); font-size: 13px; padding: 16px; }

      /* ── Leaderboard cards ────────────────── */
      .lb-list { display: flex; flex-direction: column; }
      .leaderboard-card {
        display: grid; grid-template-columns: auto 1fr auto;
        grid-template-areas: "rank name pills" "rank bar pills";
        align-items: center; column-gap: 12px; row-gap: 6px;
        padding: 10px 16px; border-bottom: 1px solid var(--border);
      }
      .leaderboard-card:last-child { border-bottom: none; }
      .leaderboard-card.is-top { background: var(--accent-glow); box-shadow: inset 3px 0 0 var(--accent); }
      .rank-badge {
        grid-area: rank; width: 34px; height: 34px; border-radius: var(--radius-pill);
        display: inline-flex; align-items: center; justify-content: center;
        font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; font-weight: 700;
        background: var(--surface-3); color: var(--ink-2); border: 1px solid var(--border-light);
      }
      .leaderboard-card.is-top .rank-badge { background: var(--accent); color: #fff; border-color: var(--accent); }
      .lb-name { grid-area: name; font-family: 'Atkinson Hyperlegible', sans-serif; font-size: 15px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .lb-name .prov { color: var(--ink-3); font-size: 12px; font-weight: 400; margin-left: 8px; }
      .lb-bar { grid-area: bar; display: flex; align-items: center; gap: 10px; }
      .lb-bar .track { flex: 1; height: 6px; border-radius: var(--radius-pill); background: var(--surface-3); overflow: hidden;  }
      .lb-bar .track > i { display: block; height: 100%; background: var(--accent); border-radius: var(--radius-pill); }
      .lb-bar .avg { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; font-weight: 700; color: var(--accent-light); }
      .lb-pills { grid-area: pills; display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
      .pill { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; border-radius: var(--radius-pill); padding: 3px 10px; border: 1px solid var(--border-light); background: var(--surface-2); color: var(--ink-2); white-space: nowrap; }
      .pill.win-rate { color: var(--accent-light); border-color: rgba(108,92,231,0.4); background: var(--accent-glow); }
      .pill.st-ok { color: var(--st-ok); border-color: rgba(34,197,94,0.35); }
      .pill.st-bad { color: var(--st-bad); border-color: rgba(239,68,68,0.35); }
      .pill.st-none { color: var(--st-none); }
      .pill.retired { color: var(--st-none); text-decoration: line-through; }
      .pill .w { color: var(--st-ok); } .pill .l { color: var(--st-bad); }

      /* ── Match result cards ───────────────── */
      .result-list { display: flex; flex-direction: column; }
      .result-card { padding: 10px 16px; border-bottom: 1px solid var(--border); }
      .result-card:last-child { border-bottom: none; }
      .rc-top { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
      .rc-date { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--ink-3); }
      .rc-topic { font-size: 14px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
      .rc-meta { margin-left: auto; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
      .rc-lanes { display: flex; flex-direction: column; gap: 3px; margin-top: 8px; }
      .rc-row { display: flex; align-items: center; gap: 8px; padding: 4px 8px; border-radius: 6px; border: 1px solid transparent; font-size: 13px; }
      .rc-row .rk { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--ink-3); width: 30px; flex: none; }
      .rc-row .mdl { font-family: 'Atkinson Hyperlegible', sans-serif; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rc-row .chip { margin-left: auto; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; border-radius: var(--radius-pill); padding: 2px 9px; background: var(--surface-3); color: var(--ink-2); border: 1px solid var(--border-light); white-space: nowrap; }
      .rc-row.is-winner { border-color: rgba(108,92,231,0.45); background: var(--accent-glow); }
      .rc-row.is-winner .chip { background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 700; }
      .rc-foot { margin-top: 6px; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; color: var(--ink-3); }
      .rc-foot a { color: var(--accent-light); text-decoration: none; }
      .status-pill { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; border-radius: var(--radius-pill); padding: 2px 10px; }
      .status-pill.st-ok { color: var(--st-ok); border: 1px solid rgba(34,197,94,0.35); background: rgba(34,197,94,0.08); }
      .status-pill.st-bad { color: var(--st-bad); border: 1px solid rgba(239,68,68,0.35); background: rgba(239,68,68,0.08); }
      .status-pill.st-none { color: var(--st-none); border: 1px solid var(--border-light); background: var(--surface-2); }

      /* ── Sidebar ──────────────────────────── */
      .sidebar-inner { position: sticky; top: calc(var(--nav-h, 0px) + 56px); display: flex; flex-direction: column; gap: var(--gap); }
      .stat-panel { border: 1px solid var(--border); border-radius: 12px; background: var(--surface-1); padding: var(--card-padding); }
      .stat-panel h3 { margin: 0 0 12px; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
      .stat-panel h3::before { content: '# '; color: var(--accent); font-family: 'JetBrains Mono', ui-monospace, monospace; }
      .stat-rows { display: flex; flex-direction: column; gap: 8px; }
      .stat-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; font-size: 13px; color: var(--ink-2); }
      .stat-row strong { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 15px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
      .stat-row strong.accent { color: var(--accent-light); }
      .status-line { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12px; color: var(--ink-3); border: 1px solid var(--border); border-radius: 6px; background: var(--surface-2); padding: 8px 10px; line-height: 1.5; word-break: break-word; }
      .status-line .k { color: var(--accent); }

      /* ── Model pool (full width) ──────────── */
      .pool-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; padding: 0 0 4px; }
      .pool-head h2 { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: -0.015em; }
      .pool-head h2::before { content: '» '; color: var(--accent); font-family: 'JetBrains Mono', ui-monospace, monospace; }
      .pool-head .note { font-size: 13px; color: var(--ink-3); }
      #poolSearch { width: min(280px, 100%); background: var(--surface-2); border: 1px solid var(--border-light); border-radius: 6px; color: var(--ink); padding: 6px 10px; font-size: 13px; font-family: 'JetBrains Mono', ui-monospace, monospace; outline: none; }
      #poolSearch:focus { border-color: var(--accent); }
      .pool-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-top: 12px; }
      .pool-card { border: 1px solid var(--border); border-radius: 12px; background: var(--surface-1); padding: 14px 16px; min-width: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; transition: border-color .15s; }
      .pool-card:hover { border-color: var(--accent); }
      .pool-card .pc-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
      .pool-card .pc-id { color: var(--ink); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .pool-card .pc-id::before { content: 'model: '; color: var(--accent); font-weight: 400; }
      .pool-card dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; }
      .pool-card dt { color: var(--ink-3); font-size: 11px; }
      .pool-card dt::after { content: ':'; }
      .pool-card dd { margin: 0; color: var(--ink-2); font-variant-numeric: tabular-nums; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .pool-card dd.av { font-weight: 700; color: var(--accent-light); }
      .role-pill { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; border-radius: var(--radius-pill); padding: 2px 9px; border: 1px solid var(--border-light); background: var(--surface-2); color: var(--ink-2); }
      .role-pill.builder { color: var(--accent-light); border-color: rgba(108,92,231,0.4); background: var(--accent-glow); }

      /* ── Collapsible strips ───────────────── */
      details.strip { border: 1px solid var(--border); border-radius: 12px; background: var(--surface-1); margin-top: var(--gap); }
      details.strip > summary { cursor: pointer; list-style: none; display: flex; align-items: baseline; gap: 10px; padding: 10px 16px; font-size: 13px; color: var(--ink-2); flex-wrap: wrap; }
      details.strip > summary::-webkit-details-marker { display: none; }
      details.strip > summary::before { content: '\25B8'; color: var(--ink-3); font-family: 'JetBrains Mono', ui-monospace, monospace; }
      details.strip[open] > summary::before { content: '\25BE'; color: var(--accent-light); }
      details.strip > summary strong { color: var(--ink); }
      details.strip > summary .sn { margin-left: auto; font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--ink-3); }
      details.strip .strip-body { padding: 8px 16px 16px; font-size: 13px; }
      .strip-body .line { display: flex; gap: 12px; align-items: baseline; padding: 6px 0; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
      .strip-body .line:last-child { border-bottom: none; }
      .issue { display: inline-block; background: var(--surface-2); border: 1px solid var(--border-light); border-left: 2px solid var(--accent); border-radius: 6px; padding: 2px 8px; margin: 0 6px 6px 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; }
      .fb-row { border-top: 1px solid var(--border); padding: 8px 0; }
      .fb-top { display: flex; justify-content: space-between; gap: 12px; }
      .ok { color: var(--st-ok); } .bad { color: var(--st-bad); }
      .fb-row p { margin: 4px 0 0; color: var(--ink-2); }

      .footline { margin-top: var(--gap); font-size: 13px; color: var(--ink-3); display: flex; gap: 16px; flex-wrap: wrap; font-family: 'JetBrains Mono', ui-monospace, monospace; }
      .footline strong { color: var(--ink-2); font-weight: 600; }

      @media (max-width: 768px) {
        main.arena-shell { width: min(1800px, 100% - 1.5rem); }
        .pool-grid { grid-template-columns: 1fr; }
        .sidebar-inner { position: static; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="arena-shell">
      <div class="page-grid">

        <div class="subnav-slot">
          <div class="hero">
            <div>
              <h1><span>Arena</span></h1>
              <p class="tagline">LLMs head-to-head on Hermes Agent content, design and engineering tasks — every match scored by a multipass model jury.</p>
            </div>
            <div class="kpis">
              <span class="kpi"><strong>{totalMatches}</strong> matches</span>
              <span class="kpi"><strong>{rankedModels}</strong> ranked</span>
              <span class="kpi"><strong>{totalModels}</strong> in pool</span>
              <span class="kpi"><strong>{distinctLanes.size}</strong> competed</span>
              <span class="kpi"><strong>{providers.size}</strong> providers</span>
              {avgWinner != null && <span class="kpi"><strong>{avgWinner.toFixed(1)}</strong> avg win</span>}
              {gateRate != null && <span class="kpi"><strong>{gateRate}%</strong> cleared 8.0</span>}
            </div>
          </div>
          <nav class="subnav" aria-label="Arena sections">
            <a href="#leaderboard">Leaderboard<span class="sn-count">{lb.length}</span></a>
            <a href="#match-history">Match archive<span class="sn-count">{totalMatches}</span></a>
            <a href="#model-pool">Model pool<span class="sn-count">{totalModels}</span></a>
            <span class="prompt-label">hermes arena --watch</span>
          </nav>
        </div>

        <div class="main-slot">
          <div class="kpis-bar">
          <div class="kpis-inner">
            <span class="kpi"><span class="k">Total matches</span><strong>{totalMatches}</strong></span>
            <span class="kpi"><span class="k">Ranked models</span><strong>{rankedModels}</strong></span>
            <span class="kpi"><span class="k">Model pool</span><strong>{totalModels}</strong></span>
            <span class="kpi"><span class="k">Retired</span><strong>{retiredCount}</strong></span>
            <span class="kpi"><span class="k">Providers</span><strong>{providers.size}</strong></span>
            {avgWinner != null && <span class="kpi"><span class="k">Avg winner</span><strong class="accent">{avgWinner.toFixed(1)}</strong></span>}
            {gateRate != null && <span class="kpi"><span class="k">Threshold</span><strong class="accent">{gateRate}%</strong></span>}
            {feedback.cleanRate != null && <span class="kpi"><span class="k">Feedback clean</span><strong>{feedback.cleanRate}%</strong></span>}
          </div>
        </div>
        <div class="main-grid">

            <section class="panel" id="leaderboard" aria-label="Leaderboard">
              <div class="p-head">
                <h2>Leaderboard</h2>
                <span class="note">avg score / 10 · ranked by wins</span>
              </div>
              {lb.length > 0 ? (
                <div class="p-body tall lb-list">
                  {lb.map((e) => {
                    const b = availBadge(e.model);
                    const barPct = Math.max(0, Math.min(100, ((e.avgScore ?? 0) / maxScore) * 100));
                    return (
                      <article class:list={['leaderboard-card', { 'is-top': e.rank === 1 }]}>
                        <span class="rank-badge">{`#${e.rank}`}</span>
                        <span class="lb-name">
                          {e.model}
                          <span class="prov">{e.provider || ''}</span>
                        </span>
                        <span class="lb-bar">
                          <span class="track"><i style={`width:${barPct}%`}></i></span>
                          <span class="avg">{(e.avgScore ?? 0).toFixed(1)}</span>
                        </span>
                        <span class="lb-pills">
                          <span class="pill"><span class="w">W:{e.wins ?? 0}</span> / <span class="l">L:{e.losses ?? 0}</span></span>
                          <span class="pill win-rate">{e.winRate}% win</span>
                          <span class="pill">M:{e.matches ?? 0}</span>
                          <span class="pill">best {(e.bestScore ?? 0).toFixed(1)}</span>
                          <span class:list={['pill', 'st', b.cls]}>{b.label}</span>
                          {e.retired ? <span class="pill retired">retired</span> : null}
                        </span>
                      </article>
                    );
                  })}
                </div>
              ) : <div class="empty">No ranked models yet.</div>}
            </section>

            <section class="panel" id="match-history" aria-label="Match archive">
              <div class="p-head">
                <h2>Match archive</h2>
                <span class="note">{totalMatches} matches · newest first</span>
                <span class="spacer" style="margin-left:auto"></span>
                <button type="button" class="pill" id="archiveToggle" data-state="collapsed" aria-expanded="false" style="cursor:pointer;font-size:12px">Show all</button>
              </div>
              {sortedMatches.length > 0 ? (
                <div class="p-body tall result-list" id="resultList">
                  {sortedMatches.map((m) => {
                    const winner = winnerOf(m);
                    const gate = m.threshold_met;
                    return (
                      <article class="result-card" id={`match-${keyOf(m)}`}>
                        <div class="rc-top">
                          <span class="rc-date">{m.date || '—'}</span>
                          <span class="rc-topic">{m.topic || '—'}</span>
                          <span class="rc-meta">
                            <span class="pill">{m.type || '—'}</span>
                            <span class="pill">{m.lanes_declared ?? rowsOf(m).length} lanes</span>
                            {gate === true && <span class="status-pill st-ok">pass</span>}
                            {gate === false && <span class="status-pill st-bad">fail</span>}
                            {typeof gate !== 'boolean' && <span class="status-pill st-none">unknown</span>}
                          </span>
                        </div>
                        <div class="rc-lanes">
                          {rowsOf(m).map((r) => (
                            <div class:list={['rc-row', { 'is-winner': r.model === winner && r.score != null }]}>
                              <span class="rk">{r.rank === 1 ? '1st' : r.rank === 2 ? '2nd' : r.rank === 3 ? '3rd' : r.rank ? `#${r.rank}` : 'DNF'}</span>
                              <span class="mdl">{r.model}</span>
                              <span class="chip">{r.score != null ? `${r.score.toFixed(1)}/10` : (r.status || '—')}</span>
                            </div>
                          ))}
                        </div>
                        <div class="rc-foot">
                          judge: {judgeOf(m)}{qaLabel(m) ? ` · qa: ${qaLabel(m)}` : ''}{typeof m.drafts === 'number' ? ` · drafts: ${m.drafts}` : ''}
                          {m.slug ? <> · <a href={`/blog/${m.slug}/`}>read the published post</a></> : null}
                        </div>
                      </article>
                    );
                  })}
                </div>
              ) : <div class="empty">No matches recorded yet.</div>}
            </section>

          </div>
        
        </div>
        <aside class="sidebar-slot" aria-label="Model pool">
          <div class="sidebar-inner">
            <div class="pool-slot">
          <section id="model-pool" aria-label="Model pool">
            <div class="pool-head">
              <h2>Model pool</h2>
              <span class="note">{totalModels} models · {retiredCount} retired · {providers.size} providers</span>
              <span class="spacer" style="margin-left:auto"></span>
              <input type="search" id="poolSearch" placeholder="grep model, provider, role…" aria-label="Search model pool" />
            </div>
            <div class="pool-grid" id="poolGrid">
              {poolRows.map((m) => {
                const role = String(m.role || '').toLowerCase();
                const b = availBadge(m.model);
                return (
                  <div class="pool-card" data-search={`${m.model} ${m.provider || ''} ${role} ${m.status || ''}`.toLowerCase()}>
                    <div class="pc-head">
                      <span class="pc-id">{m.model}</span>
                      <span class:list={['pill', b.cls]}>{b.label}</span>
                    </div>
                    <dl>
                      <dt>role</dt><dd><span class:list={['role-pill', { builder: role === 'builder' }]}>{roleLabel[role] || m.role || '—'}</span></dd>
                      <dt>provider</dt><dd>{m.provider || '—'}</dd>
                      <dt>played</dt><dd>{m.played != null ? m.played : '—'}</dd>
                      <dt>avg</dt><dd class="av">{typeof m.benchmark_score === 'number' ? m.benchmark_score.toFixed(1) : '—'}</dd>
                      <dt>status</dt><dd>{m.status || '—'}</dd>
                    </dl>
                  </div>
                );
              })}
            </div>

            {Array.isArray(retired_models) && retired_models.length > 0 && (
              <details class="strip">
                <summary><strong>Retired models</strong><span class="sn">{retired_models.length} entries</span></summary>
                <div class="strip-body">
                  {retired_models.map((r) => (
                    <div class="line"><span class="mono" style="color:var(--ink);font-weight:600">{r.model}</span><span style="color:var(--ink-3)">{r.provider || '—'}</span><span style="color:var(--ink-2)">{r.reason || '—'}</span></div>
                  ))}
                </div>
              </details>
            )}

            {stability?.model_stats && (
              <details class="strip">
                <summary><strong>Availability</strong><span class="sn">updated {stabilityUpdated}</span></summary>
                <div class="strip-body">
                  {Object.entries(stability.model_stats).map(([name, s]) => {
                    const b = availBadge(name);
                    return (
                      <div class="line">
                        <span class="mono" style="color:var(--ink);font-weight:600">{name}</span>
                        <span class:list={['mono', b.cls]} style="font-variant-numeric:tabular-nums">{typeof s.availability === 'number' ? `${s.availability}%` : '—'}</span>
                        <span style="color:var(--ink-3)">{b.label}</span>
                      </div>
                    );
                  })}
                </div>
              </details>
            )}
          </section>
        </div>
          </div>
        </aside>

        

        

      </div>

      <details class="strip" id="process-feedback">
        <summary>
          <strong>Process feedback</strong>
          <span class="sn">{feedback.matches.length} analyzed{feedback.cleanRate != null ? ` · ${feedback.cleanRate}% clean` : ''} · {feedback.matches.filter((f) => !f.clean).length} flagged</span>
        </summary>
        <div class="strip-body">
          {feedback.recurring_issues.length > 0 && (
            <div style="margin-bottom:8px">
              {feedback.recurring_issues.map((i) => <span class="issue">{i.issue} ×{i.count}</span>)}
            </div>
          )}
          {feedback.matches.map((f) => (
            <div class="fb-row">
              <div class="fb-top">
                <span style="color:var(--ink)">{f.topic}</span>
                <span class={f.clean ? 'ok' : 'bad'}>{f.clean ? 'Clean' : `${(f.suggestions || []).length} suggestion(s)`}</span>
              </div>
              {!f.clean && (f.suggestions || []).map((s) => <p>[{String(s.severity || '').toUpperCase()}] {s.text}</p>)}
            </div>
          ))}
        </div>
      </details>

      <div class="footline">
        <span>arena_data: <strong>{lastUpdated}</strong></span>
        <span>stability: <strong>{stabilityUpdated}</strong></span>
        <span>router-selection matches excluded</span>
      </div>

    </main>
    <Footer />

    <script is:inline>
      (function () {
        function setOffsets() {
          var header = document.querySelector('header');
          var nav = document.querySelector('nav.subnav');
          var headerPos = header ? getComputedStyle(header).position : 'static';
          var navH = (headerPos === 'sticky' || headerPos === 'fixed') ? header.offsetHeight : 0;
          document.documentElement.style.setProperty('--nav-h', Math.max(0, navH) + 'px');
        }
        setOffsets();
        if ('ResizeObserver' in window) new ResizeObserver(setOffsets).observe(document.body);
        window.addEventListener('resize', setOffsets);
        window.addEventListener('load', setOffsets);
      })();

      (function () {
        var links = Array.prototype.slice.call(document.querySelectorAll('nav.subnav a'));
        if (!links.length) return;
        var ids = links.map(function (a) { return a.getAttribute('href').slice(1); });
        function onScroll() {
          var cur = ids[0];
          for (var i = 0; i < ids.length; i++) {
            var el = document.getElementById(ids[i]);
            if (el && el.getBoundingClientRect().top <= 200) cur = ids[i];
          }
          links.forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === '#' + cur); });
        }
        document.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();

      (function () {
        var input = document.getElementById('poolSearch');
        var grid = document.getElementById('poolGrid');
        if (!input || !grid) return;
        input.addEventListener('input', function () {
          var q = input.value.trim().toLowerCase();
          Array.prototype.forEach.call(grid.querySelectorAll('.pool-card'), function (card) {
            var hay = card.getAttribute('data-search') || '';
            card.hidden = q !== '' && hay.indexOf(q) === -1;
          });
        });
      })();
    </script>
  <script>
  (function() {
    var toggle = document.getElementById('archiveToggle');
    var list = document.getElementById('resultList');
    if (!toggle || !list) return;
    var COLLAPSED_COUNT = 10;
    function applyCollapse() {
      var cards = list.querySelectorAll('.result-card');
      var expanded = list.classList.contains('expanded');
      cards.forEach(function(card, i) {
        card.style.display = (!expanded && i >= COLLAPSED_COUNT) ? 'none' : '';
      });
      toggle.textContent = expanded ? 'Show recent' : 'Show all';
      toggle.setAttribute('data-state', expanded ? 'expanded' : 'collapsed');
      toggle.setAttribute('aria-expanded', String(expanded));
    }
    toggle.addEventListener('click', function() {
      list.classList.toggle('expanded');
      applyCollapse();
    });
    applyCollapse();
  })();
  </script>

  </body>
</html>
