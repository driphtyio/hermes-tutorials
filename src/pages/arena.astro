---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import fs from 'fs';
import arenaData from '../data/hermestuts-arena.json';

const { matches, leaderboard, model_pool, stability, retired_models } = arenaData;

const poolByModel = new Map();
for (const m of model_pool) poolByModel.set(String(m.model).toLowerCase(), m);
const providerOf = (name) => (poolByModel.get(String(name || '').toLowerCase()) || {}).provider || '';

function matchRows(m) {
  let rows = [];
  if (Array.isArray(m.results) && m.results.length) {
    rows = m.results.map((r) => ({
      model: r.model || r.model_id || '—',
      provider: r.provider || providerOf(r.model || r.model_id),
      score: typeof r.score === 'number' ? r.score : null,
      status: r.status || null,
    }));
  } else {
    const sc = m.scores && typeof m.scores === 'object' ? m.scores : {};
    rows = Object.entries(sc).map(([model, score]) => ({
      model,
      provider: providerOf(model),
      score: typeof score === 'number' ? score : null,
      status: null,
    }));
    for (const dnf of (Array.isArray(m.dnf) ? m.dnf : [])) {
      rows.push({ model: dnf, provider: providerOf(dnf), score: null, status: 'timeout' });
    }
  }
  return rows
    .sort((a, b) => (b.score ?? -1) - (a.score ?? -1))
    .map((r, i) => ({ ...r, rank: r.score == null ? null : i + 1 }));
}

const localMatches = matches.filter((m) => m.type !== 'router-selection');
const sortedMatches = [...localMatches].sort((a, b) => String(b.date).localeCompare(String(a.date)));
const rowsByMatch = new Map(sortedMatches.map((m) => [String(m.match_id ?? m.id), matchRows(m)]));
const rowsOf = (m) => rowsByMatch.get(String(m.match_id ?? m.id)) || [];
const keyOf = (m) => String(m.match_id ?? m.id);
const topScoreOf = (m) => {
  const r = rowsOf(m).find((x) => x.score != null);
  return r ? r.score : null;
};
const scoreOf = (m) => (typeof m.winner_score === 'number' ? m.winner_score : topScoreOf(m));
const winnerOf = (m) => {
  if (m.winner) return m.winner;
  if (m.scores && typeof m.scores === 'object') {
    const entries = Object.entries(m.scores).filter(([, v]) => typeof v === 'number');
    if (entries.length) {
      entries.sort((a, b) => b[1] - a[1]);
      return entries[0][0];
    }
  }
  return '—';
};
const judgeOf = (m) => m.judge_model || (m.judge && typeof m.judge === 'object' ? m.judge.model : m.judge) || '—';
const qaLabel = (m) => m.qa_model || (m.qa && typeof m.qa === 'object' ? m.qa.model : m.qa) || '';

const totalMatches = localMatches.length;
const rankedModels = leaderboard.length;
const totalModels = model_pool.length;
const retiredCount = model_pool.filter((m) => m.status === 'retired').length;
const providers = new Set(model_pool.map((m) => m.provider).filter(Boolean));
const scored = sortedMatches.filter((m) => typeof scoreOf(m) === 'number');
const avgWinner = scored.length ? (scored.reduce((s, m) => s + scoreOf(m), 0) / scored.length) : null;
const withGate = sortedMatches.filter((m) => typeof m.threshold_met === 'boolean');
const gateRate = withGate.length ? Math.round((withGate.filter((m) => m.threshold_met).length / withGate.length) * 100) : null;
const distinctLanes = new Set();
for (const m of localMatches) for (const r of rowsOf(m)) distinctLanes.add(String(r.model).toLowerCase());

const lb = leaderboard.map((e, i) => ({
  ...e,
  rank: e.rank ?? i + 1,
  winRate: e.matches ? Math.round(((e.wins ?? 0) / e.matches) * 100) : 0,
}));

function availBadge(name) {
  const s = stability?.model_stats?.[name];
  if (!s || typeof s.availability !== 'number') return { label: '—', cls: 'a-none' };
  const a = s.availability;
  if (a >= 99) return { label: 'Stable', cls: 'a-ok' };
  if (a >= 80) return { label: 'Degraded', cls: 'a-warn' };
  if (a >= 1) return { label: 'Unstable', cls: 'a-bad' };
  return { label: 'Down', cls: 'a-down' };
}

let feedback = { matches: [], recurring_issues: [], cleanRate: null };
try {
  const raw = JSON.parse(fs.readFileSync('/home/techgeek/.hermes/arena/arena-feedback.json', 'utf-8'));
  const ids = new Set(localMatches.map(keyOf));
  const local = (raw.matches || []).filter((f) => ids.has(String(f.match_id ?? f.id)));
  feedback = {
    matches: local,
    recurring_issues: Array.isArray(raw.recurring_issues) ? raw.recurring_issues : [],
    cleanRate: local.length ? Math.round((local.filter((f) => f.clean).length / local.length) * 100) : null,
  };
} catch { /* optional */ }

const roleOrder = { builder: 0, judge: 1, qa: 2, research: 3, planner: 4 };
const roleLabel = { builder: 'Builder', judge: 'Judge', qa: 'QA', research: 'Research', planner: 'Planner' };
const poolRows = [...model_pool]
  .map((m) => ({ ...m, played: (leaderboard.find((l) => String(l.model).toLowerCase() === String(m.model).toLowerCase()) || {}).matches ?? m.matches_played ?? null }))
  .sort((a, b) => (roleOrder[String(a.role).toLowerCase()] ?? 9) - (roleOrder[String(b.role).toLowerCase()] ?? 9)
    || (b.played ?? -1) - (a.played ?? -1) || String(a.model).localeCompare(String(b.model)));

const lastUpdated = arenaData.last_updated || '—';
const stabilityUpdated = stability?.last_updated || '—';

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Arena',
  url: 'https://hermes-tutorials.dev/arena/',
  description: 'Model-vs-model arena for Hermes Agent content and design tasks.',
  dateModified: lastUpdated,
  mainEntity: { '@type': 'ItemList', numberOfItems: lb.length, itemListElement: lb.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.model })) },
};
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Arena — ${SITE_TITLE}`} description="Model-vs-model battle arena — LLMs head-to-head on Hermes Agent content, design and engineering tasks." />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      main.arena-shell {
        --arena-accent: #6c5ce7;
        --arena-accent-light: #a29bfe;
        --arena-canvas: #0a0a0b;
        --arena-surface-1: #121214;
        --arena-surface-2: #1a1a1e;
        --arena-surface-3: #202026;
        --arena-border: #1e1e22;
        --arena-border-light: #2a2a2e;
        --arena-ink: #e8e8ed;
        --arena-ink-2: #a1a1aa;
        --arena-ink-3: #6b6b76;
        --arena-ok: #22c55e;
        --arena-warn: #eab308;
        --arena-bad: #ef4444;
        --arena-glow: rgba(108, 92, 231, 0.15);
        background: var(--arena-canvas);
        color: var(--arena-ink);
        font-family: 'Atkinson Hyperlegible', -apple-system, sans-serif;
      }
    </style>
    <style>
      main.arena-shell { width: 100%; max-width: none; margin: 0; padding: 0 24px 3rem; box-sizing: border-box; }
      main.arena-shell a { color: var(--arena-accent-light); }
      main.arena-shell a:hover { color: var(--arena-ink); }

      .hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 24px 0 16px; border-bottom: 1px solid var(--arena-border); }
      .hero h1 { font-size: 36px; font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; margin: 0; color: var(--arena-ink); }
      .hero h1 span { color: var(--arena-accent); }
      .hero .tagline { margin: 4px 0 0; font-size: 15px; line-height: 1.75; color: var(--arena-ink-2); max-width: 68ch; }
      .kpis { display: flex; flex-wrap: wrap; gap: 8px; }
      .kpi { display: inline-flex; align-items: baseline; gap: 6px; font-size: 13px; color: var(--arena-ink-2); border: 1px solid var(--arena-border-light); background: var(--arena-surface-1); border-radius: 9999px; padding: 4px 12px; white-space: nowrap; }
      .kpi strong { color: var(--arena-ink); font-weight: 700; font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }

      .subnav { position: sticky; top: var(--nav-h, 0px); z-index: 40; display: flex; gap: 8px; align-items: center; overflow-x: auto; padding: 8px 0; background: var(--arena-canvas); border-bottom: 1px solid var(--arena-border); scrollbar-width: none; }
      .subnav::-webkit-scrollbar { display: none; }
      .subnav a { flex: none; font-size: 13px; font-weight: 600; color: var(--arena-ink-2); border: 1px solid var(--arena-border-light); background: var(--arena-surface-1); border-radius: 9999px; padding: 5px 14px; text-decoration: none; }
      .subnav a:hover, .subnav a.active { color: var(--arena-ink); border-color: var(--arena-accent); background: var(--arena-glow); }
      .subnav .sn-count { color: var(--arena-ink-3); font-weight: 400; margin-left: 6px; font-family: 'JetBrains Mono', ui-monospace, monospace; }

      .prompt-label { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; color: var(--arena-ink-3); }
      .prompt-label::before { content: '$ '; color: var(--arena-accent); }
      .prompt-label b { color: var(--arena-ink); font-weight: 600; }

      .primary-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; margin-top: 20px; }
      @media (min-width: 1000px) {
        .primary-grid { grid-template-columns: minmax(0, 1.6fr) minmax(360px, 1fr); }
      }

      .panel { border: 1px solid var(--arena-border); border-radius: 12px; background: var(--arena-surface-1); min-width: 0; overflow: hidden; }
      .p-head { display: flex; align-items: baseline; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--arena-border); background: var(--arena-surface-2); flex-wrap: wrap; }
      .p-head h2 { margin: 0; font-size: 18px; font-weight: 600; color: var(--arena-ink); letter-spacing: -0.015em; }
      .p-head .note { font-size: 13px; color: var(--arena-ink-3); }
      .p-head .spacer { margin-left: auto; }

      .tw { overflow-x: auto; }
      table.dt { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: fixed; }
      table.dt.auto { table-layout: auto; }
      table.dt thead th { background: var(--arena-surface-2); text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--arena-ink-3); padding: 6px 10px; border-bottom: 1px solid var(--arena-border-light); white-space: nowrap; }
      table.dt thead th.num, table.dt td.num { text-align: right; }
      table.dt tbody td { padding: 6px 10px; border-bottom: 1px solid var(--arena-border); height: 34px; vertical-align: middle; white-space: nowrap; color: var(--arena-ink); }
      table.dt tbody tr:last-child td { border-bottom: none; }
      table.dt tbody tr:nth-child(even) td { background: rgba(255,255,255,0.012); }
      table.dt tbody tr:hover td { background: var(--arena-surface-2); }
      .num { font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }
      .rk { color: var(--arena-ink-3); font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }
      .mdl { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; color: var(--arena-ink); font-weight: 600; }
      .prov { color: var(--arena-ink-3); font-size: 12px; margin-left: 8px; }
      .avg { color: var(--arena-accent-light); font-weight: 700; }
      .best { color: var(--arena-ink-2); }
      .w { color: var(--arena-ok); } .l { color: var(--arena-bad); }
      .bar { display: inline-block; width: 54px; height: 4px; border-radius: 9999px; background: var(--arena-surface-3); overflow: hidden; vertical-align: middle; margin-left: 8px; }
      .bar > i { display: block; height: 100%; background: var(--arena-accent); }
      tr.top-row td { background: var(--arena-glow) !important; }
      tr.top-row td:first-child { box-shadow: inset 3px 0 0 var(--arena-accent); }
      .tag { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid var(--arena-border-light); border-radius: 9999px; padding: 1px 8px; color: var(--arena-ink-2); }
      .tag.builder { color: var(--arena-accent-light); border-color: rgba(108,92,231,0.4); background: var(--arena-glow); }
      .tag.retired { color: var(--arena-ink-3); text-decoration: line-through; }
      .a-ok { color: var(--arena-ok); } .a-warn { color: var(--arena-warn); } .a-bad { color: var(--arena-bad); } .a-down { color: var(--arena-bad); } .a-none { color: var(--arena-ink-3); }
      .badge { display: inline-block; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; border-radius: 6px; padding: 1px 8px; background: var(--arena-glow); color: var(--arena-accent-light); border: 1px solid rgba(108,92,231,0.35); }
      .badge.neutral { background: var(--arena-surface-3); color: var(--arena-ink-2); border-color: var(--arena-border-light); }
      .win { color: var(--arena-ok); font-weight: 600; }
      .date { color: var(--arena-ink-3); font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }
      .topic { color: var(--arena-ink); display: block; overflow: hidden; text-overflow: ellipsis; }
      .empty { color: var(--arena-ink-3); font-size: 13px; padding: 16px; }

      details.mx > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 8px; }
      details.mx > summary::-webkit-details-marker { display: none; }
      details.mx > summary::before { content: '\25B8'; color: var(--arena-ink-3); flex: none; font-family: 'JetBrains Mono', ui-monospace, monospace; }
      details.mx[open] > summary::before { content: '\25BE'; color: var(--arena-accent-light); }
      details.mx .mx-body { padding: 8px 12px 12px 24px; background: var(--arena-surface-2); }
      details.mx .mx-body table { width: 100%; border-collapse: collapse; font-size: 13px; }
      details.mx .mx-body td { padding: 4px 8px; border-bottom: 1px solid var(--arena-border); white-space: nowrap; }
      details.mx .mx-body tr:last-child td { border-bottom: none; }

      .pool-section { margin-top: 32px; }
      .pool-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-top: 12px; }
      .pool-card { border: 1px solid var(--arena-border); border-radius: 12px; background: var(--arena-surface-1); padding: 14px 16px; min-width: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; transition: border-color .15s; }
      .pool-card:hover { border-color: var(--arena-accent); }
      .pool-card .pc-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
      .pool-card .pc-id { color: var(--arena-ink); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .pool-card .pc-id::before { content: 'model: '; color: var(--arena-accent); font-weight: 400; }
      .pool-card dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; }
      .pool-card dt { color: var(--arena-ink-3); font-size: 11px; }
      .pool-card dt::after { content: ':'; }
      .pool-card dd { margin: 0; color: var(--arena-ink-2); font-variant-numeric: tabular-nums; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .pool-card dd.av { font-weight: 700; }
      #poolSearch { width: min(280px, 100%); background: var(--arena-surface-2); border: 1px solid var(--arena-border-light); border-radius: 6px; color: var(--arena-ink); padding: 6px 10px; font-size: 13px; font-family: 'JetBrains Mono', ui-monospace, monospace; outline: none; }
      #poolSearch:focus { border-color: var(--arena-accent); }
      .more-btn { background: var(--arena-surface-2); color: var(--arena-accent-light); border: 1px solid var(--arena-border-light); border-radius: 9999px; padding: 6px 14px; font-size: 13px; cursor: pointer; font-family: 'Atkinson Hyperlegible', sans-serif; }
      .more-btn:hover { border-color: var(--arena-accent); }

      details.strip { border: 1px solid var(--arena-border); border-radius: 12px; background: var(--arena-surface-1); margin-top: 20px; }
      details.strip > summary { cursor: pointer; list-style: none; display: flex; align-items: baseline; gap: 10px; padding: 10px 16px; font-size: 13px; color: var(--arena-ink-2); flex-wrap: wrap; }
      details.strip > summary::-webkit-details-marker { display: none; }
      details.strip > summary strong { color: var(--arena-ink); }
      details.strip > summary .sn { margin-left: auto; font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--arena-ink-3); }
      details.strip .strip-body { padding: 8px 16px 16px; font-size: 13px; }
      .issue { display: inline-block; background: var(--arena-surface-2); border: 1px solid var(--arena-border-light); border-left: 2px solid var(--arena-accent); border-radius: 6px; padding: 2px 8px; margin: 0 6px 6px 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 11px; }
      .fb-row { border-top: 1px solid var(--arena-border); padding: 8px 0; }
      .fb-top { display: flex; justify-content: space-between; gap: 12px; }
      .ok { color: var(--arena-ok); } .bad { color: var(--arena-warn); }
      .fb-row p { margin: 4px 0 0; color: var(--arena-ink-2); }

      .footline { margin-top: 20px; font-size: 13px; color: var(--arena-ink-3); display: flex; gap: 16px; flex-wrap: wrap; font-family: 'JetBrains Mono', ui-monospace, monospace; }
      .footline strong { color: var(--arena-ink-2); font-weight: 600; }

      @media (max-width: 960px) {
        .primary-grid { grid-template-columns: minmax(0, 1fr); }
        .pool-grid { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
      }
      @media (max-width: 600px) {
        main.arena-shell { padding: 0 12px 2rem; }
        .pool-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="arena-shell">

      <div class="hero">
        <div>
          <h1><span>Arena</span></h1>
          <p class="tagline">LLMs head-to-head on Hermes Agent content, design and engineering tasks — every match scored by a multipass model jury.</p>
        </div>
        <div class="kpis">
          <span class="kpi"><strong>{totalMatches}</strong> matches</span>
          <span class="kpi"><strong>{rankedModels}</strong> ranked</span>
          <span class="kpi"><strong>{totalModels}</strong> in pool</span>
          <span class="kpi"><strong>{distinctLanes.size}</strong> competed</span>
          <span class="kpi"><strong>{providers.size}</strong> providers</span>
          {avgWinner != null && <span class="kpi"><strong>{avgWinner.toFixed(1)}</strong> avg win</span>}
          {gateRate != null && <span class="kpi"><strong>{gateRate}%</strong> cleared 8.0</span>}
        </div>
      </div>

      <nav class="subnav" aria-label="Arena sections">
        <a href="#leaderboard">Leaderboard<span class="sn-count">{lb.length}</span></a>
        <a href="#latest-results">Latest results</a>
        <a href="#match-history">Match archive<span class="sn-count">{totalMatches}</span></a>
        <a href="#model-pool">Model pool<span class="sn-count">{totalModels}</span></a>
      </nav>

      <div class="primary-grid">
        <section class="panel" id="leaderboard" aria-label="Leaderboard">
          <div class="p-head">
            <h2>Leaderboard</h2>
            <span class="note">avg score / 10 · ranked by wins</span>
          </div>
          {lb.length > 0 ? (
            <div class="tw">
              <table class="dt auto">
                <thead>
                  <tr>
                    <th style="width:44px">#</th>
                    <th>Model</th>
                    <th class="num">Avg</th>
                    <th class="num">Best</th>
                    <th class="num">M</th>
                    <th class="num">W / L</th>
                    <th class="num">Win%</th>
                    <th class="num">Uptime</th>
                  </tr>
                </thead>
                <tbody>
                  {lb.map((e) => {
                    const b = availBadge(e.model);
                    return (
                      <tr class={e.rank === 1 ? 'top-row' : null}>
                        <td class="rk">{e.rank === 1 ? '#1' : e.rank === 2 ? '#2' : e.rank === 3 ? '#3' : `#${e.rank}`}</td>
                        <td>
                          <span class="mdl">{e.model}</span>
                          <span class="prov">{e.provider || ''}</span>
                          {e.retired ? <span class="tag retired" style="margin-left:8px">retired</span> : null}
                        </td>
                        <td class="num">
                          <span class="avg">{(e.avgScore ?? 0).toFixed(1)}</span>
                          <span class="bar"><i style={`width:${Math.max(0, Math.min(100, ((e.avgScore ?? 0) / 10) * 100))}%`}></i></span>
                        </td>
                        <td class="num best">{(e.bestScore ?? 0).toFixed(1)}</td>
                        <td class="num">{e.matches ?? 0}</td>
                        <td class="num"><span class="w">{e.wins ?? 0}</span> / <span class="l">{e.losses ?? 0}</span></td>
                        <td class="num best">{e.winRate}%</td>
                        <td class={`num ${b.cls}`}>{b.label}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : <div class="empty">No ranked models yet.</div>}
        </section>

        <section class="panel" id="latest-results" aria-label="Latest results">
          <div class="p-head">
            <h2>Latest results</h2>
            <span class="note">newest first</span>
            <span class="spacer"></span>
            <a href="#match-history" style="font-size:13px;text-decoration:none">full archive →</a>
          </div>
          <div class="tw">
            <table class="dt auto">
              <thead>
                <tr><th>Date</th><th>Match</th><th class="num">Result</th></tr>
              </thead>
              <tbody>
                {sortedMatches.slice(0, 8).map((m) => (
                  <tr>
                    <td class="date">{m.date || '—'}</td>
                    <td><a href={`#match-${keyOf(m)}`} class="topic" style="text-decoration:none">{m.topic || '—'}</a></td>
                    <td class="num">
                      <span class="badge">{winnerOf(m)}</span>
                      <span class="best" style="margin-left:6px">{scoreOf(m) != null ? scoreOf(m).toFixed(1) : '—'}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div style="padding:10px 16px;border-top:1px solid var(--arena-border);font-size:13px;color:var(--arena-ink-2);display:flex;gap:8px;flex-wrap:wrap;align-items:baseline">
            <span class="prompt-label"><b>how-a-match-runs</b></span>
            <span style="color:var(--arena-ink-3)">Brief → Plan → Build (all lanes) → Judge → QA → Publish</span>
          </div>
        </section>
      </div>

      <section class="panel" id="match-history" style="margin-top:20px" aria-label="Match archive">
        <div class="p-head">
          <h2>Match archive</h2>
          <span class="note">{totalMatches} matches · newest first · click a row for per-model scores</span>
        </div>
        {sortedMatches.length > 0 ? (
          <div class="tw">
            <table class="dt auto">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Match</th>
                  <th>Type</th>
                  <th class="num">Lanes</th>
                  <th>Winner</th>
                  <th class="num">Score</th>
                  <th>Judge</th>
                  <th class="num">Threshold</th>
                </tr>
              </thead>
              <tbody>
                {sortedMatches.map((m, mi) => (
                  <tr data-extra={mi >= 12 ? '1' : null} hidden={mi >= 12}>
                    <td class="date">{m.date || '—'}</td>
                    <td style="max-width:480px">
                      <details class="mx" id={`match-${keyOf(m)}`}>
                        <summary><span class="topic">{m.topic || '—'}</span></summary>
                        <div class="mx-body">
                          <table>
                            <tbody>
                              {rowsOf(m).map((r) => (
                                <tr>
                                  <td class="rk">{r.rank === 1 ? '1st' : r.rank === 2 ? '2nd' : r.rank === 3 ? '3rd' : r.rank ? `#${r.rank}` : 'DNF'}</td>
                                  <td class="mdl">{r.model}</td>
                                  <td class="num avg">{r.score != null ? `${r.score.toFixed(1)}/10` : '—'}</td>
                                  <td class="prov" style="margin-left:0">{r.provider || '—'}{r.status ? ` · ${r.status}` : ''}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                          <div style="margin-top:6px;color:var(--arena-ink-3);font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px">judge: {judgeOf(m)}{qaLabel(m) ? ` · qa: ${qaLabel(m)}` : ''}</div>
                          {typeof m.drafts === 'number' ? <div style="margin-top:4px;color:var(--arena-ink-3);font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px">drafts: {m.drafts}</div> : null}
                          {m.slug ? <div style="margin-top:4px"><a href={`/blog/${m.slug}/`} style="font-size:13px;text-decoration:none">Read the published post →</a></div> : null}
                        </div>
                      </details>
                    </td>
                    <td><span class="tag">{m.type || '—'}</span></td>
                    <td class="num">{m.lanes_declared ?? rowsOf(m).length}</td>
                    <td><span class="badge">{winnerOf(m)}</span></td>
                    <td class="num avg">{scoreOf(m) != null ? scoreOf(m).toFixed(1) : '—'}</td>
                    <td style="color:var(--arena-ink-2)">{judgeOf(m)}</td>
                    <td class="num" style="color:var(--arena-ink-2)">{m.threshold_met === true ? 'met' : m.threshold_met === false ? 'missed' : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : <div class="empty">No matches recorded yet.</div>}
        {sortedMatches.length > 12 && (
          <div style="margin-top:10px;padding:0 16px 14px">
            <button type="button" id="archiveToggle" class="more-btn" data-state="less" aria-expanded="false">Show more matches ({sortedMatches.length - 12} more)</button>
          </div>
        )}
      </section>

      <section class="pool-section" id="model-pool" aria-label="Model pool">
        <div class="p-head" style="border:none;background:none;padding:0 0 4px;flex-wrap:wrap">
          <h2 style="font-size:18px;font-weight:600;letter-spacing:-0.015em;margin:0;color:var(--arena-ink)">Model pool</h2>
          <span class="note" style="font-size:13px;color:var(--arena-ink-3)">{totalModels} models · {retiredCount} retired · {providers.size} providers</span>
          <span class="spacer"></span>
          <input type="search" id="poolSearch" placeholder="grep model, provider, role…" aria-label="Search model pool" />
        </div>
        <div class="pool-grid" id="poolGrid">
          {poolRows.map((m) => {
            const role = String(m.role || '').toLowerCase();
            const b = availBadge(m.model);
            return (
              <div class="pool-card" data-search={`${m.model} ${m.provider || ''} ${role} ${m.status || ''}`.toLowerCase()}>
                <div class="pc-head">
                  <span class="pc-id">{m.model}</span>
                  <span class={`a ${b.cls}`} style={`font-size:11px;color:${b.cls === 'a-ok' ? 'var(--arena-ok)' : b.cls === 'a-warn' ? 'var(--arena-warn)' : b.cls === 'a-none' ? 'var(--arena-ink-3)' : 'var(--arena-bad)'}`}>{b.label}</span>
                </div>
                <dl>
                  <dt>role</dt><dd><span class={`tag ${role === 'builder' ? 'builder' : ''}`}>{roleLabel[role] || m.role || '—'}</span></dd>
                  <dt>provider</dt><dd>{m.provider || '—'}</dd>
                  <dt>played</dt><dd>{m.played != null ? m.played : '—'}</dd>
                  <dt>avg</dt><dd class="av" style="color:var(--arena-accent-light)">{typeof m.benchmark_score === 'number' ? m.benchmark_score.toFixed(1) : '—'}</dd>
                  <dt>status</dt><dd>{m.status || '—'}</dd>
                </dl>
              </div>
            );
          })}
        </div>

        {Array.isArray(retired_models) && retired_models.length > 0 && (
          <details class="strip">
            <summary><strong>Retired models</strong><span class="sn">{retired_models.length} entries</span></summary>
            <div class="strip-body">
              <table class="dt auto" style="font-size:13px">
                <tbody>
                  {retired_models.map((r) => (
                    <tr><td class="mdl">{r.model}</td><td class="prov" style="margin-left:0">{r.provider || '—'}</td><td style="color:var(--arena-ink-2)">{r.reason || '—'}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}

        {stability?.model_stats && (
          <details class="strip">
            <summary><strong>Availability</strong><span class="sn">updated {stabilityUpdated}</span></summary>
            <div class="strip-body">
              <table class="dt auto" style="font-size:13px">
                <tbody>
                  {Object.entries(stability.model_stats).map(([name, s]) => {
                    const b = availBadge(name);
                    return (
                      <tr>
                        <td class="mdl">{name}</td>
                        <td class={`num ${b.cls}`}>{typeof s.availability === 'number' ? `${s.availability}%` : '—'}</td>
                        <td class="prov" style="margin-left:0">{b.label}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        )}
      </section>

      <details class="strip" id="process-feedback">
        <summary>
          <strong>Process feedback</strong>
          <span class="sn">{feedback.matches.length} analyzed{feedback.cleanRate != null ? ` · ${feedback.cleanRate}% clean` : ''} · {feedback.matches.filter((f) => !f.clean).length} flagged</span>
        </summary>
        <div class="strip-body">
          {feedback.recurring_issues.length > 0 && (
            <div style="margin-bottom:8px">
              {feedback.recurring_issues.map((i) => <span class="issue">{i.issue} ×{i.count}</span>)}
            </div>
          )}
          {feedback.matches.map((f) => (
            <div class="fb-row">
              <div class="fb-top">
                <span style="color:var(--arena-ink)">{f.topic}</span>
                <span class={f.clean ? 'ok' : 'bad'}>{f.clean ? 'Clean' : `${(f.suggestions || []).length} suggestion(s)`}</span>
              </div>
              {!f.clean && (f.suggestions || []).map((s) => <p>[{String(s.severity || '').toUpperCase()}] {s.text}</p>)}
            </div>
          ))}
        </div>
      </details>

      <div class="footline">
        <span>arena_data: <strong>{lastUpdated}</strong></span>
        <span>stability: <strong>{stabilityUpdated}</strong></span>
        <span>router-selection matches excluded</span>
      </div>

    </main>
    <Footer />

    <script is:inline>
      (function () {
        function setOffsets() {
          var header = document.querySelector('header');
          var nav = document.querySelector('.subnav');
          var headerPos = header ? getComputedStyle(header).position : 'static';
          var navH = (headerPos === 'sticky' || headerPos === 'fixed') ? header.offsetHeight : 0;
          document.documentElement.style.setProperty('--nav-h', Math.max(0, navH) + 'px');
          var nh = nav ? nav.getBoundingClientRect().height : 0;
          document.documentElement.style.setProperty('--subnav-h', nh + 'px');
        }
        setOffsets();
        if ('ResizeObserver' in window) new ResizeObserver(setOffsets).observe(document.body);
        window.addEventListener('resize', setOffsets);
        window.addEventListener('load', setOffsets);
      })();

      (function () {
        var links = Array.prototype.slice.call(document.querySelectorAll('.subnav a'));
        if (!links.length) return;
        var ids = links.map(function (a) { return a.getAttribute('href').slice(1); });
        function onScroll() {
          var cur = ids[0];
          for (var i = 0; i < ids.length; i++) {
            var el = document.getElementById(ids[i]);
            if (el && el.getBoundingClientRect().top <= 200) cur = ids[i];
          }
          links.forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === '#' + cur); });
        }
        document.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();

      (function () {
        var input = document.getElementById('poolSearch');
        var grid = document.getElementById('poolGrid');
        if (!input || !grid) return;
        input.addEventListener('input', function () {
          var q = input.value.trim().toLowerCase();
          Array.prototype.forEach.call(grid.querySelectorAll('.pool-card'), function (card) {
            var hay = card.getAttribute('data-search') || '';
            card.hidden = q !== '' && hay.indexOf(q) === -1;
          });
        });
      })();

      (function () {
        var btn = document.getElementById('archiveToggle');
        if (!btn) return;
        var SHOWN = 12;
        var total = document.querySelectorAll('#match-history table.dt > tbody > tr').length;
        btn.addEventListener('click', function () {
          var showingAll = btn.getAttribute('data-state') === 'all';
          var extras = document.querySelectorAll('#match-history table.dt > tbody > tr[data-extra="1"]');
          Array.prototype.forEach.call(extras, function (r) { r.hidden = showingAll; });
          if (showingAll) {
            Array.prototype.forEach.call(extras, function (r) { var d = r.querySelector('details'); if (d) d.open = false; });
          }
          btn.setAttribute('data-state', showingAll ? 'less' : 'all');
          btn.setAttribute('aria-expanded', showingAll ? 'false' : 'true');
          btn.textContent = showingAll ? ('Show more matches (' + (total - SHOWN) + ' more)') : 'Show fewer matches';
        });
      })();

      if (location.hash && location.hash.indexOf('#match-') === 0) {
        var d = document.querySelector(location.hash);
        if (d && d.tagName === 'DETAILS') {
          var row = d.closest('tr');
          if (row && row.hidden) {
            row.hidden = false;
            var b = document.getElementById('archiveToggle');
            if (b && b.getAttribute('data-state') === 'less') {
              b.setAttribute('data-state', 'all');
              b.setAttribute('aria-expanded', 'true');
              b.textContent = 'Show fewer matches';
            }
          }
          d.open = true;
        }
      }
    </script>
  </body>
</html>
