---
// DESIGN B — hermes-tutorials arena page (space-optimized variant)
// Priority: information density. Same content as arena.astro, compressed layout.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import fs from 'fs';
import arenaData from '../data/hermestuts-arena.json';

const { matches, leaderboard, model_pool, stability } = arenaData;

// ── Stats ──
const totalModels = model_pool.length;
const totalProviders = [...new Set(model_pool.map(m => m.provider))].length;
const rankedModels = leaderboard.length;
const totalMatches = matches.length;

// ── Impact ──
let leaderAvg = 0;
let fieldAvg = 0;
if (leaderboard.length > 0) {
  const topQuarter = Math.max(1, Math.ceil(leaderboard.length * 0.25));
  const topModels = leaderboard.slice(0, topQuarter);
  leaderAvg = topModels.reduce((s, m) => s + (m.avgScore ?? 0), 0) / topModels.length;
  fieldAvg = leaderboard.reduce((s, m) => s + (m.avgScore ?? 0), 0) / leaderboard.length;
} else {
  const withScore = model_pool.filter(m => typeof m.benchmark_score === 'number').sort((a, b) => b.benchmark_score - a.benchmark_score);
  if (withScore.length > 0) {
    const topQuarter = Math.max(1, Math.ceil(withScore.length * 0.25));
    leaderAvg = withScore.slice(0, topQuarter).reduce((s, m) => s + m.benchmark_score, 0) / topQuarter;
    fieldAvg = withScore.reduce((s, m) => s + m.benchmark_score, 0) / withScore.length;
  }
}
const gapDelta = leaderAvg - fieldAvg;

// ── Local matches only ──
const localMatches = matches.filter(m => m.type !== 'router-selection');

// ── 30-day match window (UTC, server-side) + archive (winning spec ht-arena-redesign-F) ──
const sortedMatches = [...localMatches].sort((a, b) => String(b.date).localeCompare(String(a.date)));
const nowD = new Date();
const cutoff = new Date(Date.UTC(nowD.getUTCFullYear(), nowD.getUTCMonth(), nowD.getUTCDate() - 30));
const recentMatches = sortedMatches.filter(m => new Date(`${m.date}T00:00:00Z`) >= cutoff);
const archiveMatches = sortedMatches.filter(m => new Date(`${m.date}T00:00:00Z`) < cutoff);
const retiredCount = model_pool.filter(m => m.status === 'retired').length;

// ── Availability badge helper ──
function getAvailabilityBadge(modelName) {
  const stats = stability?.model_stats?.[modelName];
  if (!stats) return { label: 'Unknown', cls: 'avail-unknown' };
  const avail = stats.availability;
  if (avail >= 99) return { label: 'Stable', cls: 'avail-stable' };
  if (avail >= 80) return { label: 'Degraded', cls: 'avail-degraded' };
  if (avail >= 1) return { label: 'Unstable', cls: 'avail-unstable' };
  return { label: 'Down', cls: 'avail-down' };
}

// ── Role badge helper (model pool ROLE column) ──
function getRoleBadge(role) {
  if (!role) return { label: '—', cls: 'role-none' };
  const r = String(role).toLowerCase();
  if (r === 'builder') return { label: 'Builder', cls: 'role-builder' };
  if (r === 'judge') return { label: 'Judge', cls: 'role-judge' };
  if (r === 'qa') return { label: 'QA', cls: 'role-qa' };
  if (r === 'research') return { label: 'Research', cls: 'role-research' };
  if (r === 'planner') return { label: 'Planner', cls: 'role-planner' };
  return { label: String(role), cls: 'role-other' };
}

const lastUpdated = stability?.last_updated ?? 'N/A';

// ── Load process feedback ──
// FIX (DESIGN B): local matches may carry `id` OR `match_id`; feedback entries
// are keyed by `match_id` OR `id`. Match on both, so filtering actually works.
let feedbackData = { matches: [], recurring_issues: [], total_matches_analyzed: 0, clean_match_rate: 0 };
try {
  const raw = JSON.parse(fs.readFileSync('/home/techgeek/.hermes/arena/arena-feedback.json', 'utf-8'));
  const localMatchIds = new Set(localMatches.map(m => m.id ?? m.match_id));
  const localFeedback = raw.matches.filter(fm => localMatchIds.has(fm.match_id ?? fm.id));
  feedbackData = {
    last_updated: raw.last_updated,
    total_matches_analyzed: localFeedback.length,
    clean_match_rate: localFeedback.length > 0
      ? Math.round((localFeedback.filter(m => m.clean).length / localFeedback.length) * 100)
      : 0,
    recurring_issues: raw.recurring_issues || [],
    matches: localFeedback,
  };
} catch (e) {
  // Feedback file not available — skip
}

---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Arena — ${SITE_TITLE}`} description="Model-vs-model battle arena — comparing LLMs on Hermes Agent content and design tasks." />
    <style>
      :root {
        --accent: #6c5ce7;
        --accent-light: #a29bfe;
        --accent-glow: rgba(108, 92, 231, 0.15);
        --bg: #0a0a0b;
        --surface-1: #121214;
        --surface-2: #1a1a1e;
        --surface-3: #202026;
        --border: #1e1e22;
        --border-light: #2a2a30;
        --text: #e8e8ed;
        --text-dim: #a1a1aa;
        --text-muted: #6b6b76;
        --green: #22c55e;
        --red: #ef4444;
        --yellow: #eab308;
        --orange: #f97316;
      }

      /* Nav-aligned container (header caps at min(1800px, 95vw)) */
      .arena-container {
        width: 100%;
        max-width: min(1800px, 95vw);
        margin: 0 auto;
        padding: 0.7em 0 1em;
      }

      /* ── Slim hero strip: title inline with stat tiles, one row ── */
      .hero-strip {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5em 1.2em;
        padding-bottom: 0.55em;
        border-bottom: 1px solid var(--border);
      }
      .hero-strip h1 {
        font-family: 'Atkinson Hyperlegible', sans-serif;
        font-size: clamp(1.3rem, 2vw, 1.65rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0;
        color: #fff;
        white-space: nowrap;
      }
      .hero-strip h1 span { color: var(--accent); }
      .hero-strip .tagline {
        font-size: 0.78em;
        color: var(--text-dim);
        margin: 0;
        flex: 1 1 320px;
        min-width: 0;
      }
      .hero-stats {
        display: flex;
        gap: 0;
        font-size: 0.72em;
        color: var(--text-dim);
        white-space: nowrap;
      }
      .hero-stats .hs {
        display: inline-flex;
        align-items: baseline;
        gap: 0.3em;
      }
      .hero-stats .hs + .hs::before {
        content: '|';
        color: var(--border);
        margin: 0 0.65em;
      }
      .hero-stats strong {
        color: #fff;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        font-size: 1.25em;
      }

      /* ── Above-the-fold duo: Leaderboard (wide) | Latest results (compact) ── */
      .fold-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas: 'leaderboard' 'latest';
        gap: 1em;
        margin-top: 0.9em;
        align-items: start;
      }
      .fold-leaderboard { grid-area: leaderboard; }
      .fold-latest { grid-area: latest; }
      @media (min-width: 1200px) {
        .fold-grid {
          grid-template-columns: minmax(0, 2.1fr) minmax(340px, 1fr);
          grid-template-areas: 'leaderboard latest';
        }
      }

      .section-title {
        font-family: 'Atkinson Hyperlegible', sans-serif;
        font-size: 0.95em;
        font-weight: 600;
        color: #fff;
        margin: 0 0 0.45em;
        letter-spacing: -0.02em;
        display: flex;
        align-items: baseline;
        gap: 0.6em;
      }
      .section-title .st-note {
        font-size: 0.68em;
        font-weight: 400;
        color: var(--text-muted);
        letter-spacing: 0;
      }
      .section-title .st-link {
        font-size: 0.68em;
        font-weight: 400;
        color: var(--accent-light);
        letter-spacing: 0;
        margin-left: auto;
      }
      .section-title .st-link:hover { text-decoration: underline; }

      /* ── Leaderboard table: dense ── */
      .tbl-wrap {
        overflow-x: clip;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
      }
      table.data {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.78em;
      }
      table.data thead {
        background: var(--surface-1);
        position: sticky;
        top: var(--arena-sticky-top, 0);
        z-index: 5;
      }
      table.data th {
        text-align: left;
        padding: 0.32em 0.55em;
        font-weight: 600;
        color: var(--text-dim);
        font-size: 0.7em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
      }
      table.data td {
        padding: 0.26em 0.55em;
        border-bottom: 1px solid var(--border);
        color: var(--text);
        white-space: nowrap;
      }
      table.data tr:last-child td { border-bottom: none; }
      table.data tr:hover td { background: var(--surface-2); filter: brightness(1.1); }
      .rank-cell { font-variant-numeric: tabular-nums; }
      .model-name { color: #fff; font-weight: 600; }
      .provider-tag {
        font-size: 0.68em;
        color: var(--text-muted);
        margin-left: 0.45em;
      }
      .score-wrap { display: flex; align-items: center; gap: 0.5em; }
      .score-num { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--accent-light); min-width: 2.2em; }
      .score-bg {
        flex: 0 0 64px;
        height: 4px;
        background: var(--surface-3);
        border-radius: 2px;
        overflow: hidden;
      }
      .score-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-light)); }
      .wins { color: var(--green); }
      .losses { color: var(--red); }
      .xl-col { display: none; }
      @media (min-width: 1800px) { .xl-col { display: table-cell; } }
      .retired-tag {
        margin-left: 0.45em;
        font-size: 0.62rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-dim);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.05rem 0.45rem;
      }

      /* ── Latest results: compact match cards (above the fold) ── */
      .latest-list { display: grid; gap: 0.5em; }
      .latest-card {
        background: var(--surface-1);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.5em 0.65em;
        display: block;
        color: inherit;
        text-decoration: none;
      }
      .latest-card:hover { border-color: var(--accent); }
      .lc-top {
        display: flex;
        justify-content: space-between;
        gap: 0.6em;
        align-items: baseline;
      }
      .lc-topic {
        font-size: 0.76em;
        font-weight: 600;
        color: #fff;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .lc-date { font-size: 0.66em; color: var(--text-muted); flex-shrink: 0; }
      .lc-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3em;
        margin-top: 0.35em;
        font-size: 0.68em;
      }
      .lc-chip {
        display: inline-flex;
        gap: 0.3em;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.1em 0.4em;
      }
      .lc-chip.win { border-color: var(--accent); color: var(--accent-light); }
      .lc-chip .m { color: var(--text); overflow: hidden; text-overflow: ellipsis; max-width: 14ch; }
      .lc-chip.win .m { color: var(--accent-light); }
      .lc-chip .s { color: var(--text-dim); font-variant-numeric: tabular-nums; }
      .lc-winner {
        font-size: 0.68em;
        color: var(--green);
        margin-top: 0.3em;
      }

      /* ── Role-grouped pool: compact chip grid replaces the 17-row table ── */
      .pool-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 0.7em;
      }
      /* 5 role groups: cap tracks so the row always fills whole (no ragged row) */
      @media (min-width: 1600px) {
        .pool-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
      }
      .pool-group {
        background: var(--surface-1);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.55em 0.65em;
      }
      .pool-group h3 {
        font-size: 0.64em;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        margin: 0 0 0.4em;
        font-weight: 600;
      }
      .pool-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5em;
        padding: 0.16em 0;
        font-size: 0.72em;
      }
      .pool-row .pm { color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .pool-row .pm.is-retired { color: var(--text-muted); }
      .pool-row .ps { color: var(--accent-light); font-variant-numeric: tabular-nums; flex-shrink: 0; }
      .pool-row .pd { color: var(--text-muted); flex-shrink: 0; }
      .retired-dot {
        display: inline-block;
        width: 5px; height: 5px;
        border-radius: 50%;
        background: var(--text-muted);
        margin-right: 0.4em;
        vertical-align: 1px;
      }
      .pool-search {
        width: 100%;
        max-width: 360px;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text);
        padding: 0.4em 0.7em;
        font-size: 0.78em;
        margin: 0 0 0.7em;
        outline: none;
      }
      .pool-search:focus { border-color: var(--accent); }
      .pool-search::placeholder { color: var(--text-muted); }

      /* ── Full match archive: dense rows replace the giant details cards ── */
      .archive-tbl td { font-size: 0.74em; }
      .archive-topic {
        color: var(--text);
        max-width: 52ch;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: block;
      }
      .arch-winner { color: var(--green); }
      .arch-date { color: var(--text-muted); font-variant-numeric: tabular-nums; }
      .arch-score { color: var(--accent-light); font-variant-numeric: tabular-nums; font-weight: 600; }
      details.arch-detail summary { cursor: pointer; }
      .arch-detail .arch-detail-body {
        background: var(--surface-1);
        padding: 0.6em 0.8em;
        font-size: 0.72em;
        white-space: normal;
      }
      .arch-detail .res-line {
        display: flex;
        gap: 0.8em;
        padding: 0.14em 0;
        flex-wrap: wrap;
      }
      .arch-detail .res-line .rk { color: var(--text-muted); min-width: 2.2em; }
      .arch-detail .res-line .md { color: var(--text); min-width: 16ch; }
      .arch-detail .res-line .sc { color: var(--accent-light); font-variant-numeric: tabular-nums; }
      .arch-detail .qa-note { color: var(--text-muted); margin-top: 0.4em; }
      .history-toggle {
        background: var(--surface-2);
        color: var(--accent-light);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.28em 0.9em;
        font-size: 0.72em;
        cursor: pointer;
        margin: 0 0 0.6em;
      }
      .history-toggle:hover { border-color: var(--accent); }

      /* ── Process feedback: collapsed strip ── */
      details.pf-strip {
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-1);
        margin-top: 1em;
      }
      details.pf-strip > summary {
        cursor: pointer;
        padding: 0.55em 0.8em;
        font-size: 0.82em;
        color: var(--text-dim);
        display: flex;
        gap: 0.8em;
        align-items: center;
        list-style: none;
      }
      details.pf-strip > summary::-webkit-details-marker { display: none; }
      details.pf-strip > summary .pf-arrow { transition: transform 0.15s; font-size: 0.8em; }
      details.pf-strip[open] > summary .pf-arrow { transform: rotate(90deg); }
      details.pf-strip > summary strong { color: #fff; font-weight: 600; }
      details.pf-strip > summary .pf-stats { color: var(--text-muted); font-size: 0.92em; }
      .pf-body { padding: 0.2em 0.8em 0.8em; font-size: 0.76em; }
      .pf-body .issue-tag {
        display: inline-block;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.12em 0.45em;
        margin: 0 0.3em 0.3em 0;
      }
      .pf-body .issue-tag em { color: var(--orange); font-style: normal; }
      .pf-match {
        border-top: 1px solid var(--border);
        padding: 0.45em 0;
      }
      .pf-match .fm-head {
        display: flex;
        justify-content: space-between;
        gap: 0.8em;
        align-items: baseline;
      }
      .pf-match .fm-topic { color: var(--text); font-weight: 600; }
      .pf-match .fm-status.clean { color: var(--green); }
      .pf-match .fm-status.issues { color: var(--orange); }
      .pf-match .fm-sugg { color: var(--text-dim); margin: 0.25em 0 0; }
      .pf-match .fm-sugg .sev { font-weight: 700; }
      .pf-match .fm-sugg.hi .sev { color: var(--red); }
      .pf-match .fm-sugg.med .sev { color: var(--yellow); }
      .pf-match .fm-sugg.low .sev { color: var(--text-muted); }

      .last-updated {
        margin-top: 1em;
        font-size: 0.68em;
        color: var(--text-muted);
      }
      .empty-state { color: var(--text-muted); font-size: 0.8em; padding: 1em 0; }
    </style>
  </head>
  <body>
    <Header />
    <main class="arena-container">

      <!-- ── Slim hero strip: identity + key numbers in one row ── -->
      <div class="hero-strip inset">
        <h1><span>Arena</span></h1>
        <p class="tagline">LLMs head-to-head on Hermes Agent content, design & engineering tasks — judged by a multipass model jury.</p>
        <div class="hero-stats">
          <span class="hs"><strong>{totalMatches}</strong> matches</span>
          <span class="hs"><strong>{rankedModels}</strong> ranked</span>
          <span class="hs"><strong>{totalModels}</strong> pool</span>
          <span class="hs"><strong>{retiredCount}</strong> retired</span>
          <span class="hs"><strong>{totalProviders}</strong> providers</span>
        </div>
      </div>

      <!-- ── Above the fold: Leaderboard | Latest match results ── -->
      <div class="fold-grid inset">
        <section class="fold-leaderboard">
          <h2 class="section-title">Leaderboard <span class="st-note">avg judge score / 10</span></h2>
          {leaderboard.length > 0 ? (
            <div class="tbl-wrap">
              <table class="data">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Model</th>
                    <th>Avg</th>
                    <th>Matches</th>
                    <th>W/L</th>
                    <th>Best</th>
                    <th class="xl-col">Provider</th>
                    <th class="xl-col">Uptime</th>
                  </tr>
                </thead>
                <tbody>
                  {leaderboard.map((entry, i) => {
                    const badge = getAvailabilityBadge(entry.model);
                    return (
                      <tr>
                        <td class="rank-cell">{i < 3 ? ['🥇', '🥈', '🥉'][i] : `#${i + 1}`}</td>
                        <td>
                          <span class="model-name">{entry.model}{entry.retired ? <span class="retired-tag">retired</span> : null}</span>
                          {entry.provider && <span class="provider-tag">{entry.provider}</span>}
                        </td>
                        <td>
                          <div class="score-wrap">
                            <span class="score-num">{(entry.avgScore ?? 0).toFixed(1)}</span>
                            <div class="score-bg"><div class="score-fill" style={`width: ${((entry.avgScore ?? 0) / 10) * 100}%`}></div></div>
                          </div>
                        </td>
                        <td>{entry.matches ?? 0}</td>
                        <td><span class="wins">{entry.wins ?? 0}</span>/<span class="losses">{entry.losses ?? 0}</span></td>
                        <td>{(entry.bestScore ?? 0).toFixed(1)}</td>
                        <td class="xl-col">{entry.provider ?? '—'}</td>
                        <td class="xl-col"><span class={`avail-badge ${badge.cls}`}>{badge.label}</span></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="empty-state"><p>No ranked models yet.</p></div>
          )}
        </section>

        <section class="fold-latest" id="latest-results">
          <h2 class="section-title">Latest Results <a class="st-link" href="#match-history">full archive ↓</a></h2>
          <div class="latest-list">
            {sortedMatches.slice(0, 4).map(m => (
              <a class="latest-card" href={`#match-${m.match_id ?? m.id}`}>
                <div class="lc-top">
                  <span class="lc-topic">{m.topic}</span>
                  <span class="lc-date">{m.date}</span>
                </div>
                <div class="lc-row">
                  {(m.results || []).slice().sort((a, b) => (a.rank ?? Infinity) - (b.rank ?? Infinity)).slice(0, 5).map(r => (
                    <span class={`lc-chip ${r.rank === 1 ? 'win' : ''}`}>
                      <span class="m">{r.model}</span>
                      <span class="s">{r.score != null ? r.score.toFixed(1) : '—'}</span>
                    </span>
                  ))}
                </div>
                <div class="lc-winner">⚑ {m.winner}{m.winner_score != null ? ` · ${m.winner_score.toFixed(1)}/10` : ''}</div>
              </a>
            ))}
          </div>
        </section>
      </div>

      <!-- ── Model pool: role-grouped compact grid ── -->
      <section class="section" id="model-pool" style="margin-top:1em">
        <h2 class="section-title">Model Pool <span class="st-note">{totalModels} models · {retiredCount} retired</span></h2>
        <input type="text" class="pool-search" id="poolSearch" placeholder="Search models…" oninput="filterPool()" />
        <div class="pool-grid" id="poolTable">
          {(() => {
            const groups = {};
            for (const m of model_pool) {
              const role = getRoleBadge(m.role).label;
              (groups[role] = groups[role] || []).push(m);
            }
            const order = ['Builder', 'QA', 'QA Fallback', 'Research', 'Judge', 'Planner'];
            const keys = Object.keys(groups).sort((a, b) => {
              const ia = order.indexOf(a), ib = order.indexOf(b);
              return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
            });
            return keys.map(role => (
              <div class="pool-group" data-role-group={role.toLowerCase()}>
                <h3>{role} <span style="color:var(--border)">·</span> {groups[role].length}</h3>
                {groups[role].map(m => (
                  <div class="pool-row" data-provider={m.provider ?? ''} data-model={m.model ?? ''} data-family={m.family ?? ''} data-role={m.role ?? ''}>
                    <span class={`pm ${m.status === 'retired' ? 'is-retired' : ''}`}>
                      {m.status === 'retired' && <span class="retired-dot"></span>}
                      {m.model}
                    </span>
                    {typeof m.benchmark_score === 'number'
                      ? <span class="ps">{m.benchmark_score.toFixed(1)}</span>
                      : <span class="pd">—</span>}
                  </div>
                ))}
              </div>
            ));
          })()}
        </div>
      </section>

      <!-- ── Full match archive: dense sortable-feel table + per-row detail ── -->
      <section class="section" id="match-history" style="margin-top:1em">
        <h2 class="section-title">Match Archive <span class="st-note">last 30 days: {recentMatches.length} · older: {archiveMatches.length}</span></h2>
        {archiveMatches.length > 0 && (
          <button type="button" id="historyToggle" class="history-toggle" aria-expanded="false" data-state="window">
            Show all {localMatches.length} matches
          </button>
        )}
        {localMatches.length > 0 ? (
          <div class="tbl-wrap">
            <table class="data archive-tbl">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Match</th>
                  <th>Winner</th>
                  <th>Top score</th>
                  <th>Lanes</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {sortedMatches.map((m, mi) => {
                  const isRecent = recentMatches.some(rm => (rm.match_id ?? rm.id) === (m.match_id ?? m.id));
                  const id = m.match_id ?? m.id;
                  const top = (m.results || []).slice().sort((a, b) => (a.rank ?? Infinity) - (b.rank ?? Infinity))[0];
                  return (
                    <>
                      <tr class="arch-row" data-windowed={!isRecent ? 'true' : null} hidden={!isRecent}>
                        <td class="arch-date">{m.date}</td>
                        <td>
                          <details class="arch-detail" id={`match-${id}`}>
                            <summary>
                              <span class="archive-topic">{m.topic}</span>
                            </summary>
                            <div class="arch-detail-body">
                              {(m.results || []).slice().sort((a, b) => (a.rank ?? Infinity) - (b.rank ?? Infinity)).map(r => (
                                <div class="res-line">
                                  <span class="rk">{r.status === 'failed' || r.status === 'dnf' ? 'DNF' : r.rank === 1 ? '🥇 1st' : r.rank === 2 ? '🥈 2nd' : r.rank === 3 ? '🥉 3rd' : (r.rank != null ? `#${r.rank}` : '—')}</span>
                                  <span class="md">{r.model}</span>
                                  <span class="sc">{r.score != null ? `${r.score.toFixed(1)}/10` : '—'}</span>
                                  <span style="color:var(--text-muted)">{r.provider}</span>
                                </div>
                              ))}
                              {m.judge?.model && <div class="qa-note">Judged by {m.judge.model}{m.qa?.model ? ` · QA: ${m.qa.model}` : ''}</div>}
                              {m.post && <div class="qa-note"><a href={m.post} style="color:var(--accent-light)">Read the published post →</a></div>}
                            </div>
                          </details>
                        </td>
                        <td class="arch-winner">{m.winner}</td>
                        <td class="arch-score">{top?.score != null ? top.score.toFixed(1) : (m.winner_score != null ? m.winner_score.toFixed(1) : '—')}</td>
                        <td>{m.lanes_declared ?? (m.results?.length ?? '—')}</td>
                        <td></td>
                      </tr>
                    </>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state"><p>No matches recorded yet.</p></div>
        )}
      </section>

      <!-- ── Process feedback: one collapsed strip ── -->
      <details class="pf-strip inset" id="process-feedback">
        <summary>
          <span class="pf-arrow">▶</span>
          <strong>Process Feedback</strong>
          <span class="pf-stats">{feedbackData.matches.length} analyzed · {feedbackData.clean_match_rate}% clean · {feedbackData.matches.filter(m => !m.clean).length} issues found</span>
        </summary>
        <div class="pf-body">
          {feedbackData.recurring_issues.length > 0 && (
            <div style="margin-bottom:0.5em">
              {feedbackData.recurring_issues.map(issue => (
                <span class="issue-tag">{issue.issue} <em>x{issue.count}</em></span>
              ))}
            </div>
          )}
          {feedbackData.matches.map(fm => (
            <div class="pf-match">
              <div class="fm-head">
                <span class="fm-topic">{fm.topic}</span>
                <span class={`fm-status ${fm.clean ? 'clean' : 'issues'}`}>{fm.clean ? 'Clean' : `${fm.suggestions?.length ?? 0} suggestions`}</span>
              </div>
              {!fm.clean && fm.suggestions?.map(s => (
                <p class={`fm-sugg ${s.severity}`}>
                  <span class="sev">[{s.severity.toUpperCase()}]</span> {s.text}
                </p>
              ))}
            </div>
          ))}
        </div>
      </details>

      <div class="last-updated inset">Arena data last updated: <strong>{lastUpdated}</strong></div>

    </main>
    <Footer />

    <script is:inline>
      // ── Match-archive 30-day window expander ──
      (function () {
        var btn = document.getElementById('historyToggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var showing = btn.getAttribute('data-state') === 'window';
          document.querySelectorAll('.arch-row[data-windowed="true"]').forEach(function (d) {
            d.hidden = !showing;
            if (!showing) { var det = d.querySelector('details'); if (det) det.open = false; }
          });
          btn.setAttribute('data-state', showing ? 'all' : 'window');
          btn.setAttribute('aria-expanded', showing ? 'true' : 'false');
          var total = btn.textContent.match(/\d+/);
          btn.textContent = showing ? 'Show last 30 days' : ('Show all ' + (total ? total[0] : '') + ' matches');
        });
      })();

      // ── Sticky thead offset: measure the real header ──
      (function () {
        var header = document.querySelector('header');
        var setStickyOffset = function () {
          var bottom = header ? header.getBoundingClientRect().bottom : 0;
          document.documentElement.style.setProperty('--arena-sticky-top', Math.max(0, bottom) + 'px');
        };
        setStickyOffset();
        if (header && 'ResizeObserver' in window) new ResizeObserver(setStickyOffset).observe(header);
        window.addEventListener('resize', setStickyOffset);
      })();

      // ── Pool search (works across role-grouped chips) ──
      function filterPool() {
        var input = document.getElementById('poolSearch');
        if (!input) return;
        var q = input.value.toLowerCase().trim();
        document.querySelectorAll('#poolTable .pool-row').forEach(function (row) {
          var hay = ['data-provider', 'data-model', 'data-family', 'data-role'].map(function (a) {
            return (row.getAttribute(a) || '').toLowerCase();
          }).join(' ');
          row.style.display = (q === '' || hay.includes(q)) ? '' : 'none';
        });
        // collapse emptied groups
        document.querySelectorAll('#poolTable .pool-group').forEach(function (g) {
          var any = Array.from(g.querySelectorAll('.pool-row')).some(function (r) { return r.style.display !== 'none'; });
          g.style.display = any ? '' : 'none';
        });
      }

      // Deep-link into an archive row expands it
      if (location.hash && location.hash.indexOf('#match-') === 0) {
        var det = document.querySelector(location.hash);
        if (det) {
          var row = det.closest('.arch-row');
          if (row && row.hidden) { row.hidden = false; var b = document.getElementById('historyToggle'); if (b) { b.dataset.state = 'all'; b.setAttribute('aria-expanded', 'true'); b.textContent = 'Show last 30 days'; } }
          det.open = true;
        }
      }
    </script>
  </body>
</html>
