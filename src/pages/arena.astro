---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import fs from 'fs';
import arenaData from '../data/hermestuts-arena.json';

const { matches, leaderboard, model_pool, stability } = arenaData;

// ── Stats ──
const totalModels = model_pool.length;
const totalProviders = [...new Set(model_pool.map(m => m.provider))].length;
const rankedModels = leaderboard.length;
const totalMatches = matches.length;

// ── Impact ──
let leaderAvg = 0;
let fieldAvg = 0;
if (leaderboard.length > 0) {
  const topQuarter = Math.max(1, Math.ceil(leaderboard.length * 0.25));
  const topModels = leaderboard.slice(0, topQuarter);
  leaderAvg = topModels.reduce((s, m) => s + m.avgScore, 0) / topModels.length;
  fieldAvg = leaderboard.reduce((s, m) => s + m.avgScore, 0) / leaderboard.length;
} else {
  // fallback: use model_pool benchmark scores if no matches played yet
  const withScore = model_pool.filter(m => typeof m.benchmark_score === 'number').sort((a, b) => b.benchmark_score - a.benchmark_score);
  if (withScore.length > 0) {
    const topQuarter = Math.max(1, Math.ceil(withScore.length * 0.25));
    leaderAvg = withScore.slice(0, topQuarter).reduce((s, m) => s + m.benchmark_score, 0) / topQuarter;
    fieldAvg = withScore.reduce((s, m) => s + m.benchmark_score, 0) / withScore.length;
  }
}
const gapDelta = leaderAvg - fieldAvg;

// ── Local matches only ──
const localMatches = matches.filter(m => m.type !== 'router-selection');

// ── Provider grouping (for model pool) ──
const providerGroups = model_pool.reduce((acc, m) => {
  if (!acc[m.provider]) acc[m.provider] = [];
  acc[m.provider].push(m);
  return acc;
}, {});

// ── Availability badge helper ──
function getAvailabilityBadge(modelName) {
  const stats = stability?.model_stats?.[modelName];
  if (!stats) return { label: 'Unknown', cls: 'avail-unknown' };
  const avail = stats.availability;
  if (avail >= 99) return { label: 'Stable', cls: 'avail-stable' };
  if (avail >= 80) return { label: 'Degraded', cls: 'avail-degraded' };
  if (avail >= 1) return { label: 'Unstable', cls: 'avail-unstable' };
  return { label: 'Down', cls: 'avail-down' };
}

// ── Rank badge helper ──
function rankBadge(n) {
  if (n === 1) return '\u{1F947}';
  if (n === 2) return '\u{1F948}';
  if (n === 3) return '\u{1F949}';
  return `#${n}`;
}

const lastUpdated = stability?.last_updated ?? 'N/A';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Arena — ${SITE_TITLE}`} description="Model-vs-model battle arena — comparing LLMs on Hermes Agent content and design tasks." />
    <style>
      /* ── Arena Design System (v2 widescreen) ── */
      :root {
        --accent: #6c5ce7;
        --accent-light: #a29bfe;
        --accent-glow: rgba(108, 92, 231, 0.15);
        --bg: #0a0a0b;
        --surface-1: #121214;
        --surface-2: #1a1a1e;
        --surface-3: #202026;
        --border: #1e1e22;
        --border-light: #2a2a30;
        --text: #e8e8ed;
        --text-dim: #a1a1aa;
        --text-muted: #6b6b76;
        --green: #22c55e;
        --red: #ef4444;
        --yellow: #eab308;

        /* Aliases for backward compat with template logic */
        --bg-card: var(--surface-1);
        --bg-table: var(--surface-2);
        --bg-card-hover: var(--surface-2);
      }

      /* ── Container: scales from 1200px → 1600px+ ── */
      .arena-container {
        max-width: min(1400px, 92vw);
        margin: 0 auto;
        padding: 2em 1.5em 2em;
      }

      @media (min-width: 1400px) {
        .arena-container {
          max-width: min(1500px, 90vw);
        }
      }
      @media (min-width: 1600px) {
        .arena-container {
          max-width: min(1550px, 88vw);
        }
      }
      @media (min-width: 1800px) {
        .arena-container {
          max-width: 1600px;
        }
      }

      /* ── Hero ── */
      .arena-hero {
        margin-bottom: 1.5rem;
      }
      .arena-hero h1 {
        font-family: 'Atkinson Hyperlegible', sans-serif;
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.1;
        margin: 0 0 0.3em;
        color: #fff;
      }
      .arena-hero h1 span {
        color: var(--accent);
      }
      .arena-hero .subtitle {
        font-size: clamp(0.95em, 1.2vw, 1.1em);
        color: var(--text-dim);
        margin: 0 0 1em;
        line-height: 1.5;
      }

      /* ── Stats bar: single-row compact with pipe separators ── */
      .stats-bar {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 0;
        padding: 0.6em 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin-bottom: 1.5rem;
      }
      .stat-item {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        font-size: 0.82em;
        color: var(--text-dim);
        white-space: nowrap;
      }
      .stat-item + .stat-item::before {
        content: '|';
        color: var(--border);
        margin: 0 1em;
        font-size: 0.85em;
      }
      .stat-item strong {
        color: #fff;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      /* ── Section headers (tighter gaps: 1.5em) ── */
      .section {
        margin-top: 1.5em;
      }
      .section-title {
        font-family: 'Atkinson Hyperlegible', sans-serif;
        font-size: 1.3em;
        font-weight: 600;
        color: #fff;
        margin: 0 0 0.6em;
        letter-spacing: -0.02em;
      }

      /* ── Impact grid (compact) ── */
      .impact-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6em;
        margin-bottom: 1.5rem;
      }
      .impact-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.75em 1em;
      }
      .impact-card .impact-label {
        font-size: 0.7em;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.1em;
      }
      .impact-card .impact-value {
        font-size: 1.25em;
        font-weight: 700;
        color: #fff;
        font-variant-numeric: tabular-nums;
        line-height: 1.3;
      }
      .impact-card .impact-value.accent {
        color: var(--accent);
      }
      .impact-card .impact-value.green {
        color: var(--green);
      }
      .impact-card .impact-delta {
        font-size: 0.75em;
        color: var(--text-dim);
        margin-top: 0.1em;
      }

      /* ── Leaderboard table ── */
      .arena-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-table);
      }
      .arena-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85em;
      }
      .arena-table thead {
        background: var(--bg-card);
      }
      .arena-table th {
        text-align: left;
        padding: 0.5em 0.65em;
        font-weight: 600;
        color: var(--text-dim);
        font-size: 0.8em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
      }
      .arena-table td {
        padding: 0.4em 0.65em;
        border-bottom: 1px solid var(--border);
        color: var(--text);
        white-space: nowrap;
      }
      .arena-table tr:last-child td {
        border-bottom: none;
      }
      .arena-table tr:hover td {
        background: var(--bg-card-hover);
      }
      .arena-table .rank-cell {
        font-weight: 600;
        text-align: center;
        width: 2.2em;
        font-size: 0.95em;
      }
      .arena-table .model-cell {
        font-weight: 600;
        color: #fff;
      }
      .arena-table .provider-cell {
        color: var(--text-dim);
      }
      .arena-table .score-cell {
        text-align: right;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        min-width: 2.8em;
      }
      .arena-table .score-bar-wrap {
        display: flex;
        align-items: center;
        gap: 0.4em;
        min-width: 100px;
      }
      .arena-table .score-bar-bg {
        flex: 1;
        height: 5px;
        background: var(--border);
        border-radius: 3px;
        overflow: hidden;
      }
      .arena-table .score-bar-fill {
        height: 100%;
        background: var(--accent);
        border-radius: 3px;
        transition: width 0.3s ease;
      }
      .arena-table .matches-cell,
      .arena-table .wl-cell,
      .arena-table .best-cell {
        text-align: center;
        color: var(--text-dim);
      }

      /* ── Empty state ── */
      .empty-state {
        text-align: center;
        padding: 2em 1em;
        color: var(--text-muted);
        font-size: 0.9em;
      }
      .empty-state p {
        margin: 0.3em 0;
      }

      /* ── Match History (tighter summaries) ── */
      .match-list {
        display: flex;
        flex-direction: column;
        gap: 0.4em;
      }
      .match-item {
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--bg-card);
        overflow: hidden;
      }
      .match-item summary {
        padding: 0.6em 0.85em;
        cursor: pointer;
        font-weight: 500;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 0.5em;
        list-style: none;
      }
      .match-item summary::-webkit-details-marker {
        display: none;
      }
      .match-item summary::before {
        content: '\u25B6';
        font-size: 0.65em;
        color: var(--accent);
        transition: transform 0.15s ease;
      }
      .match-item[open] summary::before {
        transform: rotate(90deg);
      }
      .match-item summary .match-type {
        font-size: 0.65em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--accent-light);
        background: var(--accent-glow);
        padding: 0.12em 0.45em;
        border-radius: 4px;
        margin-left: auto;
      }
      .match-item .match-detail {
        padding: 0 0.85em 0.6em;
        font-size: 0.82em;
        color: var(--text-dim);
        line-height: 1.5;
      }
      .match-item .match-detail .signal-list {
        list-style: none;
        padding: 0;
        margin: 0.25em 0;
      }
      .match-item .match-detail .signal-list li {
        padding: 0.12em 0;
      }
      .match-item .match-detail .signal-list li::before {
        content: '- ';
        color: var(--text-muted);
      }
      .match-item .match-detail .suggestion-text {
        border-left: 2px solid var(--accent);
        padding-left: 0.65em;
        margin: 0.25em 0;
      }
      .match-item .match-detail .auto-brief {
        border-left: 2px solid var(--yellow);
        padding-left: 0.65em;
        margin: 0.25em 0;
        font-size: 0.9em;
        color: var(--yellow);
      }
      .match-item .match-detail .clean-badge {
        display: inline-block;
        font-size: 0.72em;
        color: var(--green);
        background: rgba(34, 197, 94, 0.1);
        padding: 0.08em 0.45em;
        border-radius: 4px;
        font-weight: 600;
      }

      /* ── Model Pool table ── */
      .pool-search {
        width: 100%;
        padding: 0.55em 0.8em;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: #fff;
        font-size: 0.85em;
        margin-bottom: 0.6em;
        outline: none;
        transition: border-color 0.15s ease;
      }
      .pool-search:focus {
        border-color: var(--accent);
      }
      .pool-search::placeholder {
        color: var(--text-muted);
      }

      .pool-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-table);
      }
      .pool-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82em;
      }
      .pool-table thead {
        background: var(--bg-card);
      }
      .pool-table th {
        text-align: left;
        padding: 0.5em 0.65em;
        font-weight: 600;
        color: var(--text-dim);
        font-size: 0.8em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--border);
      }
      .pool-table td {
        padding: 0.4em 0.65em;
        border-bottom: 1px solid var(--border);
        color: var(--text);
      }
      .pool-table tr:last-child td {
        border-bottom: none;
      }
      .pool-table tr:hover td {
        background: var(--bg-card-hover);
      }
      .pool-table .provider-cell-group {
        font-weight: 600;
        color: var(--accent-light);
        vertical-align: middle;
      }
      .pool-table .model-name-cell {
        font-weight: 500;
        color: #fff;
      }
      .pool-table .family-cell {
        color: var(--text-dim);
      }
      .pool-table .score-cell {
        font-variant-numeric: tabular-nums;
        color: var(--text);
      }
      .pool-table .no-score {
        color: var(--text-muted);
        font-style: italic;
      }

      /* ── Availability badges ── */
      .avail-badge {
        display: inline-block;
        font-size: 0.7em;
        font-weight: 600;
        padding: 0.12em 0.45em;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .avail-stable {
        color: var(--green);
        background: rgba(34, 197, 94, 0.12);
      }
      .avail-degraded {
        color: var(--yellow);
        background: rgba(234, 179, 8, 0.12);
      }
      .avail-unstable {
        color: #f97316;
        background: rgba(249, 115, 22, 0.12);
      }
      .avail-down {
        color: var(--red);
        background: rgba(239, 68, 68, 0.12);
      }
      .avail-unknown {
        color: var(--text-muted);
        background: rgba(107, 107, 118, 0.1);
      }

      /* ── Feedback section ── */
      .feedback-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6em;
        margin-bottom: 0.75em;
      }
      .feedback-stat {
        flex: 1;
        min-width: 90px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.6em 0.85em;
        text-align: center;
      }
      .feedback-stat .fb-num {
        font-size: 1.2em;
        font-weight: 700;
        color: #fff;
      }
      .feedback-stat .fb-label {
        font-size: 0.7em;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.1em;
      }
      .suggestions-box {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.6em 0.85em;
        margin-bottom: 0.6em;
      }
      .suggestions-box .sug-title {
        font-size: 0.75em;
        font-weight: 600;
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.3em;
      }
      .suggestions-box .sug-item {
        font-size: 0.82em;
        color: var(--text);
        padding: 0.2em 0;
        line-height: 1.4;
      }
      .auto-brief-box {
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-radius: 6px;
        padding: 0.55em 0.85em;
        font-size: 0.8em;
        color: var(--text-dim);
        line-height: 1.4;
      }
      .auto-brief-box .ab-label {
        font-weight: 600;
        color: var(--yellow);
        margin-right: 0.4em;
      }

      /* ── Last Updated ── */
      .last-updated {
        margin-top: 2em;
        text-align: center;
        font-size: 0.75em;
        color: var(--text-muted);
        border-top: 1px solid var(--border);
        padding-top: 1.2em;
      }

      /* ── Responsive ── */
      @media (max-width: 720px) {
        .impact-grid {
          grid-template-columns: 1fr;
        }
        .feedback-bar {
          flex-direction: column;
        }
        .stats-bar {
          flex-wrap: wrap;
        }
        .stat-item + .stat-item::before {
          margin: 0 0.6em;
        }
        .arena-container {
          padding: 1.5em 1em 2em;
        }
      }

      /* ── Widescreen: at 1400px+ show more rows without scrolling ── */
      @media (min-width: 1400px) {
        .arena-table td,
        .arena-table th {
          padding: 0.4em 0.8em;
        }
        .arena-table {
          font-size: 0.88em;
        }
        .pool-table td,
        .pool-table th {
          padding: 0.4em 0.8em;
        }
      }

      /* ── Ultra-wide: at 1800px+ use extra horizontal space ── */
      @media (min-width: 1800px) {
        .arena-table .score-bar-wrap {
          min-width: 140px;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="arena-container">

      <!-- ── Hero ── -->
      <section class="arena-hero">
        <h1><span>Arena</span> — Model Battleground</h1>
        <p class="subtitle">Comparing LLMs head-to-head on Hermes Agent content generation, design, and engineering tasks. Track scores, reliability, and match outcomes.</p>
        <div class="stats-bar">
          <span class="stat-item"><strong>{totalMatches}</strong> matches</span>
          <span class="stat-item"><strong>{totalModels}</strong> models</span>
          <span class="stat-item"><strong>{totalProviders}</strong> providers</span>
          <span class="stat-item"><strong>{rankedModels}</strong> ranked</span>
        </div>
      </section>

      <!-- ── Arena Impact ── -->
      <section class="section">
        <h2 class="section-title">Arena Impact</h2>
        <div class="impact-grid">
          <div class="impact-card">
            <div class="impact-label">Leader Avg</div>
            <div class="impact-value accent">{leaderAvg > 0 ? leaderAvg.toFixed(2) : 'N/A'}</div>
            <div class="impact-delta">Top 25% of ranked models</div>
          </div>
          <div class="impact-card">
            <div class="impact-label">Field Avg</div>
            <div class="impact-value">{fieldAvg > 0 ? fieldAvg.toFixed(2) : 'N/A'}</div>
            <div class="impact-delta">All ranked models</div>
          </div>
          <div class="impact-card">
            <div class="impact-label">Gap Delta</div>
            <div class="impact-value green">{gapDelta > 0 ? `+${gapDelta.toFixed(2)}` : (gapDelta === 0 ? '0.00' : gapDelta.toFixed(2))}</div>
            <div class="impact-delta">Leader advantage over field</div>
          </div>
        </div>
      </section>

      <!-- ── Leaderboard ── -->
      <section class="section">
        <h2 class="section-title">Leaderboard</h2>
        {leaderboard.length > 0 ? (
          <div class="arena-table-wrap">
            <table class="arena-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Model</th>
                  <th>Provider</th>
                  <th>Score</th>
                  <th>Matches</th>
                  <th>W/L</th>
                  <th>Best</th>
                </tr>
              </thead>
              <tbody>
                {leaderboard.map((entry, i) => (
                  <tr>
                    <td class="rank-cell">{i < 3 ? ['🥇', '🥈', '🥉'][i] : `#${i + 1}`}</td>
                    <td class="model-cell">{entry.model}</td>
                    <td class="provider-cell">{entry.provider}</td>
                    <td>
                      <div class="score-bar-wrap">
                        <span class="score-cell">{entry.avgScore.toFixed(1)}</span>
                        <div class="score-bar-bg">
                          <div class="score-bar-fill" style={`width: ${(entry.avgScore / 10) * 100}%`}></div>
                        </div>
                      </div>
                    </td>
                    <td class="matches-cell">{entry.matches}</td>
                    <td class="wl-cell">{entry.wins}/{entry.losses}</td>
                    <td class="best-cell">{entry.bestScore.toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">
            <p>No ranked models yet.</p>
            <p>Leaderboard will populate once arena matches begin.</p>
          </div>
        )}
      </section>

      <!-- ── Match History ── -->
      <section class="section">
        <h2 class="section-title">Match History</h2>
        {localMatches.length > 0 ? (
          <div class="match-list">
            {localMatches.map(m => (
              <details class="match-item">
                <summary>
                  <span>{m.topic}</span>
                  <span class="match-type">{m.type}</span>
                </summary>
                <div class="match-detail">
                  <div><strong>Date:</strong> {m.date}</div>
                  <div><strong>Winner:</strong> {m.winner}</div>
                  {m.results && m.results.length > 0 && (
                    <div class="match-results-list">
                      <strong>Results:</strong>
                      {m.results.sort((a, b) => a.rank - b.rank).map(r => (
                        <div class={`result-entry ${r.rank === 1 ? 'result-winner' : ''}`}>
                          <span class="result-rank">{r.rank === 1 ? '🥇' : r.rank === 2 ? '🥈' : r.rank === 3 ? '🥉' : `#${r.rank}`}</span>
                          <span class="result-model">{r.model}</span>
                          <span class="result-provider">{r.provider}</span>
                          <span class="result-score">{r.score.toFixed(1)}/10</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </details>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No matches recorded yet.</p>
            <p>Match history will appear as arena battles are judged.</p>
          </div>
        )}
      </section>

      <!-- ── Model Pool ── -->
      <section class="section">
        <h2 class="section-title">Model Pool</h2>
        <input type="text" class="pool-search" id="poolSearch" placeholder="Search models by name, provider, or family\u2026" oninput="filterPool()" />
        {model_pool.length > 0 ? (
          <div class="pool-table-wrap">
            <table class="pool-table" id="poolTable">
              <thead>
                <tr>
                  <th>Provider</th>
                  <th>Model</th>
                  <th>Family</th>
                  <th>Score</th>
                  <th>Availability</th>
                </tr>
              </thead>
              <tbody>
                {Object.entries(providerGroups).map(([provider, models]) => (
                  models.map((m, idx) => {
                    const badge = getAvailabilityBadge(m.model);
                    return (
                      <tr data-provider={provider} data-model={m.model} data-family={m.family ?? ''}>
                        {idx === 0 && (
                          <td class="provider-cell-group" rowspan={models.length}>{provider}</td>
                        )}
                        <td class="model-name-cell">{m.model}</td>
                        <td class="family-cell">{m.family ?? '-'}</td>
                        <td class="score-cell">
                          {typeof m.benchmark_score === 'number' ? m.benchmark_score.toFixed(1) : <span class="no-score">--</span>}
                        </td>
                        <td><span class={`avail-badge ${badge.cls}`}>{badge.label}</span></td>
                      </tr>
                    );
                  })
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">
            <p>No models in pool.</p>
          </div>
        )}
      </section>

      <!-- ── Process Feedback ── -->
      <section class="section">
        <h2 class="section-title">Process Feedback</h2>
        <div class="empty-state">
          <p>Process feedback will appear once arena matches are analyzed.</p>
        </div>
      </section>

      <!-- ── Last Updated ── -->
      <div class="last-updated">
        Arena data last updated: <strong>{stability.last_updated || 'N/A'}</strong>
      </div>

    </main>
    <Footer />

    <script is:inline>
      function filterPool() {
        const input = document.getElementById('poolSearch');
        if (!input) return;
        const q = input.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#poolTable tbody tr');
        rows.forEach(row => {
          const provider = row.getAttribute('data-provider') || '';
          const model = row.getAttribute('data-model') || '';
          const family = row.getAttribute('data-family') || '';
          const match = q === '' ||
            provider.toLowerCase().includes(q) ||
            model.toLowerCase().includes(q) ||
            family.toLowerCase().includes(q);
          row.style.display = match ? '' : 'none';
        });
      }
    </script>
  </body>
</html>
