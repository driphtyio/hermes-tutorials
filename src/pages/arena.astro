---
// DESIGN B — hermes-tutorials arena page (space-optimized variant)
// Priority: information density. Same content as arena.astro, compressed layout.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import fs from 'fs';
import arenaData from '../data/hermestuts-arena.json';

const { matches, leaderboard, model_pool, stability } = arenaData;

// ── Stats ──
const totalModels = model_pool.length;
const totalProviders = [...new Set(model_pool.map(m => m.provider))].length;
const rankedModels = leaderboard.length;
const totalMatches = matches.length;

// ── Impact ──
let leaderAvg = 0;
let fieldAvg = 0;
if (leaderboard.length > 0) {
  const topQuarter = Math.max(1, Math.ceil(leaderboard.length * 0.25));
  const topModels = leaderboard.slice(0, topQuarter);
  leaderAvg = topModels.reduce((s, m) => s + (m.avgScore ?? 0), 0) / topModels.length;
  fieldAvg = leaderboard.reduce((s, m) => s + (m.avgScore ?? 0), 0) / leaderboard.length;
} else {
  const withScore = model_pool.filter(m => typeof m.benchmark_score === 'number').sort((a, b) => b.benchmark_score - a.benchmark_score);
  if (withScore.length > 0) {
    const topQuarter = Math.max(1, Math.ceil(withScore.length * 0.25));
    leaderAvg = withScore.slice(0, topQuarter).reduce((s, m) => s + m.benchmark_score, 0) / topQuarter;
    fieldAvg = withScore.reduce((s, m) => s + m.benchmark_score, 0) / withScore.length;
  }
}
const gapDelta = leaderAvg - fieldAvg;

// ── Local matches only ──
const localMatches = matches.filter(m => m.type !== 'router-selection');

// ── Availability badge helper ──
function getAvailabilityBadge(modelName) {
  const stats = stability?.model_stats?.[modelName];
  if (!stats) return { label: 'Unknown', cls: 'avail-unknown' };
  const avail = stats.availability;
  if (avail >= 99) return { label: 'Stable', cls: 'avail-stable' };
  if (avail >= 80) return { label: 'Degraded', cls: 'avail-degraded' };
  if (avail >= 1) return { label: 'Unstable', cls: 'avail-unstable' };
  return { label: 'Down', cls: 'avail-down' };
}

// ── Role badge helper (model pool ROLE column) ──
function getRoleBadge(role) {
  if (!role) return { label: '—', cls: 'role-none' };
  const r = String(role).toLowerCase();
  if (r === 'builder') return { label: 'Builder', cls: 'role-builder' };
  if (r === 'judge') return { label: 'Judge', cls: 'role-judge' };
  if (r === 'qa') return { label: 'QA', cls: 'role-qa' };
  return { label: String(role), cls: 'role-other' };
}

const lastUpdated = stability?.last_updated ?? 'N/A';

// ── Load process feedback ──
// FIX (DESIGN B): local matches may carry `id` OR `match_id`; feedback entries
// are keyed by `match_id` OR `id`. Match on both, so filtering actually works.
let feedbackData = { matches: [], recurring_issues: [], total_matches_analyzed: 0, clean_match_rate: 0 };
try {
  const raw = JSON.parse(fs.readFileSync('/home/techgeek/.hermes/arena/arena-feedback.json', 'utf-8'));
  const localMatchIds = new Set(localMatches.map(m => m.id ?? m.match_id));
  const localFeedback = raw.matches.filter(fm => localMatchIds.has(fm.match_id ?? fm.id));
  feedbackData = {
    last_updated: raw.last_updated,
    total_matches_analyzed: localFeedback.length,
    clean_match_rate: localFeedback.length > 0
      ? Math.round((localFeedback.filter(m => m.clean).length / localFeedback.length) * 100)
      : 0,
    recurring_issues: raw.recurring_issues || [],
    matches: localFeedback,
  };
} catch (e) {
  // Feedback file not available — skip
}

---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Arena — ${SITE_TITLE}`} description="Model-vs-model battle arena — comparing LLMs on Hermes Agent content and design tasks." />
    <style>
      /* ── DESIGN B: space-optimized arena (denser layout, same accent) ── */
      :root {
        --accent: #6c5ce7;
        --accent-light: #a29bfe;
        --accent-glow: rgba(108, 92, 231, 0.15);
        --bg: #0a0a0b;
        --surface-1: #121214;
        --surface-2: #1a1a1e;
        --surface-3: #202026;
        --border: #1e1e22;
        --border-light: #2a2a30;
        --text: #e8e8ed;
        --text-dim: #a1a1aa;
        --text-muted: #6b6b76;
        --green: #22c55e;
        --red: #ef4444;
        --yellow: #eab308;
        --orange: #f97316;
      }

      /* ── Wide container (keep 1900px, tighter padding) ── */
      .arena-container {
        width: 100%;
        max-width: min(1900px, 95vw);
        margin: 0 auto;
        padding: 1em 1.25em 1em;
      }

      /* ── Hero + stats consolidated into ONE compact block ── */
      .arena-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.4em 1.5em;
        padding-bottom: 0.55em;
        border-bottom: 1px solid var(--border);
        margin-bottom: 0.9em;
      }
      .arena-hero h1 {
        font-family: 'Atkinson Hyperlegible', sans-serif;
        font-size: clamp(1.45rem, 2.4vw, 1.9rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin: 0;
        color: #fff;
      }
      .arena-hero h1 span {
        color: var(--accent);
      }
      .arena-hero .subtitle {
        font-size: 0.82em;
        color: var(--text-dim);
        margin: 0.15em 0 0;
        line-height: 1.45;
        max-width: 72ch;
      }

      /* ── Stats bar: inline, compact, pipe separators ── */
      .stats-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0;
        font-size: 0.74em;
        color: var(--text-dim);
        white-space: nowrap;
        margin-left: auto;
      }
      .stat-item {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
      }
      .stat-item + .stat-item::before {
        content: '|';
        color: var(--border);
        margin: 0 0.7em;
        font-size: 0.9em;
      }
      .stat-item strong {
        color: #fff;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      /* ── Sections: minimal margins, small titles ── */
      .section {
        margin-top: 0.9em;
      }
      .section-title {
        font-family: 'Atkinson Hyperlegible', sans-serif;
        font-size: 1.02em;
        font-weight: 600;
        color: #fff;
        margin: 0 0 0.4em;
        letter-spacing: -0.02em;
      }

      /* ── Side-by-side data grid: Leaderboard | Model Pool (wide screens) ── */
      .data-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.9em;
        align-items: start;
      }
      @media (min-width: 1400px) {
        .data-grid {
          grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
        }
      }

      /* ── Leaderboard layout: table + compact Arena Impact side card ── */
      .lb-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.8em;
      }
      @media (min-width: 1100px) {
        .lb-layout {
          grid-template-columns: minmax(0, 1fr) 235px;
        }
      }

      /* ── Arena Impact: merged into Leaderboard as a compact side card ── */
      .impact-card {
        background: var(--surface-1);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.55em 0.7em 0.45em;
        align-self: start;
      }
      .impact-card .impact-head {
        font-size: 0.62em;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        margin: 0 0 0.35em;
        font-weight: 600;
      }
      .impact-metric {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5em;
        padding: 0.3em 0;
        border-top: 1px solid var(--border);
      }
      .impact-metric .impact-label {
        font-size: 0.68em;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .impact-metric .impact-value {
        font-size: 1em;
        font-weight: 700;
        color: #fff;
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
      }
      .impact-metric .impact-value.accent { color: var(--accent-light); }
      .impact-metric .impact-value.green { color: var(--green); }
      .impact-metric .impact-delta {
        font-size: 0.62em;
        color: var(--text-muted);
        display: block;
        text-transform: none;
        letter-spacing: 0;
        font-weight: 400;
      }
      .impact-metric .impact-side {
        text-align: right;
        flex-shrink: 0;
      }

      /* ── Leaderboard table ── */
      .arena-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
      }
      .arena-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.78em;
      }
      .arena-table thead {
        background: var(--surface-1);
      }
      .arena-table th {
        text-align: left;
        padding: 0.35em 0.6em;
        font-weight: 600;
        color: var(--text-dim);
        font-size: 0.7em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
      }
      .arena-table td {
        padding: 0.28em 0.6em;
        border-bottom: 1px solid var(--border);
        color: var(--text);
        white-space: nowrap;
      }
      .arena-table tr:last-child td {
        border-bottom: none;
      }
      .arena-table tr:hover td {
        background: var(--surface-2);
        filter: brightness(1.1);
      }
      .arena-table .rank-cell {
        font-weight: 600;
        text-align: center;
        width: 1.8em;
        font-size: 0.95em;
      }
      .arena-table .model-provider-wrap {
        display: flex;
        align-items: baseline;
        gap: 0.5em;
      }
      .arena-table .model-provider-wrap .model-name {
        font-weight: 600;
        color: #fff;
      }
      .arena-table .model-provider-wrap .provider-tag {
        font-size: 0.75em;
        color: var(--text-muted);
      }
      .arena-table .score-cell {
        text-align: right;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        min-width: 2.4em;
      }
      .arena-table .score-bar-wrap {
        display: flex;
        align-items: center;
        gap: 0.45em;
        min-width: 85px;
      }
      .arena-table .score-bar-bg {
        flex: 1;
        height: 5px;
        background: var(--border);
        border-radius: 3px;
        overflow: hidden;
      }
      .arena-table .score-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--accent), var(--accent-light));
        border-radius: 3px;
      }
      .arena-table .matches-cell,
      .arena-table .wl-cell,
      .arena-table .best-cell {
        text-align: center;
        color: var(--text-dim);
      }
      .arena-table .wl-cell .wins { color: var(--green); }
      .arena-table .wl-cell .losses { color: var(--text-muted); }

      /* ── Model Pool table (compact, with ROLE column) ── */
      .pool-search {
        width: 100%;
        padding: 0.35em 0.6em;
        background: var(--surface-1);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: #fff;
        font-size: 0.75em;
        margin-bottom: 0.4em;
        outline: none;
        transition: border-color 0.15s ease;
        font-family: 'Atkinson Hyperlegible', sans-serif;
      }
      .pool-search:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 2px var(--accent-glow);
      }
      .pool-search::placeholder {
        color: var(--text-muted);
      }
      .pool-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
      }
      .pool-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.75em;
      }
      .pool-table thead {
        background: var(--surface-1);
      }
      .pool-table th {
        text-align: left;
        padding: 0.35em 0.55em;
        font-weight: 600;
        color: var(--text-dim);
        font-size: 0.7em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--border);
      }
      .pool-table td {
        padding: 0.28em 0.55em;
        border-bottom: 1px solid var(--border);
        color: var(--text);
      }
      .pool-table tr:last-child td {
        border-bottom: none;
      }
      .pool-table tr:hover td {
        background: var(--surface-2);
        filter: brightness(1.1);
      }
      .pool-table .model-name-cell {
        font-weight: 500;
        color: #fff;
      }
      .pool-table .family-cell {
        color: var(--text-dim);
      }
      .pool-table .score-cell {
        font-variant-numeric: tabular-nums;
        color: var(--text);
      }
      .pool-table .no-score {
        color: var(--text-muted);
        font-style: italic;
      }

      /* ── Role badges (builder / judge / qa) ── */
      .role-badge {
        display: inline-block;
        font-size: 0.62em;
        font-weight: 600;
        padding: 0.08em 0.4em;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        white-space: nowrap;
      }
      .role-builder { color: var(--accent-light); background: var(--accent-glow); }
      .role-judge { color: var(--green); background: rgba(34, 197, 94, 0.12); }
      .role-qa { color: var(--yellow); background: rgba(234, 179, 8, 0.12); }
      .role-other { color: var(--text-dim); background: rgba(161, 161, 170, 0.1); }
      .role-none { color: var(--text-muted); background: rgba(107, 107, 118, 0.1); }

      /* ── Availability badges ── */
      .avail-badge {
        display: inline-block;
        font-size: 0.62em;
        font-weight: 600;
        padding: 0.08em 0.4em;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        white-space: nowrap;
      }
      .avail-stable { color: var(--green); background: rgba(34, 197, 94, 0.12); }
      .avail-degraded { color: var(--yellow); background: rgba(234, 179, 8, 0.12); }
      .avail-unstable { color: var(--orange); background: rgba(249, 115, 22, 0.12); }
      .avail-down { color: var(--red); background: rgba(239, 68, 68, 0.12); }
      .avail-unknown { color: var(--text-muted); background: rgba(107, 107, 118, 0.1); }

      /* ── Empty state ── */
      .empty-state {
        text-align: center;
        padding: 1em 1em;
        color: var(--text-muted);
        font-size: 0.8em;
        border: 1px dashed var(--border);
        border-radius: 8px;
      }
      .empty-state p {
        margin: 0.15em 0;
      }

      /* ── Match History: tighter cards, inline score chips ── */
      .match-list {
        display: flex;
        flex-direction: column;
        gap: 0.3em;
      }
      .match-item {
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface-1);
        overflow: hidden;
      }
      .match-item summary {
        padding: 0.38em 0.6em;
        cursor: pointer;
        font-weight: 500;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 0.5em;
        list-style: none;
        font-size: 0.78em;
      }
      .match-item summary::-webkit-details-marker {
        display: none;
      }
      .match-item[open] summary .match-arrow {
        transform: rotate(90deg);
      }
      .match-item summary .match-arrow {
        font-size: 0.55em;
        color: var(--accent);
        transition: transform 0.15s ease;
        flex-shrink: 0;
      }
      .match-item summary .match-topic {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .match-item summary .match-type {
        font-size: 0.58em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--accent-light);
        background: var(--accent-glow);
        padding: 0.08em 0.35em;
        border-radius: 4px;
        flex-shrink: 0;
      }
      .match-item summary .match-compact-info {
        display: flex;
        align-items: center;
        gap: 0.45em;
        font-size: 0.72em;
        color: var(--text-dim);
        flex-shrink: 0;
      }
      .match-item summary .match-compact-info .match-winner {
        color: var(--green);
        font-weight: 600;
      }
      .match-item summary .match-compact-info .match-date {
        color: var(--text-muted);
      }
      .match-item summary .match-compact-info .match-top-score {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: var(--accent-light);
      }
      /* inline score chips */
      .match-chips {
        display: flex;
        align-items: center;
        gap: 0.3em;
        flex-shrink: 0;
      }
      .score-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        font-size: 0.7em;
        font-variant-numeric: tabular-nums;
        padding: 0.08em 0.4em;
        border-radius: 999px;
        background: var(--surface-2);
        border: 1px solid var(--border-light);
        color: var(--text-dim);
        white-space: nowrap;
      }
      .score-chip.chip-winner {
        color: var(--green);
        border-color: rgba(34, 197, 94, 0.35);
        background: rgba(34, 197, 94, 0.08);
      }
      .score-chip .chip-model {
        max-width: 16ch;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .score-chip .chip-score {
        font-weight: 700;
        color: #fff;
      }
      .score-chip.chip-winner .chip-score { color: var(--green); }

      .match-item .match-detail {
        padding: 0 0.6em 0.45em;
        font-size: 0.74em;
        color: var(--text-dim);
        line-height: 1.5;
      }
      .match-item .match-detail .match-results-list {
        display: flex;
        flex-direction: column;
        gap: 0.15em;
        margin-top: 0.2em;
      }
      .match-item .match-detail .result-entry {
        display: flex;
        align-items: center;
        gap: 0.5em;
        padding: 0.12em 0.35em;
        border-radius: 4px;
      }
      .match-item .match-detail .result-entry.result-winner {
        background: rgba(34, 197, 94, 0.06);
      }
      .match-item .match-detail .result-entry .result-rank {
        width: 1.5em;
        text-align: center;
        flex-shrink: 0;
      }
      .match-item .match-detail .result-entry .result-model {
        font-weight: 500;
        color: #fff;
        min-width: 12ch;
      }
      .match-item .match-detail .result-entry .result-provider {
        font-size: 0.85em;
        color: var(--text-muted);
      }
      .match-item .match-detail .result-entry .result-score {
        margin-left: auto;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        color: var(--accent-light);
      }
      .match-item .match-detail .match-strengths {
        margin-top: 0.25em;
      }
      .match-item .match-detail .match-strengths .ms-label {
        font-size: 0.62em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
        margin-bottom: 0.05em;
      }
      .match-item .match-detail .match-strengths ul {
        list-style: none;
        padding: 0;
        margin: 0.05em 0;
      }
      .match-item .match-detail .match-strengths ul li {
        padding: 0.05em 0;
        font-size: 0.9em;
      }
      .match-item .match-detail .match-strengths ul li::before {
        content: '\2713 ';
        color: var(--green);
        font-size: 0.8em;
      }

      /* ── Process Feedback (compact) ── */
      .feedback-subtitle {
        font-size: 0.72em;
        color: var(--text-dim);
        margin: -0.2em 0 0.5em;
        line-height: 1.5;
      }
      .feedback-stats-bar {
        display: flex;
        gap: 1.5em;
        padding: 0.35em 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin-bottom: 0.5em;
      }
      .feedback-stat { display: flex; flex-direction: column; gap: 0.05em; }
      .feedback-stat-num { font-size: 0.95em; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }
      .feedback-stat-label { font-size: 0.62em; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
      .recurring-issues {
        background: var(--surface-1);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.4em 0.6em;
        margin-bottom: 0.5em;
        font-size: 0.74em;
      }
      .recurring-issues strong { color: var(--text); }
      .issues-list { display: flex; flex-wrap: wrap; gap: 0.3em; margin-top: 0.2em; }
      .issue-tag {
        font-size: 0.7em;
        padding: 0.12em 0.45em;
        border-radius: 4px;
        background: rgba(234, 179, 8, 0.1);
        color: var(--yellow);
        border: 1px solid rgba(234, 179, 8, 0.2);
      }
      .issue-tag em { font-style: normal; color: var(--text-dim); margin-left: 0.2em; }
      .feedback-matches { display: flex; flex-direction: column; gap: 0.35em; }
      .feedback-match {
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface-1);
        padding: 0.45em 0.6em;
      }
      .feedback-match-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5em;
        margin-bottom: 0.15em;
      }
      .feedback-match-topic { font-size: 0.78em; font-weight: 600; color: #fff; }
      .feedback-match-status {
        font-size: 0.58em;
        padding: 0.1em 0.45em;
        border-radius: 999px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        flex-shrink: 0;
      }
      .status-clean { background: rgba(34, 197, 94, 0.15); color: var(--green); }
      .status-issues { background: rgba(239, 68, 68, 0.15); color: var(--red); }
      .feedback-signals { display: flex; flex-wrap: wrap; gap: 0.25em; margin-bottom: 0.2em; }
      .signal-tag {
        font-size: 0.64em;
        padding: 0.08em 0.35em;
        border-radius: 3px;
        background: var(--surface-2);
        color: var(--text-dim);
        border: 1px solid var(--border-light);
      }
      .feedback-suggestions {
        list-style: none;
        padding: 0;
        margin: 0.1em 0;
        font-size: 0.72em;
      }
      .feedback-suggestions .suggestion {
        padding: 0.08em 0;
        line-height: 1.5;
        color: var(--text-dim);
      }
      .suggestion .suggestion-sev { font-weight: 600; margin-right: 0.3em; }
      .suggestion.high .suggestion-sev { color: var(--red); }
      .suggestion.medium .suggestion-sev { color: var(--yellow); }
      .suggestion.info .suggestion-sev { color: var(--text-muted); }
      .auto-brief {
        margin-top: 0.25em;
        font-size: 0.72em;
        color: var(--text-dim);
        padding: 0.25em 0.45em;
        background: var(--surface-2);
        border-radius: 4px;
        border-left: 2px solid var(--accent);
      }
      .auto-brief strong { color: var(--accent-light); }

      /* ── Last Updated ── */
      .last-updated {
        margin-top: 1em;
        text-align: center;
        font-size: 0.66em;
        color: var(--text-muted);
        border-top: 1px solid var(--border);
        padding-top: 0.7em;
      }
      .last-updated strong {
        color: var(--text-dim);
        font-weight: 500;
      }

      /* ── Responsive ── */
      @media (max-width: 1099px) {
        .lb-layout {
          grid-template-columns: 1fr;
        }
        .impact-card {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 0.5em;
        }
        .impact-card .impact-head {
          grid-column: 1 / -1;
          margin-bottom: 0;
        }
        .impact-metric {
          border-top: none;
          flex-direction: column;
          align-items: flex-start;
          gap: 0.1em;
          padding: 0.15em 0.3em;
        }
      }
      @media (max-width: 720px) {
        .arena-container {
          padding: 0.8em 0.7em 0.8em;
          max-width: 100%;
        }
        .arena-hero {
          flex-direction: column;
          align-items: flex-start;
        }
        .stats-bar {
          margin-left: 0;
        }
        .match-item summary {
          flex-wrap: wrap;
        }
        .match-item summary .match-compact-info {
          width: 100%;
          justify-content: flex-start;
          padding-left: 1.1em;
        }
        .match-chips {
          width: 100%;
          padding-left: 1.1em;
          flex-wrap: wrap;
        }
        .arena-table .score-bar-wrap {
          min-width: 55px;
        }
        .impact-card {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="arena-container">

      <!-- ── Hero + stats (one consolidated block) ── -->
      <section class="arena-hero">
        <div>
          <h1><span>Arena</span> — Model Battleground</h1>
          <p class="subtitle">Comparing LLMs head-to-head on Hermes Agent content generation, design, and engineering tasks. Track scores, reliability, and match outcomes.</p>
        </div>
        <div class="stats-bar">
          <span class="stat-item"><strong>{totalMatches}</strong> matches</span>
          <span class="stat-item"><strong>{totalModels}</strong> models</span>
          <span class="stat-item"><strong>{totalProviders}</strong> providers</span>
          <span class="stat-item"><strong>{rankedModels}</strong> ranked</span>
        </div>
      </section>

      <!-- ── Data grid: Leaderboard (with Impact side card) | Model Pool ── -->
      <div class="data-grid">

        <!-- ── Leaderboard + Arena Impact side card ── -->
        <section class="section">
          <h2 class="section-title">Leaderboard</h2>
          <div class="lb-layout">
            {leaderboard.length > 0 ? (
              <div class="arena-table-wrap">
                <table class="arena-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Model</th>
                      <th>Score</th>
                      <th>Matches</th>
                      <th>W/L</th>
                      <th>Best</th>
                    </tr>
                  </thead>
                  <tbody>
                    {leaderboard.map((entry, i) => (
                      <tr>
                        <td class="rank-cell">{i < 3 ? ['🥇', '🥈', '🥉'][i] : `#${i + 1}`}</td>
                        <td class="model-provider-wrap">
                          <span class="model-name">{entry.model}</span>
                          {entry.provider && <span class="provider-tag">{entry.provider}</span>}
                        </td>
                        <td>
                          <div class="score-bar-wrap">
                            <span class="score-cell">{(entry.avgScore ?? 0).toFixed(1)}</span>
                            <div class="score-bar-bg">
                              <div class="score-bar-fill" style={`width: ${((entry.avgScore ?? 0) / 10) * 100}%`}></div>
                            </div>
                          </div>
                        </td>
                        <td class="matches-cell">{entry.matches ?? 0}</td>
                        <td class="wl-cell"><span class="wins">{entry.wins ?? 0}</span>/<span class="losses">{entry.losses ?? 0}</span></td>
                        <td class="best-cell">{(entry.bestScore ?? 0).toFixed(1)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <div class="empty-state">
                <p>No ranked models yet.</p>
                <p>Leaderboard will populate once arena matches begin.</p>
              </div>
            )}

            <!-- Arena Impact — compact side card merged into Leaderboard -->
            <aside class="impact-card">
              <h3 class="impact-head">Arena Impact</h3>
              <div class="impact-metric">
                <span class="impact-label">Leader Avg</span>
                <span class="impact-side">
                  <span class="impact-value accent">{leaderAvg > 0 ? leaderAvg.toFixed(2) : 'N/A'}</span>
                  <span class="impact-delta">Top 25% of ranked</span>
                </span>
              </div>
              <div class="impact-metric">
                <span class="impact-label">Field Avg</span>
                <span class="impact-side">
                  <span class="impact-value">{fieldAvg > 0 ? fieldAvg.toFixed(2) : 'N/A'}</span>
                  <span class="impact-delta">All ranked models</span>
                </span>
              </div>
              <div class="impact-metric">
                <span class="impact-label">Gap Delta</span>
                <span class="impact-side">
                  <span class="impact-value green">{gapDelta > 0 ? `+${gapDelta.toFixed(2)}` : (gapDelta === 0 ? '0.00' : gapDelta.toFixed(2))}</span>
                  <span class="impact-delta">Leader advantage</span>
                </span>
              </div>
            </aside>
          </div>
        </section>

        <!-- ── Model Pool (searchable, compact table with ROLE column) ── -->
        <section class="section">
          <h2 class="section-title">Model Pool</h2>
          <input type="text" class="pool-search" id="poolSearch" placeholder="Search models by name, provider, family, or role…" oninput="filterPool()" />
          {model_pool.length > 0 ? (
            <div class="pool-table-wrap">
              <table class="pool-table" id="poolTable">
                <thead>
                  <tr>
                    <th>Role</th>
                    <th>Model</th>
                    <th>Provider</th>
                    <th>Family</th>
                    <th>Score</th>
                    <th>Availability</th>
                  </tr>
                </thead>
                <tbody>
                  {model_pool.map(m => {
                    const role = getRoleBadge(m.role);
                    const badge = getAvailabilityBadge(m.model);
                    return (
                      <tr data-provider={m.provider ?? ''} data-model={m.model ?? ''} data-family={m.family ?? ''} data-role={m.role ?? ''}>
                        <td><span class={`role-badge ${role.cls}`}>{role.label}</span></td>
                        <td class="model-name-cell">{m.model}</td>
                        <td class="family-cell">{m.provider}</td>
                        <td class="family-cell">{m.family ?? '-'}</td>
                        <td class="score-cell">
                          {typeof m.benchmark_score === 'number' ? m.benchmark_score.toFixed(1) : <span class="no-score">--</span>}
                        </td>
                        <td><span class={`avail-badge ${badge.cls}`}>{badge.label}</span></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="empty-state">
              <p>No models in pool.</p>
            </div>
          )}
        </section>

      </div>

      <!-- ── Match History (tight cards, inline score chips) ── -->
      <section class="section">
        <h2 class="section-title">Match History</h2>
        {localMatches.length > 0 ? (
          <div class="match-list">
            {localMatches.map(m => (
              <details class="match-item">
                <summary>
                  <span class="match-arrow">▶</span>
                  <span class="match-topic">{m.topic}</span>
                  {m.type && <span class="match-type">{m.type}</span>}
                  <span class="match-chips">
                    {(m.results || []).slice().sort((a, b) => a.rank - b.rank).map(r => (
                      <span class={`score-chip ${r.rank === 1 ? 'chip-winner' : ''}`}>
                        <span class="chip-model">{r.model}</span>
                        <span class="chip-score">{r.score.toFixed(1)}</span>
                      </span>
                    ))}
                  </span>
                  <span class="match-compact-info">
                    {m.winner && <span class="match-winner">&#9878; {m.winner}</span>}
                    {m.date && <span class="match-date">{m.date}</span>}
                    {m.results?.[0]?.score && <span class="match-top-score">{m.results[0].score.toFixed(1)}/10</span>}
                  </span>
                </summary>
                <div class="match-detail">
                  <div><strong>Date:</strong> {m.date}</div>
                  <div><strong>Winner:</strong> {m.winner}</div>
                  {m.results && m.results.length > 0 && (
                    <div class="match-results-list">
                      <strong>Results:</strong>
                      {m.results.slice().sort((a, b) => a.rank - b.rank).map(r => (
                        <div class={`result-entry ${r.rank === 1 ? 'result-winner' : ''}`}>
                          <span class="result-rank">{r.rank === 1 ? '🥇' : r.rank === 2 ? '🥈' : r.rank === 3 ? '🥉' : `#${r.rank}`}</span>
                          <span class="result-model">{r.model}</span>
                          <span class="result-provider">{r.provider}</span>
                          <span class="result-score">{r.score.toFixed(1)}/10</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {m.results?.filter(r => r.strengths?.length > 0).length > 0 && (
                    <div class="match-strengths">
                      <div class="ms-label">Strengths</div>
                      <ul>
                        {m.results.filter(r => r.strengths?.length > 0).slice(0, 2).flatMap(r => r.strengths.slice(0, 3)).map(s => (
                          <li>{s}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </details>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No matches recorded yet.</p>
            <p>Match history will appear as arena battles are judged.</p>
          </div>
        )}
      </section>

      <!-- ── Process Feedback ── -->
      <section class="section">
        <h2 class="section-title">Process Feedback</h2>
        <p class="feedback-subtitle">Automated analysis from arena-process-feedback.py. Tracks brief quality, model compliance, and recurring issues across matches.</p>

        {feedbackData.matches.length > 0 ? (
          <>
            <div class="feedback-stats-bar">
              <div class="feedback-stat">
                <span class="feedback-stat-num">{feedbackData.matches.length}</span>
                <span class="feedback-stat-label">Analyzed</span>
              </div>
              <div class="feedback-stat">
                <span class="feedback-stat-num">{feedbackData.clean_match_rate}%</span>
                <span class="feedback-stat-label">Clean Rate</span>
              </div>
              <div class="feedback-stat">
                <span class="feedback-stat-num">{feedbackData.matches.filter(m => !m.clean).length}</span>
                <span class="feedback-stat-label">Issues Found</span>
              </div>
            </div>

            {feedbackData.recurring_issues.length > 0 && (
              <div class="recurring-issues">
                <strong>Recurring Issues</strong>
                <div class="issues-list">
                  {feedbackData.recurring_issues.map(issue => (
                    <span class="issue-tag">{issue.issue} <em>x{issue.count}</em></span>
                  ))}
                </div>
              </div>
            )}

            <div class="feedback-matches">
              {feedbackData.matches.map(fm => (
                <div class="feedback-match">
                  <div class="feedback-match-header">
                    <span class="feedback-match-topic">{fm.topic}</span>
                    <span class={`feedback-match-status ${fm.clean ? 'status-clean' : 'status-issues'}`}>
                      {fm.clean ? 'Clean' : 'Issues'}
                    </span>
                  </div>
                  {fm.signals?.length > 0 && (
                    <div class="feedback-signals">
                      {fm.signals.map(s => <span class="signal-tag">{s}</span>)}
                    </div>
                  )}
                  {fm.suggestions?.length > 0 && (
                    <ul class="feedback-suggestions">
                      {fm.suggestions.map(s => (
                        <li class={`suggestion ${s.severity}`}>
                          <span class="suggestion-sev">[{s.severity.toUpperCase()}]</span>
                          <span class="suggestion-text">{s.text}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {fm.auto_brief_line && fm.auto_brief_line !== '' && (
                    <div class="auto-brief">
                      <strong>Next brief:</strong> {fm.auto_brief_line}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="empty-state">
            <p>No process feedback available yet.</p>
          </div>
        )}
      </section>

      <!-- ── Last Updated ── -->
      <div class="last-updated">
        Arena data last updated: <strong>{lastUpdated}</strong>
      </div>

    </main>
    <Footer />

    <script is:inline>
      function filterPool() {
        const input = document.getElementById('poolSearch');
        if (!input) return;
        const q = input.value.toLowerCase().trim();
        const rows = document.querySelectorAll('#poolTable tbody tr');
        rows.forEach(row => {
          const provider = row.getAttribute('data-provider') || '';
          const model = row.getAttribute('data-model') || '';
          const family = row.getAttribute('data-family') || '';
          const role = row.getAttribute('data-role') || '';
          const match = q === '' ||
            provider.toLowerCase().includes(q) ||
            model.toLowerCase().includes(q) ||
            family.toLowerCase().includes(q) ||
            role.toLowerCase().includes(q);
          row.style.display = match ? '' : 'none';
        });
      }
    </script>
  </body>
</html>
