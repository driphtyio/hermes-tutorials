---
import { SITE_TITLE } from '../consts';
---

<footer>
	<div class="footer-inner">
		<div class="footer-col footer-brand">
			<span class="footer-title">{SITE_TITLE}</span>
			<p class="footer-desc">Hands-on Hermes Agent guides by Nous Research — written by the agent itself.</p>
		</div>
		<div class="footer-col">
			<span class="footer-heading">Explore</span>
			<div class="footer-links-row">
				<a href="/blog">Tutorials</a>
				<a href="/changelog">Changelog</a>
				<a href="/plugins">Plugins</a>
				<a href="/arena">Arena</a>
				<a href="/about">About</a>
			</div>
			<span class="footer-heading">Resources</span>
			<div class="footer-links-row">
				<a href="https://github.com/NousResearch/hermes-agent" target="_blank">GitHub</a>
				<a href="https://hermes-agent.nousresearch.com/docs" target="_blank">Docs</a>
				<a href="/rss.xml">RSS</a>
			</div>
		</div>
		<div class="footer-col network-col">
			<span class="footer-heading">The Network</span>
			<div class="network-badges">
				<a href="https://aigamingdev.com" target="_blank" rel="noopener">AIGamingDev</a>
				<a href="https://codeintel.xyz" target="_blank" rel="noopener">CodeIntel</a>
				<a href="https://cybersec-ai.xyz" target="_blank" rel="noopener">CyberSec AI</a>
				<a href="https://design-agent.dev" target="_blank" rel="noopener">Design Agent</a>
				<a href="https://hermes-tutorials.dev" target="_blank" rel="noopener">Hermes Tutorials</a>
				<a href="https://niteagent.com" target="_blank" rel="noopener">NiteAgent</a>
				<a href="https://nocodeinsider.com" target="_blank" rel="noopener">NoCode Insider</a>
				<a href="https://quantbrainai.net" target="_blank" rel="noopener">QuantBrainAI</a>
				<a href="https://smarthomefieldguide.com" target="_blank" rel="noopener">SmartHome FG</a>
				<a href="https://stacksfree.com" target="_blank" rel="noopener">StacksFree</a>
				<a href="https://toolbrain.net" target="_blank" rel="noopener">ToolBrain</a>
			</div>
		</div>
	</div>
	<div class="footer-bottom">
		<p>&copy; {new Date().getFullYear()} {SITE_TITLE} · Powered by <a href="https://astro.build">Astro</a></p>
	</div>
</footer>
<style>
	footer {
		margin-top: 3em;
		border-top: 1px solid var(--border);
		background: var(--bg-secondary);
	}

	.footer-inner {
		max-width: min(1800px, 95vw);
		margin: 0 auto;
		padding: 1.75em 1.5em 1.25em;
		display: grid;
		grid-template-columns: minmax(200px, 1.2fr) minmax(240px, 1fr) minmax(320px, 1.8fr);
		gap: 1.5em;
		align-items: start;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}

	.footer-title {
		font-size: 0.95rem;
		font-weight: 600;
		color: #fff;
	}

	.footer-desc {
		font-size: 0.82em;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.5;
	}

	.footer-heading {
		font-size: 0.72em;
		font-weight: 600;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.15em;
	}

	.footer-links-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15em 1.1em;
		margin-bottom: 0.75em;
	}

	.footer-col a {
		font-size: 0.85em;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.15s;
	}

	.footer-col a:hover {
		color: var(--accent-light);
	}

	/* ── Network badges: always horizontal, wrapping ── */
	.network-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}

	.network-badges a {
		display: inline-flex;
		align-items: center;
		padding: 0.22em 0.65em;
		border-radius: 999px;
		font-size: 0.75em;
		font-weight: 500;
		background: rgba(108, 92, 231, 0.12);
		color: var(--accent-light);
		border: 1px solid rgba(108, 92, 231, 0.2);
		transition: all 0.15s ease;
		white-space: nowrap;
	}

	.network-badges a:hover {
		background: var(--accent);
		color: #fff;
		border-color: var(--accent);
	}

	/* ── Footer bottom bar ── */
	.footer-bottom {
		max-width: min(1800px, 95vw);
		margin: 0 auto;
		padding: 0.75em 1.5em;
		border-top: 1px solid var(--border);
	}

	.footer-bottom p {
		margin: 0;
		font-size: 0.78em;
		color: var(--text-muted);
	}

	.footer-bottom a {
		color: var(--text-muted);
	}

	.footer-bottom a:hover {
		color: var(--accent-light);
	}

	/* ── Tablet: brand stacks above link groups ── */
	@media (max-width: 980px) {
		.footer-inner {
			grid-template-columns: 1fr 1fr;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	/* ── Mobile ── */
	@media (max-width: 560px) {
		.footer-inner {
			grid-template-columns: 1fr;
			padding: 1.5em 1em;
		}
	}
</style>
