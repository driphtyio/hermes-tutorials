---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, author, keywords } = post.data;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Person', name: author },
	publisher: {
		'@type': 'Organization', name: 'Hermes Agent Tutorials',
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
	},
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
	...(tags.length > 0 && { keywords: tags.join(', ') }),
	wordCount: readingTime * 200,
	timeRequired: `PT${readingTime}M`,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Tutorials', item: new URL('/blog', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: title, item: canonicalURL.toString() },
	],
};
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} — Hermes Agent Tutorials`}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
			keywords={keywords}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			/* ════════════════════════════════════════════════
			   WIDESCREEN BLOG POST LAYOUT
			   Overrides global 860px main width with a
			   fluid widespan container + 720px prose column.
			   ════════════════════════════════════════════════ */

			/* ── Breadcrumbs ── */
			.breadcrumbs {
				max-width: min(1800px, 90vw);
				margin: 0 auto;
				padding: 0.75em 1em 0;
				font-size: 0.78em;
				color: var(--text-muted);
			}
			.breadcrumbs a { color: var(--text-muted); }
			.breadcrumbs a:hover { color: var(--accent-light); }
			.breadcrumbs .sep { margin: 0 0.35em; color: var(--border-light); }

			/* ── Main: escape global 860px content-width ── */
			main {
				width: 100%;
				max-width: min(1800px, 90vw);
				margin: 0 auto;
				padding: 1.5em 1em;
			}

			/* ── Article Header ── */
			.post-header {
				max-width: 720px;
				margin: 0 auto 1.5em;
				padding: 0.25em 0;
			}
			.post-header h1 {
				font-size: 2.5rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				line-height: 1.1;
				margin: 0 0 0.35em;
			}

			/* ── One-line Stats Bar (author · date · reading time · tags) ── */
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.3em 0.5em;
				color: var(--text-muted);
				font-size: 0.82em;
				margin-bottom: 0.35em;
			}
			.post-meta .tags {
				display: inline-flex;
				flex-wrap: wrap;
				gap: 0.3em;
			}
			.post-meta .meta-dot {
				opacity: 0.35;
				user-select: none;
			}
			.post-meta .last-updated {
				font-style: italic;
			}

			/* ── Description ── */
			.post-desc {
				font-size: 1.1em;
				color: var(--text-secondary);
				line-height: 1.6;
				margin-top: 0.5em;
			}

			/* ── Hero Image: full-width within article ── */
			.hero-image {
				width: 100%;
				margin-bottom: 2em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-md);
			}

			/* ── Prose: 720px centered for readable line length ── */
			.prose {
				max-width: 720px;
				margin: 0 auto;
				padding: 0;
				color: var(--text-primary);
			}
			.prose h2 {
				margin-top: 2em;
			}
			.prose h3 {
				margin-top: 1.2em;
			}
			.prose p {
				margin-bottom: 1.25em;
				line-height: 1.8;
			}

			/* ── TLDR Block (compact aside) ── */
			.tldr-block {
				background: var(--bg-secondary);
				border: 1px solid var(--border);
				border-left: 3px solid var(--accent);
				border-radius: var(--radius-md);
				padding: 1em 1.25em;
				margin: 1.25em 0;
				font-size: 0.9em;
				color: var(--text-secondary);
			}
			.tldr-block strong:first-child {
				color: var(--accent-light);
				text-transform: uppercase;
				font-size: 0.72em;
				letter-spacing: 0.06em;
			}

			/* ── Widescreen Breakpoint Ladder ──
			   1200px → 1440px → 1600px → 1800px → 2000px
			   Progressive padding & typography refinement. ── */
			@media (min-width: 1200px) {
				main {
					padding: 1.5em 2em;
				}
				.breadcrumbs {
					padding: 0.75em 2em 0;
				}
			}
			@media (min-width: 1440px) {
				main {
					padding: 2em 2.5em;
				}
				.breadcrumbs {
					padding: 0.75em 2.5em 0;
				}
				.post-header h1 {
					font-size: 2.8rem;
				}
				.prose {
					font-size: 1.05em;
				}
			}
			@media (min-width: 1600px) {
				main {
					padding: 2em 3em;
				}
				.breadcrumbs {
					padding: 0.75em 3em 0;
				}
			}
			@media (min-width: 1800px) {
				main {
					padding: 2.5em 3em;
				}
				.breadcrumbs {
					padding: 0.75em 3em 0;
				}
			}
			@media (min-width: 2000px) {
				/* Content capped by 90vw — no further widening */
			}

			/* ── Mobile Tightening ── */
			@media (max-width: 720px) {
				.post-header h1 {
					font-size: 2rem;
				}
				.post-header {
					max-width: 100%;
				}
				.prose {
					max-width: 100%;
				}
				main {
					padding: 1em 0.75em;
				}
				.breadcrumbs {
					padding: 0.5em 0.75em 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a><span class="sep">›</span>
			<a href="/blog">Tutorials</a><span class="sep">›</span>
			<span style="color: var(--text-secondary)">{title}</span>
		</nav>
		<main>
			<article itemscope itemtype="https://schema.org/Article">
				<meta itemprop="author" content={author} />
				<meta itemprop="datePublished" content={pubDate.toISOString()} />
				{updatedDate && <meta itemprop="dateModified" content={updatedDate.toISOString()} />}

				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={`Hero image for ${title}`} itemprop="image" />
					</div>
				)}

				<div class="post-header">
					<h1 itemprop="headline">{title}</h1>
					<div class="post-meta">
						<div class="tags">
							{tags.map(tag => <a class="tag" href={`/tags/${tag}`}>{tag}</a>)}
						</div>
						{tags.length > 0 && <span class="meta-dot">·</span>}
						<span>By {author}</span>
						<span class="meta-dot">·</span>
						<FormattedDate date={pubDate} />
						<span class="meta-dot">·</span>
						<span>{readingTime} min read</span>
						{updatedDate && (
							<>
								<span class="meta-dot">·</span>
								<span class="last-updated">Updated <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</div>
					<p class="post-desc" itemprop="description">{description}</p>
				</div>

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
