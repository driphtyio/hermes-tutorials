---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, author, keywords } = post.data;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Person', name: author },
	publisher: {
		'@type': 'Organization', name: 'Hermes Agent Tutorials',
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
	},
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
	...(tags.length > 0 && { keywords: tags.join(', ') }),
	wordCount: readingTime * 200,
	timeRequired: `PT${readingTime}M`,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Tutorials', item: new URL('/blog', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: title, item: canonicalURL.toString() },
	],
};
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} — Hermes Agent Tutorials`}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
			keywords={keywords}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			/* ════════════════════════════════════════════
			   BlogPost.deepseek-v4 — TOC Sidebar + Widescreen
			   ════════════════════════════════════════════ */

			/* ── Escape the 860px global content-width ── */
			main {
				width: 100% !important;
				margin: 0 auto;
				padding: 1.25em 2em 3em;
			}

			/* ── Breadcrumbs ── */
			.breadcrumbs {
				max-width: min(1800px, 90vw);
				margin: 0 auto;
				padding: 0.6em 2em 0;
				font-size: 0.80em;
				color: var(--text-muted);
			}
			.breadcrumbs a { color: var(--text-muted); }
			.breadcrumbs a:hover { color: var(--accent-light); }
			.breadcrumbs .sep { margin: 0 0.4em; color: var(--border-light); }

			/* ── Flex Layout: sidebar + article ── */
			.blog-layout {
				display: flex;
				gap: 2em;
				max-width: 1800px;
				margin: 0 auto;
				align-items: flex-start;
			}

			/* ── Sidebar ── */
			.sidebar {
				position: sticky;
				top: var(--nav-height);
				flex-shrink: 0;
				width: 240px;
				overflow: hidden;
				align-self: flex-start;
				max-height: calc(100vh - var(--nav-height) - 2em);
				transition: max-height 0.35s ease;
			}
			.sidebar.collapsed {
				max-height: 40px;
			}
			.sidebar-inner {
				padding: 1.25em 0 2em;
			}

			/* ── TOC Header ── */
			.toc-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.75em;
				padding-right: 0.25em;
			}
			.toc-header-label {
				font-size: 0.75em;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--text-muted);
			}
			.toc-toggle {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 24px;
				height: 24px;
				padding: 0;
				border: none;
				background: transparent;
				color: var(--text-muted);
				cursor: pointer;
				border-radius: 4px;
				transition: color 0.15s, transform 0.3s ease, background 0.15s;
			}
			.toc-toggle:hover {
				color: var(--accent-light);
				background: var(--bg-tertiary);
			}
			.sidebar.collapsed .toc-toggle {
				transform: rotate(-90deg);
			}

			/* ── TOC Nav ── */
			.toc-nav {
				font-size: 0.82em;
				line-height: 1.5;
			}
			.toc-nav ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.toc-item a {
				display: block;
				padding: 0.35em 0.5em 0.35em 0;
				color: var(--text-secondary);
				text-decoration: none;
				border-radius: 4px;
				transition: color 0.15s, background 0.15s;
				border-left: 2px solid transparent;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.toc-item a:hover {
				color: var(--accent-light);
				background: var(--bg-tertiary);
			}
			.toc-item a.active {
				color: var(--accent-light);
				border-left-color: var(--accent);
				background: rgba(108, 92, 231, 0.08);
				font-weight: 500;
			}
			.toc-item.toc-h3 {
				padding-left: 1em;
			}
			.toc-item.toc-h3 a {
				font-size: 0.92em;
				color: var(--text-muted);
			}
			.toc-item.toc-h3 a.active {
				color: var(--accent-light);
			}

			/* ── Hero Image (full-bleed within article, not constrained by prose) ── */
			.hero-image {
				width: 100%;
				margin-bottom: 1.25em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				max-height: 280px;
				object-fit: cover;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-md);
			}

			/* ── Constrained body: title, stats, prose at readable line-length ── */
			.article-body {
				max-width: 1000px;
			}

			/* ── Post Header ── */
			.post-header {
				margin-bottom: 1.25em;
			}
			.post-header h1 {
				font-size: 2.8rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				line-height: 1.1;
				margin: 0 0 0.3em;
			}

			/* ── One-line stats bar: author · date · reading time · tags ── */
			.post-stats {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.3em 0.6em;
				color: var(--text-muted);
				font-size: 0.84em;
				margin-bottom: 0.6em;
			}
			.post-stats .sep { opacity: 0.3; }
			.post-stats .tag-link {
				display: inline-block;
				padding: 0.06em 0.45em;
				font-size: 0.80em;
				color: var(--accent-light);
				border: 1px solid var(--border-light);
				border-radius: var(--radius-sm);
				text-decoration: none;
				transition: border-color 0.15s, color 0.15s;
			}
			.post-stats .tag-link:hover {
				border-color: var(--accent);
				color: var(--accent-light);
			}
			.last-updated { font-style: italic; }

			/* ── Description ── */
			.post-desc {
				font-size: 1.05em;
				color: var(--text-secondary);
				line-height: 1.6;
				margin: 0 0 1em;
			}

			/* ── Prose ── */
			.prose {
				color: var(--text-primary);
			}
			.prose h2 { margin-top: 2em; }
			.prose h3 { margin-top: 1.2em; }
			.prose p { margin-bottom: 1.2em; line-height: 1.8; }

			/* ── Heading Permalink ── */
			.heading-permalink {
				opacity: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 24px;
				height: 24px;
				margin-left: 0.3em;
				color: var(--text-muted);
				text-decoration: none;
				border-radius: 4px;
				transition: opacity 0.15s, color 0.15s, background 0.15s;
				vertical-align: middle;
				position: relative;
			}
			.prose h2:hover .heading-permalink,
			.prose h3:hover .heading-permalink {
				opacity: 1;
			}
			.heading-permalink:hover {
				color: var(--accent-light);
				background: var(--bg-tertiary);
			}
			.heading-permalink[data-copied="true"]::after {
				content: "Copied!";
				position: absolute;
				top: -1.8em;
				left: 50%;
				transform: translateX(-50%);
				font-size: 0.65em;
				background: var(--bg);
				color: var(--accent-light);
				padding: 0.2em 0.5em;
				border-radius: 4px;
				border: 1px solid var(--border);
				white-space: nowrap;
				font-family: var(--font-sans);
				font-weight: 500;
			}

			/* ── TLDR Callout (compact aside) ── */
			.tldr-block {
				background: var(--bg-secondary);
				border: 1px solid var(--border);
				border-left: 3px solid var(--accent);
				border-radius: var(--radius-md);
				padding: 0.85em 1.15em;
				margin: 1em 0;
				font-size: 0.92em;
				color: var(--text-secondary);
			}
			.tldr-block strong:first-child {
				color: var(--accent-light);
				text-transform: uppercase;
				font-size: 0.70em;
				letter-spacing: 0.06em;
			}

			/* ── Widescreen Breakpoint Ladder ── */
			@media (min-width: 1200px) {
				main { max-width: min(1080px, 90vw); }
			}
			@media (min-width: 1440px) {
				main {
					max-width: none;
					padding: 1.25em 2.5em 3em;
				}
			}
			@media (min-width: 1600px) {
				main { padding: 1.25em 3em 3em; }
			}
			@media (min-width: 1800px) {
				main { padding: 1.25em 3em 3em; }
			}
			@media (min-width: 2000px) {
				main { padding: 1.25em 3em 3em; }
			}

			/* ── Responsive: below 1440px hide sidebar, single column ── */
			@media (max-width: 1439px) {
				.sidebar {
					display: none;
				}
				.blog-layout {
					display: block;
				}
				.article-body {
					max-width: 1000px;
					margin: 0 auto;
				}
			}

			/* ── Mobile ── */
			@media (max-width: 720px) {
				main { padding: 0.75em 1em 2em; }
				.breadcrumbs { padding: 0.4em 1em 0; }
				.post-header h1 { font-size: 2rem; }
				.post-stats { font-size: 0.78em; gap: 0.25em 0.4em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/blog">Tutorials</a><span class="sep">›</span>
			<span style="color: var(--text-secondary)">{title}</span>
		</nav>
		<main>
			<div class="blog-layout">
				<aside class="sidebar" id="sidebar" aria-label="Table of contents">
					<div class="sidebar-inner">
						<div class="toc-header">
							<span class="toc-header-label">On This Page</span>
							<button class="toc-toggle" id="tocToggle" aria-label="Toggle table of contents" type="button">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="6 9 12 15 18 9"/>
								</svg>
							</button>
						</div>
						<nav class="toc-nav" aria-label="Section navigation">
							<ul id="toc-list"></ul>
						</nav>
					</div>
				</aside>
				<article itemscope itemtype="https://schema.org/Article">
					<meta itemprop="author" content={author} />
					<meta itemprop="datePublished" content={pubDate.toISOString()} />
					{updatedDate && <meta itemprop="dateModified" content={updatedDate.toISOString()} />}

					{heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt={`Hero image for ${title}`} itemprop="image" />
						</div>
					)}

					<div class="article-body">
						<div class="post-header">
							<h1 itemprop="headline">{title}</h1>

							<div class="post-stats">
								<span>By {author}</span><span class="sep">·</span>
								<FormattedDate date={pubDate} /><span class="sep">·</span>
								<span>{readingTime} min read</span>
								{updatedDate && <><span class="sep">·</span><span class="last-updated">Updated <FormattedDate date={updatedDate} /></span></>}
								{tags.length > 0 && <><span class="sep">·</span>{tags.map(tag => <a class="tag-link" href={`/tags/${tag}`}>{tag}</a>)}</>}
							</div>

							<p class="post-desc" itemprop="description">{description}</p>
						</div>

						<div class="prose">
							<slot />
						</div>
					</div>
				</article>
			</div>
		</main>
		<Footer />

		<script>
			(function () {
				'use strict';

				/* ── Heading Permalinks ── */
				const headingSelector = '.prose h2, .prose h3';
				const headings = document.querySelectorAll(headingSelector);

				const permalinkSvg =
					'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
						'<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>' +
						'<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>' +
					'</svg>';

				headings.forEach(function (h) {
					if (!h.id) {
						h.id = h.textContent
							.toLowerCase()
							.replace(/[^a-z0-9]+/g, '-')
							.replace(/^-|-$/g, '');
					}

					var link = document.createElement('a');
					link.className = 'heading-permalink';
					link.href = '#' + h.id;
					link.setAttribute('aria-label', 'Link to this section');
					link.innerHTML = permalinkSvg;

					link.addEventListener('click', function (e) {
						e.preventDefault();
						var url = window.location.origin + window.location.pathname + '#' + h.id;
						navigator.clipboard.writeText(url).then(function () {
							link.setAttribute('data-copied', 'true');
							setTimeout(function () { link.removeAttribute('data-copied'); }, 1500);
						}).catch(function () {
							/* fallback: update hash silently */
							window.history.replaceState(null, '', '#' + h.id);
						});
					});

					h.appendChild(link);
				});

				/* ── Table of Contents ── */
				var tocList = document.getElementById('toc-list');
				if (tocList && headings.length > 0) {
					var tocItems = [];
					headings.forEach(function (h) {
						var tag = h.tagName.toLowerCase();
						var item = document.createElement('li');
						item.className = 'toc-item toc-' + tag;
						var a = document.createElement('a');
						a.href = '#' + h.id;
						a.textContent = h.textContent.replace(/#$/, '').trim();
						item.appendChild(a);
						tocItems.push({ el: item, tag: tag, id: h.id, anchor: a });
						tocList.appendChild(item);
					});

					/* ── IntersectionObserver Scrollspy ── */
					var activeLink = null;
					var headingMap = {};
					headings.forEach(function (h) {
						headingMap[h.id] = h;
					});

					var observer = new IntersectionObserver(function (entries) {
						var visible = entries.filter(function (e) { return e.isIntersecting; });
						if (visible.length === 0) return;
						/* pick the topmost visible heading */
						var top = visible.reduce(function (best, e) {
							return e.boundingClientRect.top < best.boundingClientRect.top ? e : best;
						});
						var id = top.target.id;
						/* find corresponding TOC anchor */
						for (var i = 0; i < tocItems.length; i++) {
							if (tocItems[i].id === id) {
								if (activeLink) activeLink.classList.remove('active');
								tocItems[i].anchor.classList.add('active');
								activeLink = tocItems[i].anchor;
								break;
							}
						}
					}, {
						rootMargin: '-80px 0px -60% 0px',
						threshold: 0,
					});

					headings.forEach(function (h) { observer.observe(h); });
				}

				/* ── Sidebar Collapse Toggle ── */
				var sidebar = document.getElementById('sidebar');
				var toggleBtn = document.getElementById('tocToggle');
				if (sidebar && toggleBtn) {
					toggleBtn.addEventListener('click', function () {
						sidebar.classList.toggle('collapsed');
					});
				}
			})();
		</script>
	</body>
</html>
