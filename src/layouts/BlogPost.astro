---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, author, keywords } = post.data;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Person', name: author },
	publisher: {
		'@type': 'Organization', name: 'Hermes Agent Tutorials',
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
	},
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
	...(tags.length > 0 && { keywords: tags.join(', ') }),
	wordCount: readingTime * 200,
	timeRequired: `PT${readingTime}M`,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Tutorials', item: new URL('/blog', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: title, item: canonicalURL.toString() },
	],
};
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} — Hermes Agent Tutorials`}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
			keywords={keywords}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style is:global>
			/* ════════════════════════════════════════════
			   BlogPost.xiaomi-mimo — Integrated TOC Sidebar
			   ════════════════════════════════════════════ */

			/* ── Escape the 860px global content-width ── */
			main {
				width: 100% !important;
				max-width: 1800px;
				margin: 0 auto;
				padding: 1.25em 2em 3em;
			}

			/* ── Flex Layout: sidebar + article ── */
			.blog-layout {
				display: flex;
				gap: 2em;
				max-width: 1800px;
				margin: 0 auto;
				align-items: flex-start;
			}
			.blog-layout > article {
				flex: 1;
				min-width: 0;
			}

			/* ── TOC Sidebar ── */
			.toc-sidebar {
				position: sticky;
				top: var(--nav-height);
				flex-shrink: 0;
				width: 240px;
				overflow: hidden;
				align-self: flex-start;
				max-height: calc(100vh - var(--nav-height));
				padding: 2em 0;
				transition: max-height 0.3s ease;
			}
			.toc-sidebar.collapsed {
				max-height: 40px;
			}

			/* ── TOC Header ── */
			.toc-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.75em;
				padding-right: 0.25em;
			}
			.toc-header-label {
				font-size: 0.75em;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--text-muted);
			}
			.toc-toggle {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 24px;
				height: 24px;
				padding: 0;
				border: none;
				background: transparent;
				color: var(--text-muted);
				cursor: pointer;
				border-radius: 4px;
				transition: color 0.15s, transform 0.3s ease, background 0.15s;
			}
			.toc-toggle:hover {
				color: var(--accent-light);
				background: var(--bg-tertiary);
			}
			.toc-sidebar.collapsed .toc-toggle {
				transform: rotate(-90deg);
			}

			/* ── TOC Navigation ── */
			.toc-nav {
				font-size: 0.82em;
				line-height: 1.5;
			}
			.toc-nav ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.toc-link {
				display: block;
				padding: 0.35em 0.5em 0.35em 0;
				color: var(--text-secondary);
				text-decoration: none;
				border-radius: 4px;
				transition: color 0.15s, background 0.15s;
				border-left: 2px solid transparent;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.toc-link:hover {
				color: var(--accent-light);
				background: var(--bg-tertiary);
			}
			.toc-link.active {
				color: var(--accent-light);
				border-left-color: var(--accent);
				background: rgba(108, 92, 231, 0.08);
				font-weight: 500;
			}
			.toc-nested {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.toc-nested .toc-link {
				padding-left: 1em;
				font-size: 0.92em;
				color: var(--text-muted);
			}
			.toc-nested .toc-link.active {
				color: var(--accent-light);
			}

			/* ── Hero Image ── */
			.hero-image {
				width: 100%;
				margin-bottom: 1.25em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-md);
			}

			/* ── Article Body ── */
			.article-body {
				max-width: 1000px;
			}

			/* ── Post Header ── */
			.post-header {
				margin-bottom: 1.25em;
			}
			.post-header h1 {
				font-size: 2.8rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				line-height: 1.1;
				margin: 0 0 0.3em;
			}

			/* ── One-line stats bar: author · date · reading time · tags ── */
			.post-stats {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.3em 0.6em;
				color: var(--text-muted);
				font-size: 0.84em;
				margin-bottom: 0.6em;
			}
			.post-stats .sep { opacity: 0.3; }
			.post-stats .tag-link {
				display: inline-block;
				padding: 0.06em 0.45em;
				font-size: 0.80em;
				color: var(--accent-light);
				border: 1px solid var(--border-light);
				border-radius: var(--radius-sm);
				text-decoration: none;
				transition: border-color 0.15s, color 0.15s;
			}
			.post-stats .tag-link:hover {
				border-color: var(--accent);
				color: var(--accent-light);
			}
			.last-updated { font-style: italic; }

			/* ── Description ── */
			.post-desc {
				font-size: 1.05em;
				color: var(--text-secondary);
				line-height: 1.6;
				margin: 0 0 1em;
			}

			/* ── Prose (headings need relative for permalink) ── */
			.prose {
				color: var(--text-primary);
			}
			.prose h2 {
				margin-top: 2em;
				position: relative;
			}
			.prose h3 {
				margin-top: 1.2em;
				position: relative;
			}
			.prose p { margin-bottom: 1.2em; line-height: 1.8; }

			/* ── Heading Permalink # icons ── */
			.heading-permalink {
				opacity: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 24px;
				height: 24px;
				margin-left: 0.3em;
				color: var(--text-muted);
				text-decoration: none;
				border-radius: 4px;
				transition: opacity 0.15s, color 0.15s, background 0.15s;
				vertical-align: middle;
				position: relative;
			}
			.prose h2:hover .heading-permalink,
			.prose h3:hover .heading-permalink {
				opacity: 1;
			}
			.heading-permalink:hover {
				color: var(--accent-light);
				background: var(--bg-tertiary);
			}
			.heading-permalink[data-copied="true"]::after {
				content: "Copied!";
				position: absolute;
				top: -1.8em;
				left: 50%;
				transform: translateX(-50%);
				font-size: 0.65em;
				background: var(--bg);
				color: var(--accent-light);
				padding: 0.2em 0.5em;
				border-radius: 4px;
				border: 1px solid var(--border);
				white-space: nowrap;
				font-family: var(--font-sans);
				font-weight: 500;
			}

			/* ── TLDR Callout ── */
			.tldr-block {
				background: var(--bg-secondary);
				border: 1px solid var(--border);
				border-left: 3px solid var(--accent);
				border-radius: var(--radius-md);
				padding: 0.85em 1.15em;
				margin: 1em 0;
				font-size: 0.92em;
				color: var(--text-secondary);
			}
			.tldr-block strong:first-child {
				color: var(--accent-light);
				text-transform: uppercase;
				font-size: 0.70em;
				letter-spacing: 0.06em;
			}

			/* ── Responsive: below 1440px hide sidebar, single column ── */
			@media (max-width: 1439px) {
				.toc-sidebar {
					display: none;
				}
				.blog-layout {
					display: block;
				}
				.article-body {
					max-width: 1000px;
					margin: 0 auto;
				}
			}

			/* ── Mobile ── */
			@media (max-width: 720px) {
				main { padding: 0.75em 1em 2em; }
				.post-header h1 { font-size: 2rem; }
				.post-stats { font-size: 0.78em; gap: 0.25em 0.4em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-layout">
				<aside class="toc-sidebar" id="tocSidebar" aria-label="Table of contents">
					<div class="toc-header">
						<span class="toc-header-label">On This Page</span>
						<button class="toc-toggle" id="tocToggle" aria-label="Toggle table of contents" type="button">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<polyline points="6 9 12 15 18 9"/>
							</svg>
						</button>
					</div>
					<nav class="toc-nav" aria-label="Section navigation">
						<ul id="tocList"></ul>
					</nav>
				</aside>
				<article itemscope itemtype="https://schema.org/Article">
					<meta itemprop="author" content={author} />
					<meta itemprop="datePublished" content={pubDate.toISOString()} />
					{updatedDate && <meta itemprop="dateModified" content={updatedDate.toISOString()} />}

					{heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt={`Hero image for ${title}`} itemprop="image" />
						</div>
					)}

					<div class="article-body">
						<div class="post-header">
							<h1 itemprop="headline">{title}</h1>

							<div class="post-stats">
								<span>By {author}</span><span class="sep">·</span>
								<FormattedDate date={pubDate} /><span class="sep">·</span>
								<span>{readingTime} min read</span>
								{updatedDate && <><span class="sep">·</span><span class="last-updated">Updated <FormattedDate date={updatedDate} /></span></>}
								{tags.length > 0 && <><span class="sep">·</span>{tags.map(tag => <a class="tag-link" href={`/tags/${tag}`}>{tag}</a>)}</>}
							</div>

							<p class="post-desc" itemprop="description">{description}</p>
						</div>

						<div class="prose">
							<slot />
						</div>
					</div>
				</article>
			</div>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				'use strict';

				/* ════════════════════════════════════════════
				   TOC Generation + Scrollspy + Permalinks
				   ════════════════════════════════════════════ */

				var prose = document.querySelector('.prose');
				var tocList = document.getElementById('tocList');
				var sidebar = document.getElementById('tocSidebar');
				var toggleBtn = document.getElementById('tocToggle');

				if (!prose || !tocList) return;

				var headings = prose.querySelectorAll('h2, h3');
				if (headings.length === 0) {
					if (sidebar) sidebar.style.display = 'none';
					return;
				}

				var tocAnchors = [];
				var headingElements = [];

				/* ── Ensure each heading has an id ── */
				headings.forEach(function (h, i) {
					if (!h.id) {
						var text = (h.textContent || '')
							.trim()
							.toLowerCase()
							.replace(/[^a-z0-9]+/g, '-')
							.replace(/^-|-$/g, '');
						h.id = text || ('heading-' + i);
					}
				});

				/* ── Build TOC items (hierarchical nesting) ── */
				var currentH2Item = null;
				headings.forEach(function (h) {
					var tag = h.tagName.toLowerCase();

					if (tag === 'h2') {
						currentH2Item = document.createElement('li');
						currentH2Item.className = 'toc-item toc-item-h2';

						var a = document.createElement('a');
						a.className = 'toc-link';
						a.href = '#' + h.id;
						a.textContent = h.textContent.replace(/#$/, '').trim();

						var nestedUl = document.createElement('ul');
						nestedUl.className = 'toc-nested';

						currentH2Item.appendChild(a);
						currentH2Item.appendChild(nestedUl);
						tocList.appendChild(currentH2Item);
						tocAnchors.push(a);
						headingElements.push(h);
					} else if (tag === 'h3') {
						var li = document.createElement('li');
						li.className = 'toc-item toc-item-h3';

						var a = document.createElement('a');
						a.className = 'toc-link';
						a.href = '#' + h.id;
						a.textContent = h.textContent.replace(/#$/, '').trim();

						li.appendChild(a);

						if (currentH2Item) {
							currentH2Item.querySelector('.toc-nested').appendChild(li);
						} else {
							tocList.appendChild(li);
						}
						tocAnchors.push(a);
						headingElements.push(h);
					}
				});

				/* ── Permalink (#) icons ── */
				var permalinkSvg =
					'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
						'<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>' +
						'<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>' +
					'</svg>';

				headings.forEach(function (h) {
					var link = document.createElement('a');
					link.className = 'heading-permalink';
					link.href = '#' + h.id;
					link.setAttribute('aria-label', 'Copy link to this section');
					link.innerHTML = permalinkSvg;

					link.addEventListener('click', function (e) {
						e.preventDefault();
						var url = window.location.origin + window.location.pathname + '#' + h.id;
						navigator.clipboard.writeText(url).then(function () {
							link.setAttribute('data-copied', 'true');
							setTimeout(function () { link.removeAttribute('data-copied'); }, 1500);
						}).catch(function () {
							window.history.replaceState(null, '', '#' + h.id);
						});
					});

					h.appendChild(link);
				});

				/* ── IntersectionObserver Scrollspy ── */
				var activeLink = null;

				function updateActive(id) {
					tocAnchors.forEach(function (link) {
						var isActive = link.getAttribute('href') === '#' + id;
						link.classList.toggle('active', isActive);
						if (isActive) {
							activeLink = link;
						}
					});
				}

				if (headingElements.length > 0 && typeof IntersectionObserver !== 'undefined') {
					var observer = new IntersectionObserver(function (entries) {
						var visible = entries.filter(function (e) { return e.isIntersecting; });
						if (visible.length === 0) return;

						var top = visible.reduce(function (best, e) {
							return e.boundingClientRect.top < best.boundingClientRect.top ? e : best;
						});

						updateActive(top.target.id);
					}, {
						rootMargin: '-80px 0px -60% 0px',
						threshold: 0,
					});

					headingElements.forEach(function (h) { observer.observe(h); });
				}

				/* ── Sidebar Collapse Toggle ── */
				if (sidebar && toggleBtn) {
					var saved = localStorage.getItem('toc-sidebar-collapsed');
					if (saved === 'true') {
						sidebar.classList.add('collapsed');
					}

					toggleBtn.addEventListener('click', function () {
						sidebar.classList.toggle('collapsed');
						var collapsed = sidebar.classList.contains('collapsed');
						localStorage.setItem('toc-sidebar-collapsed', collapsed ? 'true' : 'false');
					});
				}

				/* ── Smooth scroll on TOC link click ── */
				tocAnchors.forEach(function (link) {
					link.addEventListener('click', function (e) {
						e.preventDefault();
						var id = link.getAttribute('href').slice(1);
						var target = document.getElementById(id);
						if (target) {
							var navHeight = 80;
							var pos = target.getBoundingClientRect().top + window.pageYOffset - navHeight;
							window.scrollTo({ top: pos, behavior: 'smooth' });
							history.replaceState(null, '', '#' + id);
							updateActive(id);
						}
					});
				});

				/* ── Handle initial hash on page load ── */
				if (window.location.hash) {
					var hashId = window.location.hash.slice(1);
					var hashTarget = document.getElementById(hashId);
					if (hashTarget) {
						setTimeout(function () {
							var navHeight = 80;
							var pos = hashTarget.getBoundingClientRect().top + window.pageYOffset - navHeight;
							window.scrollTo({ top: pos, behavior: 'instant' });
							updateActive(hashId);
						}, 100);
					}
				}
			})();
		</script>
	</body>
</html>
