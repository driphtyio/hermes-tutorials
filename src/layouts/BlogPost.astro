---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, author, keywords } = post.data;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  keywords: keywords ? keywords.join(', ') : tags.join(', '),
  image: heroImage ? heroImage.src : undefined,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Tutorials',
      item: 'https://hermes-tutorials.dev/blog',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: title,
      item: `https://hermes-tutorials.dev/blog/${post.slug}`,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body>
    <Header />
    <main>
      <nav class="breadcrumbs">
        <a href="/blog">Tutorials</a>
        <span class="sep">›</span>
        <span>{title}</span>
      </nav>
      <div class="blog-layout">
        <aside class="sidebar" id="sidebar">
          <div class="sidebar-header">
            <span class="sidebar-title">On This Page</span>
            <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle table of contents">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
          </div>
          <nav class="toc-nav">
            <ul id="toc-list"></ul>
          </nav>
        </aside>
        <article>
          {heroImage && (
            <Image
              width={1020}
              height={510}
              src={heroImage}
              alt={title}
              class="hero-image"
            />
          )}
          <div class="post-header">
            <h1>{title}</h1>
            <div class="stats-bar">
              <span class="author">{author}</span>
              <span class="sep">·</span>
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <>
                  <span class="sep">·</span>
                  <span class="updated">Updated <FormattedDate date={updatedDate} /></span>
                </>
              )}
              <span class="sep">·</span>
              <span class="reading-time">{readingTime} min read</span>
              {tags.length > 0 && (
                <>
                  <span class="sep">·</span>
                  <span class="tags">
                    {tags.map((tag) => (
                      <a href={`/tags/${tag}`} class="tag-link">{tag}</a>
                    ))}
                  </span>
                </>
              )}
            </div>
            {description && <p class="post-desc">{description}</p>}
          </div>
          <div class="prose">
            <slot />
          </div>
        </article>
      </div>
    </main>
    <button class="back-up-top" id="back-up-top" aria-label="Back to top">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="19" x2="12" y2="5"></line>
        <polyline points="5 12 12 5 19 12"></polyline>
      </svg>
    </button>
    <Footer />

    <script is:inline>
      (function () {
        var navHeight = 64;

        // ---------- Permalinks + copy ----------
        function slugify(text) {
          return text
            .toLowerCase()
            .replace(/[^\w\s-]/g, '')
            .trim()
            .replace(/\s+/g, '-');
        }

        var headings = document.querySelectorAll('.prose h2, .prose h3');
        headings.forEach(function (heading) {
          if (!heading.id) {
            heading.id = slugify(heading.textContent || '');
          }
          var link = document.createElement('a');
          link.className = 'permalink';
          link.href = '#' + heading.id;
          link.setAttribute('aria-label', 'Permalink to ' + heading.textContent);
          link.innerHTML =
            '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>';
          link.addEventListener('click', function (e) {
            e.preventDefault();
            history.pushState(null, '', '#' + heading.id);
            var copyIcon =
              '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
            link.innerHTML = copyIcon;
            if (navigator.clipboard) {
              navigator.clipboard.writeText(window.location.href).catch(function () {});
            }
            setTimeout(function () {
              link.innerHTML =
                '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>';
            }, 1500);
          });
          heading.appendChild(link);
        });

        // ---------- Code block copy buttons ----------
        document.querySelectorAll('.prose pre').forEach(function (pre) {
          var btn = document.createElement('button');
          btn.className = 'copy-btn';
          btn.setAttribute('aria-label', 'Copy code');
          btn.textContent = 'Copy';
          btn.addEventListener('click', function () {
            var code = pre.querySelector('code');
            var text = code ? code.textContent : pre.textContent;
            if (navigator.clipboard) {
              navigator.clipboard.writeText(text || '').then(function () {
                btn.textContent = 'Copied!';
                setTimeout(function () {
                  btn.textContent = 'Copy';
                }, 1500);
              });
            }
          });
          pre.style.position = 'relative';
          pre.appendChild(btn);
        });

        // ---------- Hash-target scroll ----------
        if (window.location.hash) {
          var target = document.getElementById(window.location.hash.slice(1));
          if (target) {
            setTimeout(function () {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          }
        }

        // ---------- TOC build ----------
        var tocList = document.getElementById('toc-list');
        var tocHeadings = document.querySelectorAll('.prose h2, .prose h3');
        if (tocList) {
          tocHeadings.forEach(function (heading) {
            var li = document.createElement('li');
            li.className = 'toc-item toc-' + heading.tagName.toLowerCase();
            var a = document.createElement('a');
            a.href = '#' + heading.id;
            a.textContent = heading.textContent.replace(/#$/, '').trim();
            a.addEventListener('click', function (e) {
              e.preventDefault();
              var target = document.getElementById(heading.id);
              if (target) {
                var top = target.getBoundingClientRect().top + window.pageYOffset - navHeight - 16;
                window.scrollTo({ top: top, behavior: 'smooth' });
                history.pushState(null, '', '#' + heading.id);
              }
            });
            li.appendChild(a);
            tocList.appendChild(li);
          });
        }

        // ---------- IntersectionObserver scroll-spy ----------
        var tocLinks = tocList ? tocList.querySelectorAll('a') : [];
        if (tocHeadings.length && tocLinks.length) {
          var visible = new Map();
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  visible.set(entry.target.id, entry.boundingClientRect.top);
                } else {
                  visible.delete(entry.target.id);
                }
              });
              var topMost = null;
              var topMostTop = Infinity;
              visible.forEach(function (top, id) {
                if (top < topMostTop) {
                  topMostTop = top;
                  topMost = id;
                }
              });
              if (!topMost) {
                tocHeadings.forEach(function (h) {
                  var rect = h.getBoundingClientRect();
                  if (rect.top < navHeight + 80) {
                    topMost = h.id;
                  }
                });
              }
              tocLinks.forEach(function (a) {
                if (a.getAttribute('href') === '#' + topMost) {
                  a.classList.add('active');
                  var sidebar = document.getElementById('sidebar');
                  if (sidebar) {
                    var linkRect = a.getBoundingClientRect();
                    var sidebarRect = sidebar.getBoundingClientRect();
                    if (linkRect.top < sidebarRect.top || linkRect.bottom > sidebarRect.bottom) {
                      a.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                    }
                  }
                } else {
                  a.classList.remove('active');
                }
              });
            },
            { rootMargin: '-' + (navHeight + 20) + 'px 0px -70% 0px', threshold: 0 }
          );
          tocHeadings.forEach(function (h) {
            observer.observe(h);
          });
        }

        // ---------- Sidebar collapse toggle ----------
        var sidebar = document.getElementById('sidebar');
        var sidebarToggle = document.getElementById('sidebar-toggle');
        // Mobile: start collapsed — the full TOC above the article pushes
        // content down on phones; readers opt in via the toggle.
        if (sidebar && window.matchMedia('(max-width: 1023px)').matches) {
          sidebar.classList.add('collapsed');
        }
        if (sidebarToggle && sidebar) {
          sidebarToggle.addEventListener('click', function () {
            sidebar.classList.toggle('collapsed');
          });
        }

        // ---------- Back-up-top ----------
        var backUpTop = document.getElementById('back-up-top');
        if (backUpTop) {
          function checkScroll() {
            if (window.pageYOffset > 400) {
              backUpTop.classList.add('visible');
            } else {
              backUpTop.classList.remove('visible');
            }
          }
          window.addEventListener('scroll', checkScroll, { passive: true });
          checkScroll();
          backUpTop.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      })();
    </script>

    <style>
      :root {
        --canvas: #0a0a0b;
        --bg-secondary: #121214;
        --accent: #6c5ce7;
        --accent-glow: rgba(108, 92, 231, 0.25);
        --text: #e8e8ea;
        --text-muted: #8a8a93;
        --border: #1f1f23;
        --border-light: #2a2a30;
        --nav-height: 64px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        background: var(--canvas);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        line-height: 1.7;
      }

      main {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* ---------- Breadcrumbs ---------- */
      .breadcrumbs {
        padding: 24px 0 8px;
        font-size: 0.875rem;
        color: var(--text-muted);
      }
      .breadcrumbs a {
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .breadcrumbs a:hover {
        color: var(--accent);
      }
      .breadcrumbs .sep {
        margin: 0 8px;
        color: var(--text-muted);
        opacity: 0.6;
      }

      /* ---------- Layout ---------- */
      .blog-layout {
        display: flex;
        gap: 40px;
        align-items: flex-start;
        padding-bottom: 80px;
      }

      /* ---------- Sidebar / TOC ---------- */
      .sidebar {
        position: sticky;
        top: calc(var(--nav-height) + 24px);
        width: 240px;
        flex-shrink: 0;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-right: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 16px;
        max-height: calc(100vh - var(--nav-height) - 48px);
        overflow-y: auto;
        overflow-x: hidden;
        transition: max-height 0.3s ease, padding 0.3s ease, opacity 0.3s ease;
      }
      .sidebar.collapsed .toc-nav {
        display: none;
      }
      /* Collapsed state: header becomes a tappable row */
      .sidebar.collapsed {
        padding-bottom: 16px;
        cursor: pointer;
      }
      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
      }
      /* Touch devices: permalinks always visible (no hover to reveal them) */
      @media (hover: none) {
        .prose h2 .permalink,
        .prose h3 .permalink {
          opacity: 0.35;
        }
      }
      .sidebar-title {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }
      .sidebar-toggle {
        background: transparent;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: color 0.2s ease, transform 0.3s ease, background 0.2s ease;
      }
      .sidebar-toggle:hover {
        color: var(--accent);
        background: rgba(108, 92, 231, 0.08);
      }
      .sidebar.collapsed .sidebar-toggle {
        transform: rotate(-90deg);
      }
      .toc-nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .toc-item {
        margin: 0;
      }
      .toc-item a {
        display: block;
        padding: 6px 10px;
        font-size: 0.8125rem;
        color: var(--text-muted);
        text-decoration: none;
        border-left: 2px solid transparent;
        border-radius: 0 4px 4px 0;
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
        line-height: 1.4;
      }
      .toc-item a:hover {
        color: var(--text);
      }
      .toc-item a.active {
        color: var(--accent);
        border-left-color: var(--accent);
        background: rgba(108, 92, 231, 0.08);
        font-weight: 500;
      }
      .toc-h3 a {
        padding-left: 22px;
        font-size: 0.78125rem;
      }

      /* ---------- Article ---------- */
      article {
        flex: 1;
        max-width: 1000px;
        min-width: 0;
      }

      .hero-image {
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 32px;
      }

      .post-header {
        margin-bottom: 40px;
      }
      .post-header h1 {
        font-size: 2.5rem;
        line-height: 1.2;
        margin: 0 0 16px;
        letter-spacing: -0.02em;
      }
      .stats-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 0.875rem;
        color: var(--text-muted);
        margin-bottom: 16px;
      }
      .stats-bar .sep {
        opacity: 0.5;
      }
      .tag-link {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.8125rem;
        transition: opacity 0.2s ease;
      }
      .tag-link:hover {
        opacity: 0.75;
      }
      .tags {
        display: inline-flex;
        gap: 8px;
        flex-wrap: wrap;
      }
      .post-desc {
        font-size: 1.125rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 0;
      }

      /* ---------- Prose ---------- */
      .prose {
        font-size: 1.0625rem;
        line-height: 1.75;
      }
      .prose h2 {
        font-size: 1.75rem;
        margin: 48px 0 20px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
        letter-spacing: -0.01em;
        position: relative;
        scroll-margin-top: calc(var(--nav-height) + 24px);
      }
      .prose h3 {
        font-size: 1.375rem;
        margin: 36px 0 16px;
        letter-spacing: -0.01em;
        position: relative;
        scroll-margin-top: calc(var(--nav-height) + 24px);
      }
      .prose h2 .permalink,
      .prose h3 .permalink {
        display: inline-flex;
        align-items: center;
        margin-left: 8px;
        color: var(--text-muted);
        opacity: 0;
        text-decoration: none;
        transition: opacity 0.2s ease, color 0.2s ease;
        vertical-align: middle;
      }
      .prose h2:hover .permalink,
      .prose h3:hover .permalink {
        opacity: 1;
      }
      .prose h2 .permalink:hover,
      .prose h3 .permalink:hover {
        color: var(--accent);
      }
      .prose p {
        margin: 0 0 20px;
      }
      .prose a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid rgba(108, 92, 231, 0.3);
        transition: border-color 0.2s ease;
      }
      .prose a:hover {
        border-bottom-color: var(--accent);
      }
      .prose ul,
      .prose ol {
        margin: 0 0 20px;
        padding-left: 24px;
      }
      .prose li {
        margin-bottom: 8px;
      }
      .prose blockquote {
        margin: 24px 0;
        padding: 16px 20px;
        background: var(--bg-secondary);
        border-left: 3px solid var(--accent);
        border-radius: 0 8px 8px 0;
        color: var(--text-muted);
      }
      .prose blockquote p:last-child {
        margin-bottom: 0;
      }
      .prose code {
        font-family: 'SF Mono', Menlo, Consolas, monospace;
        font-size: 0.875em;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        padding: 2px 6px;
        border-radius: 4px;
      }
      .prose pre {
        margin: 24px 0;
        padding: 20px;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow-x: auto;
      }
      .prose pre code {
        background: transparent;
        border: none;
        padding: 0;
        font-size: 0.875rem;
        line-height: 1.6;
      }
      .prose .copy-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        background: var(--canvas);
        border: 1px solid var(--border-light);
        color: var(--text-muted);
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 4px;
        cursor: pointer;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .prose .copy-btn:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .prose table {
        width: 100%;
        border-collapse: collapse;
        margin: 24px 0;
        font-size: 0.9375rem;
      }
      .prose th,
      .prose td {
        padding: 10px 14px;
        border: 1px solid var(--border);
        text-align: left;
      }
      .prose th {
        background: var(--bg-secondary);
        font-weight: 600;
      }
      .prose hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 40px 0;
      }
      .prose .tldr {
        background: var(--bg-secondary);
        border: 1px solid var(--border-light);
        border-left: 3px solid var(--accent);
        border-radius: 0 8px 8px 0;
        padding: 16px 20px;
        margin: 24px 0;
      }

      /* ---------- Back-up-top ---------- */
      .back-up-top {
        position: fixed;
        bottom: 24px;
        left: 24px;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-secondary);
        border: 1px solid var(--border-light);
        border-radius: 50%;
        color: var(--text-muted);
        cursor: pointer;
        opacity: 0;
        pointer-events: none;
        transform: translateY(8px);
        transition: opacity 0.3s ease, transform 0.3s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        z-index: 50;
      }
      .back-up-top.visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
      }
      .back-up-top:hover {
        color: var(--accent);
        border-color: var(--accent);
        box-shadow: 0 0 16px var(--accent-glow);
      }

      /* ---------- Responsive ---------- */
      @media (max-width: 1023px) {
        .blog-layout {
          flex-direction: column;
          gap: 24px;
        }
        .sidebar {
          position: relative;
          top: 0;
          width: 100%;
          max-height: none;
          border-right: 1px solid var(--border);
        }
        .sidebar.collapsed .toc-nav {
          display: none;
        }
        .post-header h1 {
          font-size: 1.875rem;
        }
        .hero-image {
          max-height: 280px;
        }
        /* 44px minimum tap targets (Apple HIG / WCAG 2.5.5) */
        .back-up-top {
          width: 44px;
          height: 44px;
          bottom: 16px;
          left: 16px;
        }
        .prose .copy-btn {
          padding: 8px 14px;
          font-size: 0.8125rem;
        }
        .prose pre {
          -webkit-overflow-scrolling: touch;
        }
        /* Prevent iOS auto-zoom on focus (<16px inputs trigger it) */
        .search-input {
          font-size: 16px;
        }
      }

      @media (min-width: 1024px) {
        .sidebar.collapsed {
          width: 240px;
        }
      }
    </style>
  </body>
</html>