---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, author, keywords } = post.data;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Person', name: author },
	publisher: {
		'@type': 'Organization', name: 'Hermes Agent Tutorials',
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
	},
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
	...(tags.length > 0 && { keywords: tags.join(', ') }),
	wordCount: readingTime * 200,
	timeRequired: `PT${readingTime}M`,
};

---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} — Hermes Agent Tutorials`}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
			keywords={keywords}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<style is:global>
			/* ════════════════════════════════════════════
			   BlogPost.astro — Widescreen + Space Optimized
			   ════════════════════════════════════════════ */

			/* ── Escape the 860px global content-width ── */
			.blog-post-main {
				width: 100% !important;
				max-width: min(1800px, 90vw);
				margin: 0 auto;
				padding: 1.25em 2em 3em;
			}

			/* ── Hero Image (full-bleed within article, not constrained by prose) ── */
			.hero-image {
				width: 100%;
				margin-bottom: 1.25em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-md);
			}

			/* ── Constrained body: title, stats, prose at readable line-length ── */
			.article-body {
				max-width: 1000px;
				margin: 0 auto;
			}

			/* ── Post Header ── */
			.post-header {
				margin-bottom: 1.25em;
			}
			.post-header h1 {
				font-size: 2.8rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				line-height: 1.1;
				margin: 0 0 0.3em;
			}

			/* ── One-line stats bar: author · date · reading time · tags ── */
			.post-stats {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.3em 0.6em;
				color: var(--text-muted);
				font-size: 0.84em;
				margin-bottom: 0.6em;
			}
			.post-stats .sep { opacity: 0.3; }
			.post-stats .tag-link {
				display: inline-block;
				padding: 0.06em 0.45em;
				font-size: 0.80em;
				color: var(--accent-light);
				border: 1px solid var(--border-light);
				border-radius: var(--radius-sm);
				text-decoration: none;
				transition: border-color 0.15s, color 0.15s;
			}
			.post-stats .tag-link:hover {
				border-color: var(--accent);
				color: var(--accent-light);
			}
			.last-updated { font-style: italic; }

			/* ── Description ── */
			.post-desc {
				font-size: 1.05em;
				color: var(--text-secondary);
				line-height: 1.6;
				margin: 0 0 1em;
			}

			/* ── Prose ── */
			.prose {
				color: var(--text-primary);
			}
			.prose h2 { margin-top: 2em; }
			.prose h3 { margin-top: 1.2em; }
			.prose p { margin-bottom: 1.2em; line-height: 1.8; }

			/* ── TLDR Callout (compact aside) ── */
			.tldr-block {
				background: var(--bg-secondary);
				border: 1px solid var(--border);
				border-left: 3px solid var(--accent);
				border-radius: var(--radius-md);
				padding: 0.85em 1.15em;
				margin: 1em 0;
				font-size: 0.92em;
				color: var(--text-secondary);
			}
			.tldr-block strong:first-child {
				color: var(--accent-light);
				text-transform: uppercase;
				font-size: 0.70em;
				letter-spacing: 0.06em;
			}

			/* ── Widescreen Breakpoint Ladder ──
			     Each step expands main to ~90% of viewport width.
			     At 1920px: 90vw = 1728px, capped by min(1800px, 90vw) = 1728px (~90%). */
			@media (min-width: 1200px) {
				.blog-post-main { max-width: min(1080px, 90vw); }
			}
			@media (min-width: 1440px) {
				.blog-post-main { max-width: min(1296px, 90vw); }
			}
			@media (min-width: 1600px) {
				.blog-post-main { max-width: min(1440px, 90vw); }
			}
			@media (min-width: 1800px) {
				.blog-post-main { max-width: min(1620px, 90vw); }
			}
			@media (min-width: 2000px) {
				.blog-post-main { max-width: min(1800px, 90vw); }
			}

			/* ── Mobile ── */
			@media (max-width: 720px) {
				.blog-post-main { padding: 0.75em 1em 2em; }
				.post-header h1 { font-size: 2rem; }
				.post-stats { font-size: 0.78em; gap: 0.25em 0.4em; }
			}

			/* ════════════════════════════════════════════
			   Article Layout — Sidebar + Main Flex
			   ════════════════════════════════════════════ */

			.article-layout {
				display: flex;
				width: 100%;
				max-width: 1800px;
				margin: 0 auto;
				position: relative;
			}

			/* ── Sidebar ── */
			.toc-sidebar {
				width: 240px;
				min-width: 240px;
				flex-shrink: 0;
				position: sticky;
				top: var(--nav-height);
				align-self: flex-start;
				max-height: calc(100vh - var(--nav-height));
				overflow: hidden;
				padding: 2em 0;
				transition: width 250ms ease, min-width 250ms ease, padding 250ms ease;
			}

			.toc-sidebar.collapsed {
				width: 40px;
				min-width: 40px;
				padding: 2em 0;
			}

			/* ── Sidebar Header Row ── */
			.toc-header-wrap {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.25em;
				white-space: nowrap;
				min-height: 1.8em;
			}

			.toc-header-label {
				font-size: 0.75em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-muted);
			}

			.toc-toggle {
				background: none;
				border: none;
				color: var(--text-muted);
				cursor: pointer;
				padding: 0.25em;
				font-size: 1em;
				line-height: 1;
				border-radius: var(--radius-sm);
				transition: color 0.15s ease, background 0.15s ease;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				width: 28px;
				height: 28px;
			}

			.toc-toggle:hover {
				color: var(--accent-light);
				background: var(--bg-tertiary);
			}

			.toc-toggle .toggle-icon {
				display: inline-block;
				font-size: 1.1em;
				transition: transform 250ms ease;
				line-height: 1;
			}

			.toc-sidebar.collapsed .toc-toggle .toggle-icon {
				transform: rotate(180deg);
			}

			/* ── TOC Navigation ── */
			.toc-nav {
				font-size: 0.82em;
			}

			.toc-nav ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.toc-nav li {
				margin: 0;
			}

			.toc-nav a {
				display: block;
				padding: 0.3em 0.8em;
				color: var(--text-secondary);
				text-decoration: none;
				border-left: 2px solid transparent;
				border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
				transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
				font-size: 1em;
				line-height: 1.45;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.toc-nav a:hover {
				color: var(--text-primary);
				background: var(--bg-tertiary);
			}

			.toc-nav a.active {
				color: var(--accent-light);
				border-left-color: var(--accent);
				background: rgba(108, 92, 231, 0.06);
			}

			.toc-nav .toc-link-h3 {
				padding-left: 1.8em;
			}

			/* ── Nested TOC list under h2 ── */
			.toc-nav li ul {
				padding-left: 0;
				margin: 0.15em 0;
			}

			/* ── Main content when inside article layout ── */
			.article-layout .blog-post-main {
				flex: 1;
				min-width: 0;
				max-width: none;
				width: auto;
				margin: 0;
				padding: 1.25em 2em 3em;
			}

			/* ── Article body scaling in flex context ── */
			.article-layout .article-body {
				max-width: 1100px;
			}

			/* ── Heading Permalink Icons ── */
			.heading-permalink {
				display: inline-block;
				margin-left: 0.3em;
				opacity: 0;
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.8em;
				font-weight: 400;
				transition: opacity 0.15s ease, color 0.15s ease;
				user-select: none;
				position: relative;
				top: -0.05em;
			}

			.prose h2:hover .heading-permalink,
			.prose h3:hover .heading-permalink {
				opacity: 1;
			}

			.heading-permalink:hover {
				color: var(--accent-light) !important;
			}

			/* ── Responsive: hide sidebar below 1440px ── */
			@media (max-width: 1439px) {
				.article-layout {
					display: block;
				}
				.toc-sidebar {
					display: none;
				}
				.article-layout .blog-post-main {
					max-width: min(1800px, 90vw);
					margin: 0 auto;
					width: 100% !important;
					padding: 1.25em 2em 3em;
				}
				.article-layout .article-body {
					max-width: 1000px;
				}
			}

			@media (max-width: 720px) {
				.article-layout .blog-post-main {
					padding: 0.75em 1em 2em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="article-layout">
			<aside class="toc-sidebar" id="toc-sidebar">
				<div class="toc-inner">
					<div class="toc-header-wrap">
						<span class="toc-header-label">On This Page</span>
						<button class="toc-toggle" id="toc-toggle" aria-label="Toggle sidebar" aria-expanded="true">
							<svg class="toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
						</button>
					</div>
					<nav class="toc-nav" id="toc-nav" aria-label="Table of Contents"></nav>
				</div>
			</aside>
			<main class="blog-post-main">
				<article itemscope itemtype="https://schema.org/Article">
					<meta itemprop="author" content={author} />
					<meta itemprop="datePublished" content={pubDate.toISOString()} />
					{updatedDate && <meta itemprop="dateModified" content={updatedDate.toISOString()} />}

					{heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt={`Hero image for ${title}`} itemprop="image" />
						</div>
					)}

					<div class="article-body">
						<div class="post-header">
							<h1 itemprop="headline">{title}</h1>

							<div class="post-stats">
								<span>By {author}</span><span class="sep">·</span>
								<FormattedDate date={pubDate} /><span class="sep">·</span>
								<span>{readingTime} min read</span>
								{updatedDate && <><span class="sep">·</span><span class="last-updated">Updated <FormattedDate date={updatedDate} /></span></>}
								{tags.length > 0 && <><span class="sep">·</span>{tags.map(tag => <a class="tag-link" href={`/tags/${tag}`}>{tag}</a>)}</>}
							</div>

							<p class="post-desc" itemprop="description">{description}</p>
						</div>

						<div class="prose">
							<slot />
						</div>
					</div>
				</article>
			</main>
		</div>
		<Footer />

		<script>
			(function() {
				'use strict';

				var prose = document.querySelector('.prose');
				if (!prose) return;

				var headings = prose.querySelectorAll('h2, h3');
				if (!headings.length) return;

				var sidebar = document.getElementById('toc-sidebar');
				var tocNav = document.getElementById('toc-nav');
				var toggleBtn = document.getElementById('toc-toggle');

				/* ── 1. Generate TOC (nested h2 → h3) ── */
				var ul = document.createElement('ul');
				ul.className = 'toc-list';

				var currentH2Ul = null;

				headings.forEach(function(h, idx) {
					if (!h.id) {
						h.id = 'heading-' + idx;
					}

					var a = document.createElement('a');
					a.href = '#' + h.id;
					a.textContent = h.textContent;
					a.addEventListener('click', function(e) {
						e.preventDefault();
						var target = document.getElementById(h.id);
						if (target) {
							target.scrollIntoView({ behavior: 'smooth' });
							history.pushState(null, '', '#' + h.id);
						}
					});

					if (h.tagName === 'H3') {
						a.className = 'toc-link-h3';
						var li = document.createElement('li');
						li.appendChild(a);
						if (currentH2Ul) {
							currentH2Ul.appendChild(li);
						} else {
							ul.appendChild(li);
						}
					} else {
						currentH2Ul = document.createElement('ul');
						var li = document.createElement('li');
						li.appendChild(a);
						li.appendChild(currentH2Ul);
						ul.appendChild(li);
					}
				});

				tocNav.appendChild(ul);

				/* ── 2. Scrollspy with IntersectionObserver ── */
				var activeLink = null;

				var observer = new IntersectionObserver(function(entries) {
					entries.forEach(function(entry) {
						if (entry.isIntersecting) {
							var id = entry.target.id;
							var link = tocNav.querySelector('a[href="#' + id.replace(/"/g, '\\"') + '"]');
							if (link) {
								if (activeLink) activeLink.classList.remove('active');
								link.classList.add('active');
								activeLink = link;
							}
						}
					});
				}, {
					rootMargin: '-64px 0px -75% 0px',
					threshold: 0
				});

				headings.forEach(function(h) {
					observer.observe(h);
				});

				/* ── 3. Sidebar collapse toggle ── */
				if (sidebar && toggleBtn) {
					toggleBtn.addEventListener('click', function() {
						var isCollapsed = sidebar.classList.toggle('collapsed');
						toggleBtn.setAttribute('aria-expanded', String(!isCollapsed));
					});
				}

				/* ── 4. Heading permalink icons ── */
				headings.forEach(function(h) {
					var link = document.createElement('a');
					link.className = 'heading-permalink';
					link.href = '#' + h.id;
					link.setAttribute('aria-label', 'Copy link to heading');
					link.textContent = '#';
					link.addEventListener('click', function(e) {
						e.preventDefault();
						e.stopPropagation();
						var url = window.location.href.split('#')[0] + '#' + h.id;
						navigator.clipboard.writeText(url).catch(function() {
							/* Fallback for older browsers */
							var ta = document.createElement('textarea');
							ta.value = url;
							ta.style.position = 'fixed';
							ta.style.opacity = '0';
							document.body.appendChild(ta);
							ta.select();
							try {
								document.execCommand('copy');
							} catch (e) {
								/* silently fail */
							}
							document.body.removeChild(ta);
						});
					});
					h.appendChild(link);
				});
			})();
		</script>
	</body>
</html>
