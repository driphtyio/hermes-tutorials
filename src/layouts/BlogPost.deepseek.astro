---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, author, keywords } = post.data;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Person', name: author },
	publisher: {
		'@type': 'Organization', name: 'Hermes Agent Tutorials',
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
	},
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
	...(tags.length > 0 && { keywords: tags.join(', ') }),
	wordCount: readingTime * 200,
	timeRequired: `PT${readingTime}M`,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Tutorials', item: new URL('/blog', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: title, item: canonicalURL.toString() },
	],
};
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} — Hermes Agent Tutorials`}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
			keywords={keywords}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			/* ════════════════════════════════════════════
			   BlogPost.deepseek — Widescreen + TOC Sidebar
			   ════════════════════════════════════════════ */

			/* ── Escape the 860px global content-width ── */
			main {
				width: 100% !important;
				max-width: min(1800px, 90vw);
				margin: 0 auto;
				padding: 1.25em 2em 3em;
			}

			/* ── Breadcrumbs ── */
			.breadcrumbs {
				max-width: min(1800px, 90vw);
				margin: 0 auto;
				padding: 0.6em 2em 0;
				font-size: 0.80em;
				color: var(--text-muted);
			}
			.breadcrumbs a { color: var(--text-muted); }
			.breadcrumbs a:hover { color: var(--accent-light); }
			.breadcrumbs .sep { margin: 0 0.4em; color: var(--border-light); }

			/* ── Hero Image (full-bleed within article, not constrained by prose) ── */
			.hero-image {
				width: 100%;
				margin-bottom: 1.25em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				max-height: 280px;
				object-fit: cover;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-md);
			}

			/* ── Sidebar + Article Flex Container ── */
			.blog-layout {
				display: flex;
				gap: 2em;
				max-width: 1800px;
				margin: 0 auto;
				position: relative;
			}

			/* ── TOC Sidebar ── */
			.toc-sidebar {
				position: sticky;
				top: var(--nav-height);
				align-self: flex-start;
				width: 240px;
				min-width: 240px;
				overflow: hidden;
				padding: 2em 0;
				max-height: calc(100vh - var(--nav-height));
				transition: width 0.2s ease, min-width 0.2s ease, padding 0.2s ease;
			}
			.toc-sidebar.collapsed {
				width: 40px;
				min-width: 40px;
				padding: 0.5em 0;
			}
			.toc-sidebar.collapsed .toc-header span,
			.toc-sidebar.collapsed .toc-list,
			.toc-sidebar.collapsed .toc-permalink-hint {
				display: none;
			}

			/* ── TOC Header ── */
			.toc-header {
				display: flex;
				align-items: center;
				gap: 0.5em;
				margin-bottom: 0.75em;
				padding: 0 0.25em;
			}
			.toc-header label {
				font-size: 0.75em;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--text-muted);
				font-weight: 600;
				cursor: pointer;
				user-select: none;
				white-space: nowrap;
			}
			.toc-toggle {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 22px;
				height: 22px;
				padding: 0;
				border: none;
				background: transparent;
				color: var(--text-muted);
				cursor: pointer;
				border-radius: var(--radius-sm);
				transition: color 0.15s ease, transform 0.2s ease;
				flex-shrink: 0;
			}
			.toc-toggle:hover {
				color: var(--accent-light);
			}
			.toc-toggle svg {
				width: 14px;
				height: 14px;
				transition: transform 0.2s ease;
			}
			.toc-sidebar.collapsed .toc-toggle svg {
				transform: rotate(-180deg);
			}

			/* ── TOC List ── */
			.toc-list {
				list-style: none;
				margin: 0;
				padding: 0;
				overflow-y: auto;
				max-height: calc(100vh - var(--nav-height) - 5em);
			}
			.toc-list li {
				margin: 0;
				padding: 0;
			}
			.toc-link {
				display: block;
				padding: 0.35em 0.5em 0.35em 1em;
				font-size: 0.82em;
				color: var(--text-muted);
				text-decoration: none;
				border-left: 2px solid transparent;
				border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
				transition: all 0.15s ease;
				line-height: 1.4;
				word-break: break-word;
			}
			.toc-link:hover {
				color: var(--text-secondary);
				background: rgba(255,255,255,0.03);
			}
			.toc-link.active {
				color: var(--accent-light);
				border-left-color: var(--accent);
				background: rgba(108,92,231,0.06);
			}
			.toc-link.h3 {
				padding-left: 1.75em;
				font-size: 0.78em;
			}

			/* ── Permalink hint at bottom of sidebar ── */
			.toc-permalink-hint {
				margin-top: 0.75em;
				padding: 0.5em 0.5em 0;
				border-top: 1px solid var(--border);
				font-size: 0.70em;
				color: var(--text-muted);
				font-style: italic;
			}

			/* ── Article Body (constrain to readable line-length) ── */
			.article-body {
				flex: 1;
				min-width: 0;
				max-width: 1000px;
			}

			/* ── Post Header ── */
			.post-header {
				margin-bottom: 1.25em;
			}
			.post-header h1 {
				font-size: 2.8rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				line-height: 1.1;
				margin: 0 0 0.3em;
			}

			/* ── One-line stats bar: author · date · reading time · tags ── */
			.post-stats {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.3em 0.6em;
				color: var(--text-muted);
				font-size: 0.84em;
				margin-bottom: 0.6em;
			}
			.post-stats .sep { opacity: 0.3; }
			.post-stats .tag-link {
				display: inline-block;
				padding: 0.06em 0.45em;
				font-size: 0.80em;
				color: var(--accent-light);
				border: 1px solid var(--border-light);
				border-radius: var(--radius-sm);
				text-decoration: none;
				transition: border-color 0.15s, color 0.15s;
			}
			.post-stats .tag-link:hover {
				border-color: var(--accent);
				color: var(--accent-light);
			}
			.last-updated { font-style: italic; }

			/* ── Description ── */
			.post-desc {
				font-size: 1.05em;
				color: var(--text-secondary);
				line-height: 1.6;
				margin: 0 0 1em;
			}

			/* ── Prose ── */
			.prose {
				color: var(--text-primary);
			}
			.prose h2 { margin-top: 2em; }
			.prose h3 { margin-top: 1.2em; }
			.prose p { margin-bottom: 1.2em; line-height: 1.8; }

			/* ── TLDR Callout (compact aside) ── */
			.tldr-block {
				background: var(--bg-secondary);
				border: 1px solid var(--border);
				border-left: 3px solid var(--accent);
				border-radius: var(--radius-md);
				padding: 0.85em 1.15em;
				margin: 1em 0;
				font-size: 0.92em;
				color: var(--text-secondary);
			}
			.tldr-block strong:first-child {
				color: var(--accent-light);
				text-transform: uppercase;
				font-size: 0.70em;
				letter-spacing: 0.06em;
			}

			/* ── Heading Permalink Icons ── */
			.prose h2,
			.prose h3 {
				position: relative;
			}
			.heading-anchor {
				position: absolute;
				left: -1.5em;
				top: 50%;
				transform: translateY(-50%);
				opacity: 0;
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.75em;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 1.2em;
				height: 1.2em;
				border-radius: var(--radius-sm);
				transition: opacity 0.15s ease, color 0.15s ease, background 0.15s ease;
			}
			.heading-anchor:hover {
				color: var(--accent-light);
				background: rgba(108,92,231,0.1);
			}
			.prose h2:hover .heading-anchor,
			.prose h3:hover .heading-anchor {
				opacity: 1;
			}
			@media (max-width: 1200px) {
				.heading-anchor {
					left: -1.2em;
				}
			}
			@media (max-width: 720px) {
				.heading-anchor {
					left: -0.1em;
					padding-right: 0.3em;
				}
				.prose h2,
				.prose h3 {
					padding-left: 1.3em;
				}
			}

			/* ── Widescreen Breakpoint Ladder ── */

			/* Below 1440px: sidebar hidden, single-column */
			@media (max-width: 1439px) {
				.toc-sidebar {
					display: none !important;
				}
				.blog-layout {
					display: block;
				}
				.article-body {
					max-width: 1000px;
					margin: 0 auto;
				}
			}

			@media (min-width: 1440px) {
				main {
					padding: 1.25em 2em 3em;
				}
			}
			@media (min-width: 1600px) {
				main {
					padding: 1.5em 2.5em 3em;
				}
			}

			/* ── Mobile ── */
			@media (max-width: 720px) {
				main { padding: 0.75em 1em 2em; }
				.breadcrumbs { padding: 0.4em 1em 0; }
				.post-header h1 { font-size: 2rem; }
				.post-stats { font-size: 0.78em; gap: 0.25em 0.4em; }
				.blog-layout { display: block; }
				.toc-sidebar { display: none !important; }
				.article-body { max-width: 100%; }
			}
		</style>
	</head>
	<body>
		<Header />
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/blog">Tutorials</a><span class="sep">›</span>
			<span style="color: var(--text-secondary)">{title}</span>
		</nav>
		<main>
			<div class="blog-layout">
				<!-- ── TOC Sidebar ── -->
				<aside class="toc-sidebar" data-toc-sidebar aria-label="Table of Contents">
					<div class="toc-header">
						<button class="toc-toggle" data-toc-toggle aria-label="Toggle table of contents" title="Toggle TOC">
							<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="2" y1="4" x2="14" y2="4"/>
								<line x1="2" y1="8" x2="14" y2="8"/>
								<line x1="2" y1="12" x2="14" y2="12"/>
							</svg>
						</button>
						<label>On This Page</label>
					</div>
					<ul class="toc-list" data-toc-list>
						<!-- populated by inline script -->
					</ul>
					<div class="toc-permalink-hint">Hover heading for # link</div>
				</aside>

				<!-- ── Article Body ── -->
				<article class="article-body" itemscope itemtype="https://schema.org/Article">
					<meta itemprop="author" content={author} />
					<meta itemprop="datePublished" content={pubDate.toISOString()} />
					{updatedDate && <meta itemprop="dateModified" content={updatedDate.toISOString()} />}

					{heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt={`Hero image for ${title}`} itemprop="image" />
						</div>
					)}

					<div class="post-header">
						<h1 itemprop="headline">{title}</h1>

						<div class="post-stats">
							<span>By {author}</span><span class="sep">·</span>
							<FormattedDate date={pubDate} /><span class="sep">·</span>
							<span>{readingTime} min read</span>
							{updatedDate && <><span class="sep">·</span><span class="last-updated">Updated <FormattedDate date={updatedDate} /></span></>}
							{tags.length > 0 && <><span class="sep">·</span>{tags.map(tag => <a class="tag-link" href={`/tags/${tag}`}>{tag}</a>)}</>}
						</div>

						<p class="post-desc" itemprop="description">{description}</p>
					</div>

					<div class="prose">
						<slot />
					</div>
				</article>
			</div>
		</main>
		<Footer />

		<script is:inline>
			(function() {
				'use strict';

				// ── TOC: build list from .prose h2/h3 ──
				var prose = document.querySelector('.prose');
				var tocList = document.querySelector('[data-toc-list]');
				var sidebar = document.querySelector('[data-toc-sidebar]');
				var toggleBtn = document.querySelector('[data-toc-toggle]');

				if (!prose || !tocList) return;

				var headings = prose.querySelectorAll('h2, h3');
				if (headings.length === 0) {
					// No headings — hide the sidebar entirely
					if (tocList.parentElement) tocList.parentElement.style.display = 'none';
					return;
				}

				var tocItems = [];
				var fragment = document.createDocumentFragment();

				// Ensure each heading has an id
				headings.forEach(function(h, i) {
					if (!h.id) {
						var text = (h.textContent || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
						h.id = text || ('heading-' + i);
					}
				});

				// Build TOC links
				headings.forEach(function(h) {
					var li = document.createElement('li');
					var a = document.createElement('a');
					a.className = 'toc-link' + (h.tagName === 'H3' ? ' h3' : '');
					a.href = '#' + h.id;
					a.textContent = h.textContent || h.innerText;
					a.dataset.target = h.id;
					li.appendChild(a);
					fragment.appendChild(li);
					tocItems.push(a);
				});

				tocList.appendChild(fragment);

				// ── ScrollSpy via IntersectionObserver ──
				var activeLink = null;
				var headingElements = Array.from(headings);

				function updateActive(id) {
					tocItems.forEach(function(link) {
						var isActive = link.dataset.target === id;
						link.classList.toggle('active', isActive);
						if (isActive) {
							activeLink = link;
							// Scroll the link into view within the sidebar
							var listParent = tocList;
							var linkTop = link.offsetTop;
							var scrollTop = listParent.scrollTop;
							var scrollBottom = scrollTop + listParent.clientHeight;
							if (linkTop < scrollTop || linkTop > scrollBottom - 40) {
								listParent.scrollTop = linkTop - listParent.clientHeight / 2 + link.offsetHeight;
							}
						}
					});
				}

				var observer = new IntersectionObserver(function(entries) {
					var visible = entries
						.filter(function(e) { return e.isIntersecting; })
						.sort(function(a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });

					if (visible.length > 0) {
						updateActive(visible[0].target.id);
					} else {
						// No visible headings — find the nearest one above viewport
						var above = headingElements
							.filter(function(h) { return h.getBoundingClientRect().top < 0; });
						if (above.length > 0) {
							updateActive(above[above.length - 1].id);
						}
					}
				}, {
					rootMargin: '-80px 0px -60% 0px',
					threshold: 0,
				});

				headingElements.forEach(function(h) { observer.observe(h); });

				// ── Toggle collapse ──
				if (toggleBtn && sidebar) {
					toggleBtn.addEventListener('click', function(e) {
						e.preventDefault();
						sidebar.classList.toggle('collapsed');
					});
				}

				// ── Smooth scroll on TOC link click ──
				tocItems.forEach(function(link) {
					link.addEventListener('click', function(e) {
						e.preventDefault();
						var targetId = link.getAttribute('href').slice(1);
						var target = document.getElementById(targetId);
						if (target) {
							var navHeight = 80; // account for sticky header
							var targetPos = target.getBoundingClientRect().top + window.pageYOffset - navHeight;
							window.scrollTo({ top: targetPos, behavior: 'smooth' });
							// Update URL hash without causing scroll jump
							history.pushState(null, '', '#' + targetId);
							// Immediately highlight
							updateActive(targetId);
						}
					});
				});

				// ── Heading Permalink (#) Icons ──
				// Inject a # anchor into each h2/h3 that copies the URL on click
				var permalinkHeadings = prose.querySelectorAll('h2, h3');
				permalinkHeadings.forEach(function(h) {
					var anchor = document.createElement('a');
					anchor.className = 'heading-anchor';
					anchor.href = '#' + h.id;
					anchor.setAttribute('aria-label', 'Link to this section');
					anchor.title = 'Copy link to this section';
					anchor.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M5.5 3.5 10.5 3.5"/><path d="M5.5 12.5 10.5 12.5"/><path d="M4 8 12 8"/></svg>';

					anchor.addEventListener('click', function(e) {
						e.preventDefault();
						var url = window.location.href.split('#')[0] + '#' + h.id;
						navigator.clipboard.writeText(url).catch(function() {
							// Fallback: select and copy
							var input = document.createElement('input');
							input.value = url;
							document.body.appendChild(input);
							input.select();
							document.execCommand('copy');
							document.body.removeChild(input);
						});
						// Brief flash feedback on the anchor
						anchor.style.color = 'var(--accent-light)';
						setTimeout(function() { anchor.style.color = ''; }, 600);
					});

					h.insertBefore(anchor, h.firstChild);
				});

				// ── Handle initial hash on page load ──
				if (window.location.hash) {
					var targetId = window.location.hash.slice(1);
					var target = document.getElementById(targetId);
					if (target) {
						setTimeout(function() {
							var navHeight = 80;
							var targetPos = target.getBoundingClientRect().top + window.pageYOffset - navHeight;
							window.scrollTo({ top: targetPos, behavior: 'instant' });
							updateActive(targetId);
						}, 100);
					}
				}
			})();
		</script>
	</body>
</html>
