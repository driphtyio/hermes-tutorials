---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, author, keywords } = post.data;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Person', name: author },
	publisher: {
		'@type': 'Organization', name: 'Hermes Agent Tutorials',
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
	},
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
	...(tags.length > 0 && { keywords: tags.join(', ') }),
	wordCount: readingTime * 200,
	timeRequired: `PT${readingTime}M`,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Tutorials', item: new URL('/blog', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: title, item: canonicalURL.toString() },
	],
};
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} — Hermes Agent Tutorials`}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
			keywords={keywords}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			/* ════════════════════════════════════════════
			   BlogPost.poolside-laguna — Widescreen + Space-Optimized
			   ════════════════════════════════════════════ */

			/* ── Escape the 860px global content-width ── */
			main {
				width: 100% !important;
				max-width: min(1800px, 90vw);
				margin: 0 auto;
				padding: 1.25em 1.5em 3em;
			}

			/* ── Breadcrumbs ── */
			.breadcrumbs {
				max-width: min(1800px, 90vw);
				margin: 0 auto;
				padding: 0.6em 1.5em 0;
				font-size: 0.8em;
				color: var(--text-muted);
			}
			.breadcrumbs a { color: var(--text-muted); }
			.breadcrumbs a:hover { color: var(--accent-light); }
			.breadcrumbs .sep { margin: 0 0.35em; color: var(--border-light); }

			/* ── Hero Image (full-bleed within article, NOT constrained by prose width) ── */
			.hero-image {
				width: 100%;
				margin-bottom: 1.25em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-md);
			}

			/* ── Constrained body wrapper: title, stats, prose, TLDR at readable width ── */
			.article-body {
				max-width: 720px;
				margin: 0 auto;
			}

			/* ── Post Header ── */
			.post-header {
				margin-bottom: 1.25em;
			}
			.post-header h1 {
				font-size: 2.8rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				line-height: 1.1;
				margin: 0 0 0.3em;
			}

			/* ── One-line stats bar: author · date · reading time · tags ── */
			.post-stats {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.3em 0.6em;
				color: var(--text-muted);
				font-size: 0.84em;
				margin-bottom: 0.6em;
			}
			.post-stats .sep { opacity: 0.35; }
			.post-stats .tag-link {
				display: inline-block;
				padding: 0.06em 0.45em;
				font-size: 0.82em;
				color: var(--accent-light);
				border: 1px solid var(--border-light);
				border-radius: var(--radius-sm);
				text-decoration: none;
				transition: border-color 0.15s, color 0.15s;
			}
			.post-stats .tag-link:hover {
				border-color: var(--accent);
				color: var(--accent-light);
			}
			.last-updated { font-style: italic; }

			/* ── Description ── */
			.post-desc {
				font-size: 1.08em;
				color: var(--text-secondary);
				line-height: 1.6;
				margin: 0 0 1.1em;
			}

			/* ── Prose ── */
			.prose {
				color: var(--text-primary);
			}
			.prose h2 { margin-top: 2em; }
			.prose h3 { margin-top: 1.25em; }
			.prose p { margin-bottom: 1.25em; line-height: 1.8; }

			/* ── TLDR Callout (compact aside) ── */
			.tldr-block {
				background: var(--bg-secondary);
				border: 1px solid var(--border);
				border-left: 3px solid var(--accent);
				border-radius: var(--radius-md);
				padding: 0.85em 1.1em;
				margin: 1em 0;
				font-size: 0.92em;
				color: var(--text-secondary);
			}
			.tldr-block strong:first-child {
				color: var(--accent-light);
				text-transform: uppercase;
				font-size: 0.7em;
				letter-spacing: 0.06em;
			}

			/* ── Widescreen Breakpoint Ladder ──
			   At each step, the 90vw rule grows naturally. We fine-tune
			   padding, internal spacing, and font sizing for comfort. ── */

			@media (min-width: 1200px) {
				main { padding: 1.5em 2em 3em; }
				.breadcrumbs { padding: 0.7em 2em 0; }
				.post-header h1 { font-size: 3rem; }
			}
			@media (min-width: 1440px) {
				main { padding: 1.75em 2.5em 3em; }
				.breadcrumbs { padding: 0.8em 2.5em 0; }
				.post-header h1 { font-size: 3.2rem; }
				.article-body { max-width: 740px; }
				.post-desc { font-size: 1.12em; }
			}
			@media (min-width: 1600px) {
				main { padding: 2em 3em 3.5em; }
				.breadcrumbs { padding: 0.85em 3em 0; }
				.post-header h1 { font-size: 3.4rem; }
				.article-body { max-width: 760px; }
				.post-stats { font-size: 0.88em; gap: 0.35em 0.7em; }
			}
			@media (min-width: 1800px) {
				main { padding: 2em 3.5em 4em; }
				.breadcrumbs { padding: 0.9em 3.5em 0; }
				.post-header h1 { font-size: 3.6rem; }
				.article-body { max-width: 780px; }
				.post-desc { font-size: 1.15em; }
				.prose { font-size: 1.04em; }
			}
			@media (min-width: 2000px) {
				main { padding: 2em 4em 4em; }
				.breadcrumbs { padding: 0.9em 4em 0; }
				.post-header h1 { font-size: 3.8rem; }
				.article-body { max-width: 800px; }
				.prose { font-size: 1.06em; }
			}

			/* ── Mobile ── */
			@media (max-width: 720px) {
				main { padding: 0.75em 1em 2em; }
				.breadcrumbs { padding: 0.4em 1em 0; }
				.post-header h1 { font-size: 2rem; }
				.post-stats { font-size: 0.78em; gap: 0.25em 0.4em; }
				.post-desc { font-size: 1em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a><span class="sep">›</span>
			<a href="/blog">Tutorials</a><span class="sep">›</span>
			<span style="color: var(--text-secondary)">{title}</span>
		</nav>
		<main>
			<article itemscope itemtype="https://schema.org/Article">
				<meta itemprop="author" content={author} />
				<meta itemprop="datePublished" content={pubDate.toISOString()} />
				{updatedDate && <meta itemprop="dateModified" content={updatedDate.toISOString()} />}

				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={`Hero image for ${title}`} itemprop="image" />
					</div>
				)}

				<div class="article-body">
					<div class="post-header">
						<h1 itemprop="headline">{title}</h1>

						<div class="post-stats">
							<span>By {author}</span><span class="sep">·</span>
							<FormattedDate date={pubDate} /><span class="sep">·</span>
							<span>{readingTime} min read</span>
							{updatedDate && <><span class="sep">·</span><span class="last-updated">Updated <FormattedDate date={updatedDate} /></span></>}
							{tags.length > 0 && <><span class="sep">·</span>{tags.map(tag => <a class="tag-link" href={`/tags/${tag}`}>{tag}</a>)}</>}
						</div>

						<p class="post-desc" itemprop="description">{description}</p>
					</div>

					<div class="prose">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
